import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { FallbackCover } from "../components/fallback-cover.slint";
import { FocusFrame } from "../components/focus-frame.slint";
import { ActivityCoverData, ActivityDayData } from "../models/activity.slint";
import { AchievementEntryData } from "../models/achievements.slint";
import { PageHeader, HeaderValue } from "../components/page-header.slint";
import { MarqueeText } from "../components/marquee-text.slint";
import { Surface, BadgeIcon } from "../components/list-row.slint";

// Phase 10.3.0: one controller focus region, shared cover/focus design from
// Home, and two quiet informational panels. Recent unlocks are Steam-derived.
export component ActivityPage inherits Rectangle {
    in property <[ActivityCoverData]> covers;
    in property <[ActivityDayData]> days;
    in property <int> selected-index: 0;
    in property <int> pressed-index: -1;
    in property <bool> details-open: false;
    in property <bool> focus-visible: false;
    in property <string> week-total: "0 min";
    in property <string> month-total: "0 min";
    in property <[AchievementEntryData]> recent-achievements;
    in property <string> achievement-status: "Connect Steam achievements in the Achievements utility";
    callback choose-game(int);
    background: Theme.background;

    private property <length> card-size: root.width < 980px ? 142px
        : root.width < 1600px ? 164px : 186px;
    private property <length> card-gap: 24px;
    private property <length> art-inset: root.card-size * 0.085;
    // Captions begin BELOW the maximum selected shell and FocusFrame, not
    // the unselected cover slot. The 22px visual clearance remains stable
    // throughout selection, press-in, and unselected states.
    private property <length> cover-label-top: root.card-size
        + root.card-size * ((Metrics.game-selected-scale - 1.0) / 2.0)
        + Metrics.focus-offset + 22px;
    // Fill the full shell width; the old centred, fitted-width viewport left
    // an artificial clipped/cut-off band within the screen. Keep the cover
    // edges within the same side margins as the page heading when stationary.
    // Widen the gaps only as needed to use the available row width; all cards
    // are still mounted, and the camera clips only at the actual screen edge.
    private property <length> covers-width: max(1px,
        root.width - Metrics.page-margin * 2);
    private property <length> card-stride-min: root.card-size + root.card-gap;
    // Reserve approximately one fifth of the next cover as an intentional
    // browse hint. No sidebar arrows, separate mask, or early camera motion.
    private property <length> peek-width: root.card-size * 0.22;
    private property <int> visible-cards: max(1, Math.floor(
        (root.covers-width - root.peek-width + root.card-gap) / root.card-stride-min));
    private property <int> layout-cards: max(1, min(root.visible-cards, root.covers.length));
    private property <length> effective-gap: root.covers.length > root.visible-cards
        ? min(72px, max(root.card-gap,
            (root.covers-width - root.visible-cards * root.card-size - root.peek-width)
                / root.visible-cards))
        : root.card-gap;
    private property <length> card-stride: root.card-size + root.effective-gap;
    // Home-style edge-zone navigation: hold the camera on the first set of
    // whole covers, then follow only after crossing the rightmost full tile.
    private property <int> first-visible: max(0,
        root.selected-index - root.visible-cards + 1);
    private property <length> strip-width: root.covers.length * root.card-size
        + max(0, root.covers.length - 1) * root.effective-gap;
    private property <length> camera-offset: min(
        root.first-visible * root.card-stride,
        max(0px, root.strip-width - root.covers-width));
    private property <length> covers-top: Metrics.page-header-height + 69px;
    // The lower sections always begin after BOTH caption lines, with a
    // comfortable 20px separation, even when focus enlarges the cover.
    private property <length> panels-top: root.covers-top + root.cover-label-top
        + 36px + 20px + 20px;
    private property <length> panels-gap: 18px;
    private property <length> panel-width: (root.width - Metrics.page-margin * 2 - root.panels-gap) / 2;
    private property <length> panels-height: max(150px, root.height - root.panels-top - Metrics.page-bottom-bar-height);

    // Read-only period totals on the header row; never focus targets.
    PageHeader {
        width: parent.width;
        title: "Activity";
        HorizontalLayout {
            width: 170px * 2 + Metrics.spacing-sm;
            x: parent.width - Metrics.page-margin - self.width + Metrics.spacing-sm + 2px;
            y: Metrics.page-accessory-y;
            height: Metrics.page-accessory-height;
            spacing: Metrics.spacing-sm;
            HeaderValue { width: 170px; label: "Last 7 days"; value: root.week-total; }
            HeaderValue { width: 170px; label: "This month"; value: root.month-total; }
        }
    }

    Text {
        x: Metrics.page-margin; y: root.covers-top - 62px;
        width: 440px; height: 28px;
        text: "Most played";
        color: Theme.foreground;
        font-size: Typography.heading-size;
        font-weight: Typography.heading-weight;
    }
    Text {
        x: root.width - Metrics.page-margin - 270px; y: root.covers-top - 57px;
        width: 270px; height: 24px; horizontal-alignment: right;
        text: "Tracked by Horizon";
        color: Theme.secondary-foreground;
        font-size: Typography.caption-size;
    }

    if root.covers.length == 0 : Text {
        x: Metrics.page-margin; y: root.covers-top + 42px;
        width: root.width - 2 * Metrics.page-margin;
        height: 65px; wrap: word-wrap;
        text: "No observed playtime yet. Games will appear after a tracked session.";
        color: Theme.secondary-foreground;
        font-size: Typography.body-size;
    }

    // Full-shell carousel viewport. At rest, a deliberate fraction of the next
    // game is visible at the actual right edge; selection does not pan early.
    gallery := Rectangle {
        x: 0px;
        // Leave room for the enlarged Home-scale selected shell and its
        // attached frame without clipping the upper focus corner.
        y: root.covers-top - 18px;
        width: root.width;
        // Include the label and playtime after the enlarged selected frame;
        // otherwise the bottom of the caption can be clipped by the viewport.
        height: 18px + root.cover-label-top + 36px + 20px + 4px;
        background: transparent;
        clip: true;

        // One camera and one mounted row for fast held navigation. The clipped
        // next cover is the scroll cue, not a separate UI affordance.
        strip := Rectangle {
            x: Metrics.page-margin - root.camera-offset;
            y: 0px;
            width: max(root.card-size, root.strip-width);
            height: parent.height;
            background: transparent;
            animate x { duration: Motion.carousel-duration; easing: ease-out; }
            for cover[index] in root.covers : Rectangle {
                // All game tiles remain mounted throughout quick repeat navigation.
                // Clipping belongs to the viewport, not the individual cards.
                x: index * root.card-stride;
                y: 18px; width: root.card-size;
                height: root.cover-label-top + 36px + 20px;
                background: transparent;
                private property <bool> selected: root.selected-index == index
                    && (root.focus-visible || root.details-open);
                private property <bool> pressed: self.selected && root.pressed-index == index;
                // Home supplies the larger selected scale. Opening details
                // briefly depresses the cover before the details rise.
                private property <float> card-scale: !self.selected ? 1.0
                    : self.pressed ? 1.025 : Metrics.game-selected-scale;
                z: self.selected ? 2.0 : 1.0;

                shell := Rectangle {
                    x: (root.card-size - self.width) / 2;
                    y: (root.card-size - self.height) / 2;
                    width: root.card-size * parent.card-scale;
                    height: root.card-size * parent.card-scale;
                    animate width, height {
                        duration: Motion.focus-duration;
                        easing: ease-out;
                    }
                    border-radius: root.card-size * (20.0 / 148.0);
                    background: Theme.surface-raised;
                    border-width: Theme.high-contrast ? 2px : 1px;
                    border-color: Theme.high-contrast ? Theme.foreground : Theme.divider.with-alpha(0.42);
                    drop-shadow-offset-y: parent.selected ? 5px : 3px;
                    drop-shadow-blur: parent.selected ? 16px : 11px;
                    drop-shadow-color: Theme.shadow.with-alpha(parent.selected ? 0.90 : 0.68);
                    private property <length> art-inset: root.art-inset;
                    Rectangle {
                        x: parent.art-inset; y: parent.art-inset;
                        width: parent.width - 2 * parent.art-inset;
                        height: parent.height - 2 * parent.art-inset;
                        border-radius: root.card-size * (12.0 / 148.0);
                        background: transparent; clip: true;
                        if cover.game.has-artwork : Image {
                            width: parent.width; height: parent.height;
                            source: cover.game.artwork;
                            image-fit: contain;
                            image-rendering: cover.game.pixelated-artwork ? pixelated : smooth;
                        }
                        if !cover.game.has-artwork : FallbackCover {
                            width: parent.width; height: parent.height; game: cover.game;
                        }
                    }
                }
                FocusFrame {
                    // Follow the actual animated shell rather than a fixed
                    // unselected tile box. This maintains a Library-like
                    // six-pixel clearance at every selected scale and at the
                    // contracted point of the A-button press.
                    x: shell.x - 6px; y: shell.y - 6px;
                    width: shell.width + 12px; height: shell.height + 12px;
                    scale-factor: (root.card-size + 20px) / Metrics.game-tile-size;
                    active: parent.selected;
                    opacity: parent.selected ? 1.0 : 0.0;
                    animate opacity { duration: Motion.focus-duration; easing: ease-in-out; }
                }
                MarqueeText {
                    x: 1px; y: root.cover-label-top;
                    width: parent.width - 2px; height: 25px;
                    text: cover.game.title;
                    active: parent.selected && root.focus-visible;
                    font-weight: Typography.emphasis-weight;
                }
                Text {
                    x: 1px; y: root.cover-label-top + 36px;
                    width: parent.width - 2px; height: 20px;
                    text: cover.observed-time;
                    color: Theme.secondary-foreground;
                    font-size: Typography.caption-size;
                }
                TouchArea {
                    x: 0px; y: 0px;
                    width: root.card-size; height: root.card-size;
                    enabled: root.focus-visible;
                    clicked => { root.choose-game(index); }
                }
            }
        }
    }

    // One restrained chart and a source-neutral preview of verified recent unlocks.
    Surface {
        x: Metrics.page-margin; y: root.panels-top;
        width: root.panel-width; height: root.panels-height;
        clip: true;
        Text {
            x: 19px; y: 13px; text: "Playtime";
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight; color: Theme.foreground;
        }
        Text {
            x: parent.width - 174px; width: 152px; y: 17px;
            horizontal-alignment: right;
            text: "Last 7 days";
            color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
        }
        Rectangle {
            x: 16px; y: 58px; width: parent.width - 32px;
            height: parent.height - 71px;
            background: transparent;
            for day[index] in root.days : Rectangle {
                private property <length> slot: parent.width / 7;
                x: index * self.slot; width: self.slot; height: parent.height;
                background: transparent;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: min(39px, parent.width * 0.50);
                    height: max(3px, (parent.height - 41px) * day.fraction);
                    y: parent.height - 38px - self.height;
                    background: index == root.days.length - 1
                        ? Theme.accent : Theme.secondary-foreground.with-alpha(0.32);
                    border-radius: Metrics.radius-sm;
                    animate height { duration: Motion.value-swap-duration; easing: ease-out; }
                }
                Text {
                    y: parent.height - 30px; height: 19px; width: parent.width;
                    horizontal-alignment: center;
                    text: day.label;
                    color: Theme.secondary-foreground;
                    font-size: Typography.caption-size;
                }
            }
        }
    }

    Surface {
        x: Metrics.page-margin + root.panel-width + root.panels-gap;
        y: root.panels-top; width: root.panel-width; height: root.panels-height;
        clip: true;
        Text {
            x: 19px; y: 13px; text: "Milestones";
            color: Theme.foreground; font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
        }
        if root.recent-achievements.length == 0 : Text {
            x: 19px; y: 62px;
            width: parent.width - 38px; height: 76px;
            text: root.achievement-status;
            color: Theme.secondary-foreground;
            font-size: Typography.body-size;
            wrap: word-wrap;
        }
        // As many whole unlocks as fit below the panel heading (max three).
        for achievement[i] in root.recent-achievements : Rectangle {
            x: 18px; y: 52px + i * 66px;
            width: parent.width - 36px; height: 64px;
            visible: i < 3 && 52px + (i + 1) * 66px <= root.panels-height - 4px;
            background: transparent;
            BadgeIcon {
                x: 0px; y: 5px; width: 54px; height: 54px;
                badge: achievement.badge;
                has-badge: achievement.has-badge;
                unlocked: achievement.unlocked;
            }
            MarqueeText {
                x: 67px; y: 5px; width: parent.width - 70px; height: 24px;
                text: achievement.title;
                edge-color: Theme.surface;
                font-weight: Typography.emphasis-weight;
            }
            MarqueeText {
                x: 67px; y: 29px; width: parent.width - 70px; height: 19px;
                text: achievement.game + " · " + achievement.provider;
                edge-color: Theme.surface;
                text-color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
            MarqueeText {
                x: 67px; y: 48px; width: parent.width - 70px; height: 16px;
                text: achievement.when;
                edge-color: Theme.surface;
                text-color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
        }
    }
}
