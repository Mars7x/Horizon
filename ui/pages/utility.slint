import { PagePlaceholder } from "../components/page-placeholder.slint";

// Shared presentation shell for the five top-utility submenu routes. The route
// identity and history are Rust-owned; this component only presents the current
// placeholder surface until each utility gets production content.
export component UtilitySubmenuPage inherits Rectangle {
    in property <string> title;
    in property <string> description;

    PagePlaceholder {
        width: parent.width;
        height: parent.height;
        title: root.title;
        description: root.description;
    }
}
