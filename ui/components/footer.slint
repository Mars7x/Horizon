import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { ControllerIcon, ControllerArt } from "system-icons.slint";
import { HintBar, InputGlyphs, GlyphFamily } from "hint-bar.slint";

component ClockReadout inherits Rectangle {
    in property <string> clock-time;
    in property <string> clock-suffix;

    width: 230px;
    height: 64px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        alignment: center;
        spacing: 7px;

        Text {
            text: root.clock-time;
            color: Theme.foreground;
            font-family: Typography.clock-family;
            font-size: Typography.clock-size;
            font-weight: Typography.clock-weight;
            vertical-alignment: center;
        }

        if root.clock-suffix != "" : Text {
            text: root.clock-suffix;
            color: Theme.foreground;
            font-family: Typography.clock-family;
            font-size: Typography.clock-suffix-size;
            font-weight: Typography.clock-suffix-weight;
            vertical-alignment: center;
        }
    }
}

export component Footer inherits Rectangle {
    in property <bool> game-options-available: false;
    in property <float> icon-render-scale: 1.0;
    in property <int> connected-controller-count: 0;
    in property <ControllerArt> controller-art: ControllerArt.generic;
    in property <string> clock-time: "";
    in property <string> clock-suffix: "";
    // A hint was clicked: the button it shows ("A").
    callback hint-activated(string);

    background: transparent;

    // Every footer control resolves from the same vertical midpoint. No local
    // optical lift is applied, so shortening the footer cannot misalign groups.
    // Persistent widgets animate hotplug in *both* directions; conditional
    // construction would instantly destroy the icon on controller removal.
    controller-symbol := ControllerIcon {
        render-scale: root.icon-render-scale;
        art: root.controller-art;
        x: Metrics.page-margin - (root.connected-controller-count > 0 ? 0px : Motion.status-slide-distance);
        y: (parent.height - self.height) / 2;
        opacity: root.connected-controller-count > 0 ? 1.0 : 0.0;
        width: 34px;
        height: 34px;
        animate x, opacity {
            duration: root.connected-controller-count > 0 ? Motion.status-enter-duration : Motion.status-exit-duration;
            easing: ease-in-out;
        }
    }

    ClockReadout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        clock-time: root.clock-time;
        clock-suffix: root.clock-suffix;
    }

    // Same component and line as every other page's hints, so "A OK" sits
    // exactly where those pages put their last hint.
    HintBar {
        // The keyboard's "Enter" cap is wider than a face button.
        x: parent.width - Metrics.page-margin - self.width;
        y: parent.height - Metrics.hint-row-center-from-bottom - self.height / 2;
        width: (root.game-options-available ? 150px : 0px) + (InputGlyphs.family == GlyphFamily.keyboard ? 113px : 95px);
        height: Metrics.hint-row-height;
        hints: root.game-options-available ? [{ button: "+", label: "Options" }, { button: "A", label: "OK" }] : [{ button: "A", label: "OK" }];
        activated(button) => { root.hint-activated(button); }
    }
}
