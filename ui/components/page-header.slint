import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { MarqueeText } from "marquee-text.slint";
import { ValueText } from "value-text.slint";
import { ButtonGlyph } from "hint-bar.slint";

// The one header used by every full-screen page: a title only, always at the
// same position. Optional accessories (Source/Sort pickers) are children,
// placed on the title row's right side at Metrics.page-accessory-y.
export component PageHeader inherits Rectangle {
    in property <string> title;
    x: 0px;
    y: 0px;
    height: Metrics.page-header-height;
    background: transparent;

    Text {
        x: Metrics.page-margin;
        y: Metrics.page-title-y;
        width: parent.width - Metrics.page-margin * 2;
        height: Metrics.page-title-height;
        text: root.title;
        color: Theme.foreground;
        font-size: Typography.title-size;
        font-weight: Typography.title-weight;
        vertical-alignment: center;
    }
    @children
}

// Sub-pages open with "‹  Section  /  Page"; clicking it goes back, the same
// as the controller's B (pointer users have no other Back affordance).
export component Breadcrumb inherits Rectangle {
    in property <string> section;
    in property <string> page;
    callback back();
    height: Metrics.breadcrumb-height;
    background: transparent;
    MarqueeText {
        width: parent.width;
        height: parent.height;
        text: "‹  " + root.section + "  /  " + root.page;
        text-color: back-touch.has-hover ? Theme.foreground : Theme.secondary-foreground;
        font-size: Typography.caption-size;
    }
    back-touch := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.back(); }
    }
}

// Elevation at a fixed scroll boundary. `strength` (0..1) fades it with the
// animated camera: 0 at the very start/end of the content, 1 once scrolled.
export component ScrollEdgeShadow inherits Rectangle {
    in property <bool> bottom: false;
    in property <float> strength: 1.0;
    in property <angle> direction: 180deg;
    height: Metrics.scroll-edge-shadow-height;
    opacity: max(0.0, min(1.0, root.strength));
    background: @linear-gradient(root.direction,
        Theme.shadow.with-alpha(root.bottom ? 0.0 : (Theme.is-dark ? 0.23 : 0.11)) 0%,
        Theme.shadow.with-alpha(root.bottom ? (Theme.is-dark ? 0.23 : 0.11) : 0.0) 100%);
}

// A labelled value on the header's title row: "Source / All sources",
// "Last 7 days / 6 h 12 min". Interactive values are pointer-clickable
// (controller users get LB/RB, shown as small glyphs before the label, not in
// the hint bar: the button sits next to what it changes). Value changes slide
// and fade; this is driven by an animated counter, not animation-tick(),
// so an idle page never redraws continuously.
export component HeaderValue inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> interactive: false;
    // The bumper(s) that change this value ("LB", or "LB" + "RB" for a
    // value stepped both ways). Empty for read-outs.
    in property <string> button: "";
    in property <string> button2: "";
    callback clicked();
    height: Metrics.page-accessory-height;
    private property <length> glyphs-width: root.button == "" ? 0px
        : root.button2 == "" ? 24px + 6px : 24px * 2 + 4px + 6px;
    border-radius: Metrics.radius-sm;
    background: root.interactive && touch.has-hover ? Theme.surface.with-alpha(0.56) : transparent;
    animate background { duration: Motion.hover-duration; easing: ease-in-out; }

    if root.button != "" : ButtonGlyph {
        x: Metrics.spacing-sm + 2px; y: 6px;
        compact: true;
        button: root.button;
    }
    if root.button2 != "" : ButtonGlyph {
        x: Metrics.spacing-sm + 2px + 28px; y: 6px;
        compact: true;
        button: root.button2;
    }
    Text {
        x: Metrics.spacing-sm + 2px + root.glyphs-width; y: 5px;
        width: parent.width - 20px - root.glyphs-width; height: 18px;
        text: root.label;
        color: Theme.secondary-foreground;
        font-size: Typography.label-size;
        vertical-alignment: center;
    }
    ValueText {
        x: Metrics.spacing-sm + 2px; y: 24px;
        width: parent.width - 20px; height: 26px;
        text: root.value; horizontal-alignment: left;
        // The fade at a long value's edge matches the hover background
        // (surface at 56% over the page) as well as the plain page.
        edge-color: root.interactive && touch.has-hover
            ? Theme.surface.mix(Theme.background, 0.56) : Theme.background;
    }
    touch := TouchArea {
        width: parent.width; height: parent.height;
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }
}
