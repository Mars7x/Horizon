import { Motion } from "../theme/theme.slint";

// The one animation for a grid whose contents change in place (Library's
// Source and Sort, Album's Game and Type). Covers in both the old and the new
// grid glide from where they were to where they now belong; covers that
// leave fade out where they stood; covers that are new fade in at their
// place once the leavers have mostly gone. Rust says which is which: a new
// cover's `from-index` is its old place (-1 when it is new), an old cover's
// `stays` hides it from the fading grid because it glides instead. Run it on
// a `Stopwatch` whose length is `GridRefresh.length()`; Reduced Motion makes
// it instant.
export global GridRefresh {
    out property <duration> glide: 260ms;
    out property <duration> leave: 120ms;
    out property <duration> enter-delay: 90ms;
    out property <duration> enter: 170ms;

    public pure function length() -> duration {
        Motion.reduced-motion ? 0ms : GridRefresh.glide
    }
    // A leaving cover's opacity at `elapsed`.
    public pure function outgoing(elapsed: duration) -> float {
        max(0.0, 1.0 - elapsed / GridRefresh.leave)
    }
    // How far a staying cover is along its glide (0 old place, 1 new),
    // eased out like every move.
    public pure function moved(elapsed: duration) -> float {
        let t = max(0.0, min(1.0, elapsed / GridRefresh.glide));
        1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t)
    }
    // A new cover's opacity at `elapsed`, eased in and out like every fade.
    public pure function arrival(elapsed: duration) -> float {
        let t = max(0.0, min(1.0, (elapsed - GridRefresh.enter-delay) / GridRefresh.enter));
        t * t * (3.0 - 2.0 * t)
    }
}
