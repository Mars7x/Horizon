import { Metrics, Motion } from "../theme/theme.slint";

// Keeps route pages alive across navigation so the outgoing and incoming
// surfaces can overlap for a restrained crossfade. Navigation state remains
// Rust-owned; this component only presents the published active route.
export component PageTransitionLayer inherits Rectangle {
    in property <bool> active: false;
    in property <length> base-y: 0px;

    background: transparent;
    clip: true;
    opacity: root.active ? 1.0 : 0.0;
    y: root.base-y + (root.active ? 0px : Metrics.page-transition-offset);
    z: root.active ? 1.0 : 0.0;
    visible: root.active || root.opacity > 0.001;

    animate opacity, y {
        duration: Motion.page-duration;
        easing: ease-out;
    }

    // Route pages may contain pointer targets now or later. This shield keeps
    // pointer input on the active route while an outgoing page is still fading.
    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.active;
    }

    @children
}
