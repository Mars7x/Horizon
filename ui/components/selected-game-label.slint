import { Theme, Metrics, Typography } from "../theme/theme.slint";

export component SelectedGameLabel inherits Rectangle {
    in property <string> title;
    in property <string> status: "";
    private property <bool> has-status: root.status != "";

    width: Metrics.selected-label-width;
    height: Metrics.selected-label-height;
    background: Theme.surface-raised;
    border-radius: 21px;
    border-width: Theme.high-contrast ? 2px : 1px;
    border-color: Theme.high-contrast ? Theme.foreground : Theme.divider.with-alpha(0.42);
    drop-shadow-offset-y: 3px;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.shadow;

    // Keep title and launch feedback inside the existing pill so launch state
    // never changes carousel geometry or connector placement.
    Text {
        x: 12px;
        y: root.has-status ? 2px : 0px;
        width: parent.width - 24px;
        height: root.has-status ? 22px : parent.height;
        text: root.title;
        color: Theme.accent;
        font-family: Typography.game-title-family;
        font-size: root.has-status ? Typography.caption-size : Typography.body-size;
        font-weight: Typography.game-title-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.has-status : Text {
        x: 12px;
        y: 22px;
        width: parent.width - 24px;
        height: parent.height - 22px;
        text: root.status;
        color: Theme.secondary-foreground;
        font-family: Typography.family;
        font-size: Typography.caption-size;
        font-weight: Typography.body-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}
