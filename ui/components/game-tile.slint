import { Theme, Metrics, Motion, Typography } from "../theme/theme.slint";
import { FocusFrame } from "focus-frame.slint";
import { FallbackCover } from "fallback-cover.slint";
import { GameCardData } from "../models/game-card.slint";

export component GameTile inherits Rectangle {
    in property <GameCardData> game;
    in property <bool> selected: false;
    in property <bool> launching: false;
    in property <bool> focus-visible: true;
    private property <bool> releasing-press: false;

    // The spring easing belongs only to the release, not ordinary carousel
    // navigation. Keep the previous 140ms selected-card focus transition.
    changed launching => {
        if (!root.launching) {
            root.releasing-press = true;
            // restart() does nothing on a stopped timer, which left the
            // spring on every later carousel move.
            release-timer.stop();
            release-timer.start();
        } else {
            release-timer.stop();
            root.releasing-press = false;
        }
    }

    release-timer := Timer {
        running: false;
        interval: Motion.launch-release-duration;
        triggered => {
            self.stop();
            root.releasing-press = false;
        }
    }
    in property <int> item-index: 0;
    callback activated(int);

    width: Metrics.game-stride;
    height: Metrics.game-slot-height;
    background: transparent;
    z: root.selected ? 2.0 : 1.0;

    private property <float> target-scale: root.selected
        ? (root.launching ? Metrics.game-launch-pressed-scale : Metrics.game-selected-scale)
        : 1.0;

    // Release the compressed press with a short, overshooting spring curve.
    // Render the selected card at its real target dimensions instead of scaling
    // an already-rasterized subtree. This keeps procedural fallback text and
    // shapes crisp at fullscreen/HiDPI sizes. Internal fallback typography
    // stays at a stable logical size during the transition, avoiding the
    // breathing/re-rasterizing effect from earlier prototypes.
    visual := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Metrics.game-tile-size * root.target-scale;
        height: Metrics.game-tile-size * root.target-scale;
        background: transparent;

        animate width {
            duration: root.launching ? Motion.launch-press-duration :
                (root.releasing-press ? Motion.launch-release-duration : Motion.focus-duration);
            easing: root.releasing-press ? ease-out-back : ease-out;
        }
        animate height {
            duration: root.launching ? Motion.launch-press-duration :
                (root.releasing-press ? Motion.launch-release-duration : Motion.focus-duration);
            easing: root.releasing-press ? ease-out-back : ease-out;
        }

        shell := Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.surface-raised;
            border-radius: Metrics.game-shell-radius;
            border-width: Theme.high-contrast ? 2px : 1px;
            border-color: Theme.high-contrast ? Theme.foreground : Theme.divider.with-alpha(0.42);
            drop-shadow-offset-y: root.selected ? (root.launching ? 4px : 7px) : 4px;
            drop-shadow-blur: root.selected ? (root.launching ? 14px : 20px) : 14px;
            drop-shadow-color: Theme.shadow.with-alpha(root.selected ? 0.95 : 0.72);

            artwork-frame := Rectangle {
                x: Metrics.game-art-inset;
                y: Metrics.game-art-inset;
                width: parent.width - (Metrics.game-art-inset * 2);
                height: parent.height - (Metrics.game-art-inset * 2);
                border-radius: Metrics.cover-radius;
                background: transparent;
                clip: true;

                if root.game.has-artwork : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.game.artwork;
                    // ArtworkService already produces the complete square composition.
                    // Keep presentation non-destructive if that invariant ever regresses.
                    image-fit: contain;
                    image-rendering: root.game.pixelated-artwork ? pixelated : smooth;
                }

                if !root.game.has-artwork : FallbackCover {
                    width: parent.width;
                    height: parent.height;
                    game: root.game;
                }

                // Parent the Playing overlay to the clipped cover artwork, not
                // the scaling shell. The 12px artwork-edge inset is invariant
                // when selection, launch press, or spring release resize the
                // shell. Keep both layers mounted for their exit fades; content
                // does not ride the capsule's 7px Playing-state translation.
                playing-pill-anchor := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - Metrics.playing-pill-artwork-bottom-inset;
                    width: 90px;
                    height: 30px;
                    background: transparent;

                    // Move only the rounded capsule on Playing state changes.
                    // The label and dot have no extra local y animation.
                    playing-pill-surface := Rectangle {
                        x: 0px;
                        y: root.game.is-playing ? 0px : Motion.playing-pill-travel;
                        opacity: root.game.is-playing ? 1.0 : 0.0;
                        width: parent.width;
                        height: parent.height;

                        // A calm rise/fade on entry and a shorter sink/fade on exit.
                        // Both transitions reverse smoothly when state changes quickly.
                        animate y {
                            duration: root.game.is-playing
                                ? Motion.playing-pill-enter-duration
                                : Motion.playing-pill-exit-duration;
                            easing: ease-out;
                        }
                        animate opacity {
                            duration: root.game.is-playing
                                ? Motion.playing-pill-enter-duration
                                : Motion.playing-pill-exit-duration;
                            easing: ease-out;
                        }
                        border-radius: 15px;
                        // Switch-like neutral capsule: no accent-coloured perimeter.
                        // A dark fill and light label stay readable over bright cover art.
                        background: Theme.high-contrast
                            ? Theme.playing-pill-background
                            : Theme.playing-pill-background.with-alpha(0.92);
                        border-width: 0px;
                    }

                    playing-pill-content := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        background: transparent;
                        opacity: root.game.is-playing ? 1.0 : 0.0;

                        // Text reaches its final alpha ahead of the background's
                        // last few slide frames; avoid any end-of-ease font pop.
                        // Unlike the capsule, its baseline does not animate locally.
                        animate opacity {
                            duration: root.game.is-playing
                                ? Motion.playing-pill-label-enter-duration
                                : Motion.playing-pill-label-exit-duration;
                            easing: ease-out;
                        }

                        Rectangle {
                            x: 12px;
                            y: (parent.height - self.height) / 2;
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: Theme.accent;
                        }
                        Text {
                            x: 25px;
                            width: parent.width - 29px;
                            height: parent.height;
                            text: "Playing";
                            color: Theme.playing-pill-foreground;
                            font-family: Typography.family;
                            font-size: Typography.caption-size;
                            font-weight: Typography.emphasis-weight;
                            vertical-alignment: center;
                        }
                    }
                }
            }


        }

        focus := FocusFrame {
            active: root.selected && root.focus-visible && !root.launching;
            x: -Metrics.focus-offset;
            y: -Metrics.focus-offset;
            width: parent.width + Metrics.focus-offset * 2;
            height: parent.height + Metrics.focus-offset * 2;
            opacity: root.selected && root.focus-visible ? 1 : 0;

            animate opacity {
                duration: Motion.focus-duration;
                easing: ease-in-out;
            }
        }
    }

    TouchArea {
        clicked => { root.activated(root.item-index); }
    }
}
