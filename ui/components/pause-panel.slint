import { ValueText } from "value-text.slint";
import { SaveStateRow } from "../models/save-state.slint";
import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { MarqueeText } from "marquee-text.slint";
import { ListRow } from "list-row.slint";
import { ActionButton } from "action-button.slint";
import { HintBar } from "hint-bar.slint";
import { TransitionDriver, TransitionLayer } from "transition.slint";
import { ScrollEdgeShadow } from "page-header.slint";
import { SettingsRow } from "settings-row.slint";

component PauseAction inherits ListRow {
    in property <string> value;
    in property <bool> available: true;
    // Room for the value; wider values ("Large and small") ask for more.
    in property <length> value-width: Metrics.spacing-xxl * 2;
    // The menu shrinks its rows a little when a small window can't fit them.
    in property <length> row-height: Metrics.pause-row-height;
    height: root.row-height;
    compact: true;
    trailing-width: root.value-width;
    accessible-description: root.available ? root.value : "Not available yet";
    opacity: root.available ? 1.0 : 0.48;
    in property <bool> forward: true;
    ValueText {
        x: parent.width - root.value-width;
        width: root.value-width - Metrics.spacing-lg;
        height: parent.height;
        text: root.value; forward: root.forward;
        text-color: root.focused ? Theme.accent : Theme.secondary-foreground;
        edge-color: root.surface-color;
        font-weight: Typography.body-weight;
    }
}

export component PausePanel inherits Rectangle {
    in property <bool> open;
    in property <float> shadow-strength: 1.0;
    in property <length> footer-center: Metrics.hint-row-center-from-bottom;
    in property <bool> busy;
    in property <int> speed: 1;
    in property <image> screenshot-preview;
    in property <bool> screenshot-visible;
    in property <int> screenshot-sequence;
    private property <float> screenshot-phase: 0;
    animate screenshot-phase { duration: Motion.value-swap-duration; easing: ease-out; }
    changed screenshot-sequence => { root.screenshot-phase = root.screenshot-sequence; }
    private property <float> screenshot-reveal: Motion.reduced-motion ? 1.0 : 1.0 - min(1.0, root.screenshot-sequence - root.screenshot-phase);
    private property <float> screenshot-opacity: root.screenshot-visible ? 1.0 : 0.0;
    animate screenshot-opacity { duration: Motion.value-swap-duration; easing: ease-out; }
    in property <int> state-mode;
    in property <int> state-focus;
    in property <[SaveStateRow]> state-rows;
    callback state-choose(int);
    in property <bool> restart-confirm;
    in property <int> restart-focus;
    in property <int> focused;
    // A DS or 3DS game: offer Screen layout (action 8) and Swap screens
    // (action 7) after Playback speed; a DS also has its lid (action 9).
    in property <bool> ds;
    in property <bool> lid-available: true;
    in property <bool> states-available: true;
    // Rewind takes a state every half-second: not for 3DS games.
    in property <bool> rewind-available: true;
    in property <bool> ds-lid-closed;
    in property <string> ds-layout;
    in property <bool> ds-layout-forward: true;
    in property <string> title;
    in property <string> message;
    callback choose(int);
    callback restart-answer(int);
    function activate(index: int) {
        if root.open && !root.busy { root.choose(index); }
    }
    function answer(index: int) {
        if root.open && !root.busy { root.restart-answer(index); }
    }
    // Rust owns the destination; these keys only describe its visual depth.
    private property <int> view: root.restart-confirm ? 4 : root.state-mode;
    private property <length> content-top: Metrics.spacing-lg * 3 + Metrics.compact-title-height + Metrics.compact-row-height;
    private property <length> content-height: root.height - root.content-top - root.footer-center - Metrics.hint-row-height * 2;
    view-transition := TransitionDriver { key: root.view; prewarm: true; retargetable: true; }
    private property <int> view-phase: Motion.reduced-motion ? 3 : view-transition.phase;
    private property <bool> view-back: root.view-depth(root.view) < root.view-depth(view-transition.from-key);
    pure function view-depth(view: int) -> int { return view == 0 ? 0 : (view == 1 || view == 2 ? 1 : 2); }
    background: Theme.background;
    ScrollEdgeShadow {
        x: root.width;
        width: Metrics.scroll-edge-shadow-height; height: root.height;
        direction: 90deg; strength: root.shadow-strength;
    }
    Text {
        x: Metrics.spacing-lg; y: Metrics.spacing-lg;
        width: parent.width - Metrics.spacing-lg * 2; height: Metrics.compact-title-height;
        text: root.state-mode == 1 ? "Save state" : root.state-mode == 2 ? "Load state" : root.state-mode == 3 ? "Replace state" : "Paused"; color: Theme.secondary-foreground; font-size: Typography.caption-size;
    }
    MarqueeText {
        active: root.open && !root.restart-confirm;
        edge-color: Theme.background;
        x: Metrics.spacing-lg; y: Metrics.spacing-lg + Metrics.compact-title-height;
        width: parent.width - Metrics.spacing-lg * 2; height: Metrics.compact-row-height + Metrics.spacing-md;
        text: root.title; text-color: Theme.foreground;
        font-size: Typography.heading-size; font-weight: Typography.heading-weight;
    }
    Rectangle {
        y: root.content-top; width: root.width; height: root.content-height;
        background: transparent; clip: true;
        TransitionLayer {
            active: root.view == 0; outgoing: view-transition.from-key == 0;
            returning: root.view-back; phase: root.view-phase;
            x: Metrics.spacing-lg; rest-y: 0px;
            width: root.width - Metrics.spacing-lg * 2; height: root.content-height;
            // DS has eleven actions: in a small window every row shrinks a
            // little so they all fit, rather than the menu scrolling.
            menu := VerticalLayout {
                property <int> rows: 5 + (root.states-available ? 2 : 0) + (root.states-available && root.rewind-available ? 1 : 0) + (root.ds ? 2 : 0) + (root.ds && root.lid-available ? 1 : 0);
                property <bool> tight: (root.content-height - Metrics.spacing-xs * (self.rows + 1) - Metrics.spacing-sm * 2) / self.rows < 36px;
                property <length> gap: self.tight ? Metrics.spacing-xs / 2 : Metrics.spacing-xs;
                property <length> fit: (root.content-height - self.gap * (self.rows + 1) - Metrics.spacing-sm * 2) / self.rows;
                property <length> row-size: max(36px, min(Metrics.pause-row-height, self.fit));
                y: 0px; width: parent.width;
                height: self.row-size * self.rows + self.gap * (self.rows + 1) + Metrics.spacing-sm * 2;
                spacing: self.gap;
                PauseAction { row-height: menu.row-size; title: "Continue"; focused: root.view == 0 && root.focused == 0; enabled: root.open && root.view == 0; activated => { root.activate(0); } }
                SettingsRow { height: menu.row-size; compact: true; title: "Fast-forward (2×)"; toggle: true; compact-toggle: true; checked: root.speed == 2; focused: root.view == 0 && root.focused == 1; enabled: root.open && root.view == 0; activated => { root.activate(1); } }
                if root.states-available && root.rewind-available : PauseAction { row-height: menu.row-size; title: "Rewind"; focused: root.view == 0 && root.focused == 10; enabled: root.open && root.view == 0; activated => { root.activate(10); } }
                if root.ds : PauseAction { row-height: menu.row-size; title: "Screen layout"; value: root.ds-layout; value-width: Metrics.spacing-xxl * 3.5; forward: root.ds-layout-forward; focused: root.view == 0 && root.focused == 8; enabled: root.open && root.view == 0; activated => { root.activate(8); } }
                if root.ds : PauseAction { row-height: menu.row-size; title: "Swap screens"; focused: root.view == 0 && root.focused == 7; enabled: root.open && root.view == 0; activated => { root.activate(7); } }
                if root.ds && root.lid-available : PauseAction { row-height: menu.row-size; title: root.ds-lid-closed ? "Open lid" : "Close lid"; focused: root.view == 0 && root.focused == 9; enabled: root.open && root.view == 0; activated => { root.activate(9); } }
                if root.states-available : Rectangle { height: Metrics.spacing-sm; background: transparent; }
                if root.states-available : PauseAction { row-height: menu.row-size; title: "Save state"; focused: root.view == 0 && root.focused == 2; enabled: root.open && root.view == 0; activated => { root.activate(2); } }
                if root.states-available : PauseAction { row-height: menu.row-size; title: "Load state"; focused: root.view == 0 && root.focused == 3; enabled: root.open && root.view == 0; activated => { root.activate(3); } }
                Rectangle { height: Metrics.spacing-sm; background: transparent; }
                PauseAction {
                    row-height: menu.row-size;
                    title: "Take screenshot"; focused: root.view == 0 && root.focused == 4;
                    enabled: root.open && root.view == 0;
                    accessible-description: root.screenshot-visible ? "Screenshot saved to Album" : "";
                    activated => { root.activate(4); }
                    Rectangle {
                        x: parent.width - Metrics.spacing-lg - self.width;
                        y: (parent.height - self.height) / 2;
                        width: Metrics.spacing-xxl; height: Metrics.spacing-xl;
                        background: Theme.surface-raised; border-radius: Metrics.radius-sm; clip: true;
                        visible: root.screenshot-opacity > 0;
                        opacity: root.screenshot-opacity * root.screenshot-reveal;
                        transform-scale: Motion.reduced-motion ? 1.0 : 0.9 + 0.1 * root.screenshot-reveal;
                        Image { width: parent.width; height: parent.height; source: root.screenshot-preview;
                            image-fit: contain; image-rendering: pixelated; }
                    }
                }
                PauseAction { row-height: menu.row-size; title: "Restart"; focused: root.view == 0 && root.focused == 5; enabled: root.open && root.view == 0; activated => { root.activate(5); } }
                PauseAction { row-height: menu.row-size; title: "Return to Horizon"; focused: root.view == 0 && root.focused == 6; enabled: root.open && root.view == 0; activated => { root.activate(6); } }
            }
        }
        for view in [1, 2] : TransitionLayer {
            active: root.view == view; outgoing: view-transition.from-key == view;
            returning: root.view-back; phase: root.view-phase;
            x: Metrics.spacing-lg; rest-y: 0px;
            width: parent.width - Metrics.spacing-lg * 2;
            height: root.content-height;
            background: transparent;
            for row in root.state-rows : ListRow {
                visible: view == 2 || row.slot > 0;
                y: (row.slot - (view == 1 ? 1 : 0)) * (Metrics.list-row-height + Metrics.spacing-xs);
                width: parent.width; height: Metrics.list-row-height;
                title: row.title; subtitle: row.detail;
                focused: root.view == view && row.slot == root.state-focus;
                enabled: root.open && root.view == view && (view == 1 || row.available);
                trailing-width: Metrics.spacing-xxl * 2 + Metrics.spacing-lg;
                opacity: view == 1 || row.available ? 1 : 0.48;
                activated => { if root.open && root.view == view && !root.busy { root.state-choose(row.slot); } }
                Rectangle {
                    x: parent.width - Metrics.spacing-lg - self.width;
                    y: Metrics.spacing-sm;
                    width: Metrics.spacing-xxl * 2; height: parent.height - Metrics.spacing-sm * 2;
                    background: Theme.surface-raised; border-radius: Metrics.radius-sm; clip: true;
                    Image { width: parent.width; height: parent.height; source: row.preview;
                        visible: row.occupied; image-fit: contain; image-rendering: pixelated; }
                }
            }
        }
        for view in [3, 4] : TransitionLayer {
            active: root.view == view; outgoing: view-transition.from-key == view;
            returning: root.view-back; phase: root.view-phase;
            x: Metrics.spacing-lg; rest-y: 0px;
            width: root.width - Metrics.spacing-lg * 2; height: root.content-height;
            VerticalLayout {
                y: 0px; width: parent.width;
                height: Metrics.compact-row-height * 4 + Metrics.spacing-lg;
                alignment: start; spacing: Metrics.spacing-lg;
                Text { height: Metrics.compact-row-height + Metrics.spacing-md; text: view == 3 ? "Replace the saved state in this slot?\nThe previous copy is kept" : "Restart from the beginning?\nBattery saves are kept"; wrap: word-wrap; color: Theme.foreground; font-size: Typography.body-size; }
                ActionButton { height: Metrics.pause-row-height; label: "Cancel"; focused: root.view == view && root.restart-focus == 0; enabled: root.open && root.view == view; activated => { root.answer(0); } }
                ActionButton { height: Metrics.pause-row-height; label: view == 3 ? "Replace state" : "Restart game"; focused: root.view == view && root.restart-focus == 1; enabled: root.open && root.view == view; activated => { root.answer(1); } }
            }
        }
    }
    Text {
        x: Metrics.spacing-lg; y: parent.height - root.footer-center - Metrics.hint-row-height / 2 - Metrics.spacing-md - Metrics.hint-row-height;
        width: parent.width - Metrics.spacing-lg * 2; height: Metrics.hint-row-height;
        text: root.message; wrap: word-wrap; color: Theme.secondary-foreground; font-size: Typography.caption-size;
    }
    HintBar {
        x: Metrics.spacing-lg; y: parent.height - root.footer-center - Metrics.hint-row-height / 2;
        width: parent.width - Metrics.spacing-lg * 2; height: Metrics.hint-row-height;
        hints: root.state-mode == 2 && root.state-focus < 0 ? [{ button: "B", label: "Back" }] : [{ button: "B", label: (root.restart-confirm || root.state-mode == 3) ? "Cancel" : root.state-mode != 0 ? "Back" : "Continue" }, { button: "A", label: "Select" }];
        interactive: root.open && !root.busy;
        activated(button) => {
            if root.restart-confirm || root.state-mode == 3 { root.answer(button == "B" ? 0 : root.restart-focus); }
            else if root.state-mode != 0 {
                if button == "B" { root.activate(0); }
                else if root.state-focus >= 0 { root.state-choose(root.state-focus); }
            }
            else { root.activate(button == "B" ? 0 : root.focused); }
        }
    }
}
