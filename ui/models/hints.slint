// One controller hint: button glyph(s) ("A", "B", "X", "LB", "RB") and the
// action. Bumper pickers are not hints: their glyphs sit beside the header
// value they change (HeaderValue.button).
// `button2` is optional, for a pair that shares one action (LB RB: Source).
export struct HintData {
    button: string,
    button2: string,
    label: string,
}
