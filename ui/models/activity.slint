import { GameCardData } from "game-card.slint";

// The activity game row deliberately shares Home/Library cover data, not a
// second artwork pipeline or a source-specific presentation model.
export struct ActivityCoverData {
    game: GameCardData,
    observed-time: string,
}

export struct ActivityDayData {
    label: string,
    duration: string,
    fraction: float,
}

// One visible slice of the complete game session history. Rows are not
// provider lifetime estimates; they originate only from persisted sessions.
export struct ActivityHistoryRowData {
    date: string,
    times: string,
    duration: string,
    status: string,
}
