// Horizon-owned utility artwork is rendered directly from the supplied SVG
// files. Do not transcribe, recolor, colorize, or otherwise derive these
// assets in Slint; preserving the authored SVG is part of the visual contract.
//
// AppWindow uniformly scales the logical scene. Slint rasterizes SVG Image
// elements before that outer scene transform, so the source target should track
// actual enlargement instead of always using a fixed 4x intermediate image.
// At normal/downscaled sizes render directly at the logical icon size; when the
// shell is enlarged, supersample only by the current UI scale (capped at 4x).
// This avoids unnecessary downsampling at small window scales while preserving
// crisp authored SVGs in fullscreen/high-resolution layouts.
component AuthoredUtilityIcon inherits Rectangle {
    in property <image> artwork;
    in property <float> render-scale: 1.0;
    background: transparent;

    private property <float> internal-render-scale:
        root.render-scale > 1.0
            ? (root.render-scale < 4.0 ? root.render-scale : 4.0)
            : 1.0;

    Image {
        x: 0px;
        y: 0px;
        width: root.width * root.internal-render-scale;
        height: root.height * root.internal-render-scale;
        source: root.artwork;
        image-fit: contain;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: 1.0 / root.internal-render-scale;
    }
}

export component FriendsIcon inherits AuthoredUtilityIcon {
    artwork: @image-url("../assets/orange-friends.svg");
}

export component AlbumIcon inherits AuthoredUtilityIcon {
    artwork: @image-url("../assets/blue-album.svg");
}

export component ActivityIcon inherits AuthoredUtilityIcon {
    artwork: @image-url("../assets/teal-activity.svg");
}

export component WebIcon inherits AuthoredUtilityIcon {
    artwork: @image-url("../assets/gray-web.svg");
}

export component SettingsIcon inherits AuthoredUtilityIcon {
    artwork: @image-url("../assets/gray-settings.svg");
}

export component ShopIcon inherits AuthoredUtilityIcon {
    artwork: @image-url("../assets/red-shop.svg");
}
