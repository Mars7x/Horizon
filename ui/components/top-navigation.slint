import { Theme, Metrics, Motion } from "../theme/theme.slint";
import { SelectionFocusSurface } from "selection-focus-surface.slint";
import { ProfileAvatar } from "profile-avatar.slint";
import { ProfileFrameData } from "../models/profile.slint";
import { BatteryIndicator, NetworkIndicator } from "status-glyphs.slint";
import { FriendsIcon, AlbumIcon, ActivityIcon, AchievementsIcon, SettingsIcon, ShopIcon } from "utility-icons.slint";

component Separator inherits Rectangle {
    width: 1px;
    height: 30px;
    background: Theme.divider.with-alpha(0.78);
}

component StatusCluster inherits Rectangle {
    in property <int> network-kind: 0; // 0 offline, 1 Ethernet, 2 Wi-Fi, 3 other
    in property <int> wifi-strength: 0;
    in property <bool> network-limited: false;
    in property <bool> battery-visible: false;
    in property <int> battery-percent: 0;
    in property <bool> battery-charging: false;
    width: root.battery-visible ? 113px : 66px;
    animate width { duration: root.battery-visible ? Motion.status-enter-duration : Motion.status-exit-duration; easing: ease-in-out; }
    height: 30px;
    background: transparent;

    Separator { x: 0px; y: (parent.height - self.height) / 2; }
    // Offline never claims a wired disconnection (NetworkManager hasn't said
    // which interface would be disconnected), and another kind of
    // connection is never assumed to be Ethernet.
    NetworkIndicator {
        x: 28px; y: (parent.height - self.height) / 2;
        kind: root.network-kind;
        strength: root.wifi-strength;
        limited: root.network-limited;
    }
    // Keep the indicator mounted so *both* appear and disappear animate.
    // Its right edge stays anchored to the cluster during width changes,
    // with a separate small slide/fade only for its own visibility.
    battery-slot := Rectangle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: 35px;
        height: 24px;
        background: transparent;
        // This slot follows the animated status cluster's width without a
        // second x-animation fighting that continuously moving position.
        battery-status := BatteryIndicator {
            x: root.battery-visible ? 0px : Motion.status-slide-distance;
            y: root.battery-visible ? 0px : 3px;
            opacity: root.battery-visible ? 1.0 : 0.0;
            animate x, y, opacity {
                duration: root.battery-visible ? Motion.status-enter-duration : Motion.status-exit-duration;
                easing: ease-in-out;
            }
            percent: root.battery-percent;
            charging: root.battery-charging;
        }
    }
}

// The icon and its single-stroke focus ring rise together by 2px on focus.
// The 40px layout cell stays fixed, preserving navigation hit geometry.
component UtilityFocusSurface inherits Rectangle {
    in property <bool> focused: false;
    out property <length> focus-lift: root.focused && !Motion.reduced-motion ? -2px : 0px;
    background: transparent;
    z: root.focused ? 2 : 0;

    SelectionFocusSurface {
        x: -4px;
        y: -4px + root.focus-lift;
        width: 48px; height: 48px;
        corner-radius: 24px;
        focused: root.focused;
        animate y { duration: Motion.focus-duration; easing: ease-in-out; }
    }
}

export component TopNavigation inherits Rectangle {
    in property <float> icon-render-scale: 1.0;
    in property <image> profile-picture;
    in property <bool> profile-has-picture: false;
    in property <bool> profile-square: false;
    in property <image> profile-frame;
    in property <bool> profile-has-frame: false;
    in property <[ProfileFrameData]> profile-picture-frames;
    in property <[ProfileFrameData]> profile-frame-frames;
    in property <bool> profile-playing: false;
    in property <int> network-kind: 0;
    in property <int> wifi-strength: 0;
    in property <bool> network-limited: false;
    in property <bool> battery-visible: false;
    in property <int> battery-percent: 0;
    in property <bool> battery-charging: false;
    in property <bool> utility-focus-visible: false;
    in property <int> focused-utility-index: 2;
    callback utility-activated(int);

    background: transparent;
    private property <length> content-center-y: root.height / 2;

    avatar := ProfileAvatar {
        picture: root.profile-picture;
        has-picture: root.profile-has-picture;
        square: root.profile-square;
        frame: root.profile-frame;
        has-frame: root.profile-has-frame;
        picture-frames: root.profile-picture-frames;
        frame-frames: root.profile-frame-frames;
        playing: root.profile-playing;
        x: Metrics.top-edge-inset;
        y: root.content-center-y - self.height / 2;
    }

    Separator {
        x: Metrics.top-edge-inset + avatar.width + 24px;
        y: root.content-center-y - self.height / 2;
    }

    // The entire utility row is one screen-level focus region. Rust owns which
    // item is focused; these cells only visualize state and emit activation.
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: root.content-center-y - self.height / 2;
        width: Metrics.utility-row-width;
        height: Metrics.utility-cell-size;
        spacing: Metrics.utility-spacing;

        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 0;
            FriendsIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + parent.focus-lift;
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(0); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 1;
            AlbumIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + parent.focus-lift;
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(1); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 2;
            ActivityIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + parent.focus-lift;
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(2); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 3;
            AchievementsIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + parent.focus-lift;
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(3); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 4;
            SettingsIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + parent.focus-lift;
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(4); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 5;
            ShopIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 + parent.focus-lift;
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(5); } }
        }
    }

    StatusCluster {
        x: parent.width - Metrics.top-edge-inset - self.width;
        y: root.content-center-y - self.height / 2;
        network-kind: root.network-kind;
        wifi-strength: root.wifi-strength;
        network-limited: root.network-limited;
        battery-visible: root.battery-visible;
        battery-percent: root.battery-percent;
        battery-charging: root.battery-charging;
    }
}
