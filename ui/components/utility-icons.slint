import { Theme } from "../theme/theme.slint";

// These components preserve the geometry of the supplied symbolic SVG source
// assets, but render them as Slint Paths so they stay vector-crisp at every
// Horizon scale. Color is applied semantically at render time from Theme.

export component FriendsIcon inherits Rectangle {
    in property <color> tint: Theme.nav-friends;
    background: transparent;

    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 16; viewbox-height: 16;
        commands: "M 1 8 C 1 11.8659935, 4.13400698 15, 8 15 C 11.8659935 15, 15 11.8659935, 15 8 C 15 4.13400698, 11.8659935 1, 8 1 C 4.13400698 1, 1 4.13400698, 1 8 Z";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 16; viewbox-height: 16;
        commands: "M 10.999999 6.49655151 C 10.999999 6.77459812, 10.7745981 7, 10.4965525 7 C 10.2185049 7, 9.99310303 6.77459812, 9.99310303 6.49655151 C 9.99310303 6.21850491, 10.2185049 5.99310303, 10.4965525 5.99310303 C 10.7745981 5.99310303, 10.999999 6.21850491, 10.999999 6.49655151 Z M 6.03448296 6.49655151 C 6.03448296 6.77459812, 5.80908108 7, 5.53103447 7 C 5.25298786 7, 5.02758598 6.77459812, 5.02758598 6.49655151 C 5.02758598 6.21850491, 5.25298786 5.99310303, 5.53103447 5.99310303 C 5.80908108 5.99310303, 6.03448296 6.21850491, 6.03448296 6.49655151 Z";
        fill: root.tint;
    }

    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 16; viewbox-height: 16;
        commands: "M 11.0310888 9.48407745 C 10.4058743 10.5669813, 9.25042915 11.2340775, 8 11.2340775 C 6.74957037 11.2340775, 5.59412575 10.5669813, 4.96891117 9.48407745";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

