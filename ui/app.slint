import { Theme, Metrics, Typography, Motion } from "theme/theme.slint";
export { Theme, Metrics, Typography, Motion }
import { Wheel } from "components/wheel.slint";
export { Wheel }
import { InputGlyphs, GlyphFamily } from "components/hint-bar.slint";
export { InputGlyphs, GlyphFamily }
import { ControllerArt } from "components/system-icons.slint";
export { ControllerArt }

import { GameCardData } from "models/game-card.slint";
export { GameCardData }
import { LibraryCardData } from "models/library.slint";
export { LibraryCardData }
import { ActivityCoverData, ActivityDayData, ActivityHistoryRowData } from "models/activity.slint";
import { AchievementGameData, AchievementEntryData } from "models/achievements.slint";
export { AchievementGameData, AchievementEntryData }
export { ActivityCoverData, ActivityDayData, ActivityHistoryRowData }
import { AlbumTileData } from "models/album.slint";
export { AlbumTileData }
export { HintData }

import { AppRouteView } from "models/navigation.slint";
import { ProfileFrameData, FriendData } from "models/profile.slint";
export { ProfileFrameData }
export { AppRouteView }

import { TopNavigation } from "components/top-navigation.slint";

import { TransitionDriver, TransitionLayer } from "components/transition.slint";
import { Footer } from "components/footer.slint";
import { HintBar } from "components/hint-bar.slint";
import { OnScreenKeyboard } from "components/on-screen-keyboard.slint";
import { KeyboardKeyData } from "models/keyboard.slint";
import { HintData } from "models/hints.slint";
import { HomePage } from "pages/home.slint";
import { LibraryPage } from "pages/library.slint";
import { ActivityPage } from "pages/activity.slint";
import { AchievementsPage } from "pages/achievements.slint";
import { AlbumPage } from "pages/album.slint";
import { ActivityGameDetailsPage } from "pages/activity-game-details.slint";
import { SettingsPage } from "pages/settings.slint";
import { ShopPage } from "pages/shop.slint";
import { ShopAppData, ShopShotData } from "models/shop.slint";
export { ShopAppData, ShopShotData }
import { ProfilePage } from "pages/profile.slint";

export component AppWindow inherits Window {
    title: "Horizon";
    preferred-width: Metrics.design-width;
    preferred-height: Metrics.design-height;
    min-width: 800px;
    min-height: 450px;
    background: Theme.background;
    default-font-family: Typography.family;
    forward-focus: input-scope;

    // Horizon keeps one uniform visual scale, but the logical viewport itself
    // grows with the native window. This preserves square tiles/type/icon
    // proportions while allowing 16:9, 16:10, 21:9 and fullscreen windows to
    // use every available pixel instead of letterboxing a fixed 1280×720 box.
    private property <float> width-scale: root.width / Metrics.design-width;
    private property <float> height-scale: root.height / Metrics.design-height;
    private property <float> raw-ui-scale: root.width-scale < root.height-scale
        ? root.width-scale
        : root.height-scale;
    // Some compositors briefly report a zero-sized surface while minimizing or
    // changing fullscreen state. Fall back to the reference surface instead of
    // dividing by zero; normal non-zero sizes use the exact existing scale.
    private property <float> ui-scale: root.raw-ui-scale > 0.0
        ? root.raw-ui-scale
        : 1.0;
    private property <length> logical-width: root.raw-ui-scale > 0.0
        ? root.width / root.ui-scale
        : Metrics.design-width;
    private property <length> logical-height: root.raw-ui-scale > 0.0
        ? root.height / root.ui-scale
        : Metrics.design-height;
    private property <length> shell-content-height:
        root.logical-height > Metrics.top-chrome-height + Metrics.footer-height
        ? root.logical-height - Metrics.top-chrome-height - Metrics.footer-height
        : 0px;

    // Rust owns route history/policy. Slint only presents the active route from
    // the published presentation enum and may animate that presentation.
    in property <AppRouteView> current-route: AppRouteView.home;
    // Rust publishes only the immediate source route. This lets rapid route
    // changes keep a single outgoing transition instead of accumulating several
    // half-visible retained pages.
    in property <AppRouteView> transition-from-route: AppRouteView.home;
    // Page changes use the shared Zoom (components/transition.slint).
    // Leaving Home is forward; returning to Home is Back.
    route-transition := TransitionDriver {
        prewarm: true;
        key: root.route-key(root.current-route);
    }
    pure function route-key(route: AppRouteView) -> int {
        return route == AppRouteView.home ? 0 : route == AppRouteView.library ? 1
            : route == AppRouteView.album ? 2 : route == AppRouteView.activity ? 3
            : route == AppRouteView.achievements ? 4 : route == AppRouteView.settings ? 5
            : route == AppRouteView.shop ? 6 : 7;
    }
    private property <int> route-phase: route-transition.phase;
    private property <bool> route-back: root.current-route == AppRouteView.home
        && root.transition-from-route != AppRouteView.home;
    // Controller hints per page state. Keep in step with the Rust handlers.
    private property <[HintData]> page-hints:
        // Bumper pickers are shown beside their header values, not here.
        // Order: X, then B, with A always rightmost.
        // The on-screen keyboard needs no hints.
        root.keyboard-open ? []
        : root.current-route == AppRouteView.library ? (root.library-total-count > 0
            ? [{ button: "B", label: "Back" }, { button: "A", label: "Play" }]
            : [{ button: "B", label: "Back" }])
        : root.current-route == AppRouteView.activity ? (root.activity-details-visible
            ? [{ button: "B", label: "Back" }]
            : [{ button: "B", label: "Back" }, { button: "A", label: "Details" }])
        : root.current-route == AppRouteView.achievements ? (root.achievements-viewing-entries
            ? [{ button: "B", label: "Back" }]
            : [{ button: "B", label: "Back" }, { button: "A", label: "Open" }])
        // Fullscreen: Left/Right browse and LB/RB skip 10 s are not listed.
        // The Album's hints depend on its viewer, selection and capture
        // owners; its controller publishes them (`album-hints`).
        : root.current-route == AppRouteView.album ? root.album-hints
        : root.current-route == AppRouteView.settings && root.settings-confirm-open
            ? [{ button: "B", label: "Cancel" }, { button: "A", label: "Select" }]
        : root.current-route == AppRouteView.settings ? (root.settings-secondary-label != ""
            ? [{ button: "X", label: root.settings-secondary-label }, { button: "B", label: "Back" }, { button: "A", label: "Select" }]
            : [{ button: "B", label: "Back" }, { button: "A", label: "Select" }])
        : root.current-route == AppRouteView.shop ? (root.shop-confirm-open
            ? [{ button: "B", label: "Cancel" }, { button: "A", label: "Select" }]
            : root.shop-details-open ? (root.shop-busy-label != "" || root.shop-action-label == ""
                ? [{ button: "B", label: "Back" }]
                : [{ button: "B", label: "Back" }, { button: "A", label: root.shop-action-label }])
            : root.shop-searching ? [{ button: "B", label: "Done" }]
            : root.shop-search-focused ? (root.shop-query != ""
                ? [{ button: "X", label: "Clear" }, { button: "B", label: "Back" }, { button: "A", label: "Search" }]
                : [{ button: "B", label: "Back" }, { button: "A", label: "Search" }])
            : root.shop-app-count > 0 ? [{ button: "B", label: "Back" }, { button: "A", label: "Open" }]
            : [{ button: "B", label: "Back" }])
        : root.current-route == AppRouteView.profile ? (root.profile-editing-name || root.profile-confirm-open
            ? [{ button: "B", label: "Cancel" }, { button: "A", label: "Select" }]
            : root.profile-edit-open ? (root.profile-edit-selection == 1 && root.profile-page-has-chosen
                ? [{ button: "X", label: "Remove" }, { button: "B", label: "Close" }, { button: "A", label: "Select" }]
                : [{ button: "B", label: "Close" }, { button: "A", label: "Select" }])
            : [{ button: "B", label: "Back" }, { button: "A", label: "Edit profile" }])
        : [{ button: "B", label: "Back" }];
    in property <bool> top-utilities-focused: false;
    in property <int> focused-utility-index: 1;

    // Home alone owns its top utilities and status/footer chrome. Library is
    // a durable full-shell destination, like Settings and other submenu routes.
    // The route on screen: the outgoing one until the transition starts.
    // Chrome and hints follow it so they switch together with the pages.
    // Home's chrome belongs to Home: it zooms and fades with Home, around the
    // window centre, exactly as Home's page layer does.
    private property <bool> shell-chrome-visible: root.current-route == AppRouteView.home
        || (root.transition-from-route == AppRouteView.home && root.route-phase < 3);
    private property <float> chrome-opacity: root.current-route == AppRouteView.home
        ? (root.route-back && root.route-phase <= 1 ? 0.0 : 1.0)
        : (root.route-phase >= 2 ? 0.0 : 1.0);
    private property <float> chrome-scale: root.current-route == AppRouteView.home
        ? (root.route-back && root.route-phase == 1 ? 1.06 : 1.0)
        : (root.route-phase >= 2 ? 1.06 : 1.0);
    animate chrome-opacity, chrome-scale {
        duration: root.route-phase == 2 ? Motion.page-duration : 0ms;
        easing: ease-out;
    }

    // Read-only geometry telemetry for Rust-owned spatial focus transfer.
    // Slint reports where the presentation actually rendered things; Rust
    // still decides which item receives focus.
    out property <float> logical-viewport-width-px: root.logical-width / 1px;
    out property <float> utility-center-step-px: Metrics.utility-center-step / 1px;
    out property <float> home-game-stride-px: Metrics.game-stride / 1px;
    in-out property <float> home-first-game-center-x-px:
        (Metrics.carousel-shelf-left
            + Metrics.carousel-content-padding
            + Metrics.game-stride / 2) / 1px;

    in property <[GameCardData]> games;
    // Home's row changing (a new game, a game just played): each card's
    // place before the change (-1: new), the old row's length, and a counter
    // Rust bumps to play the change, after the page transition when delayed.
    in property <[int]> home-from-indices;
    in property <int> home-previous-count: 0;
    in-out property <int> home-reorder-sequence: 0;
    in property <bool> home-reorder-delayed: false;
    in property <[LibraryCardData]> library-cards;
    in property <[LibraryCardData]> library-previous-cards;
    in property <int> library-previous-grid-columns: 1;
    in property <int> library-previous-scroll-row: 0;
    in property <int> library-previous-total-count: 0;
    in property <int> library-previous-selected-index: -1;
    in property <bool> library-has-previous-grid: false;
    in property <int> library-selected-index: 0;
    in property <int> library-browse-sequence: 0;
    in property <string> library-filter-text: "All sources";
    in property <string> library-sort-text: "Alphabetical";
    in property <int> library-total-count: 0;
    in property <int> library-collection-count: 0;
    in property <string> library-selected-title: "";
    in property <string> library-selected-source: "";
    in property <int> library-grid-columns: 7;
    in property <int> library-scroll-row: 0;
    in property <int> library-metadata-sequence: 0;
    out property <float> logical-viewport-height-px: root.logical-height / 1px;
    callback library-layout-changed();
    changed logical-width => { root.library-layout-changed(); }
    changed logical-height => { root.library-layout-changed(); root.activity-detail-layout-changed(); }
    in-out property <int> selected-index: 0;
    in property <string> selected-title: "";
    in-out property <int> launching-game-index: -1;
    in-out property <string> launch-feedback-text: "";

    // Activity is persisted/application-owned data. The Activity page only
    // formats and renders these models; it never queries SQLite directly.
    in property <[ActivityCoverData]> activity-covers;
    in property <[ActivityDayData]> activity-days;
    in property <string> activity-week-total: "0 min";
    in property <string> activity-month-total: "0 min";
    in property <int> activity-selected-index: 0;
    in property <[AchievementEntryData]> activity-recent-achievements;
    in property <string> activity-achievement-status: "Connect Steam in Settings";
    in property <string> achievements-game-count: "0 games";
    in property <string> achievements-source-label: "All sources";
    in property <bool> achievements-has-source-choice: false;
    in property <string> achievements-selected-game-title: "Select a game";
    in property <string> achievements-selected-game-provider: "";
    in property <string> achievements-selected-game-progress: "";
    in property <float> achievements-selected-game-fraction: 0;
    callback achievements-cycle-source(int);
    in property <[AchievementGameData]> achievement-games;
    in property <[AchievementEntryData]> achievement-entries;
    in property <string> achievements-status: "Connect Steam in Settings";
    in property <bool> achievements-loading: false;
    in property <int> achievements-selected-index: 0;
    in property <int> achievements-visit-revision: 0;
    in property <int> achievements-catalog-revision: 0;
    in property <int> achievements-first-entry: 0;
    in property <bool> achievements-viewing-entries: false;
    out property <int> achievements-visible-entries: achievements-page.visible-entries;
    callback achievements-select(int);
    callback achievements-scroll-entries(int);
    callback achievements-back();
    // Album: Rust owns the captures, order, selection and decoding; the page
    // reports its grid shape back.
    in property <[HintData]> album-hints;
    in property <[AlbumTileData]> album-tiles;
    in property <[AlbumTileData]> album-previous-tiles;
    in property <int> album-previous-scroll-row: 0;
    in property <int> album-previous-total-count: 0;
    in property <int> album-previous-selected-index: -1;
    in property <int> album-refresh-sequence: 0;
    in property <int> album-total-count: 0;
    in property <int> album-collection-count: 0;
    in property <string> album-status: "";
    in property <string> album-game-text: "All games";
    in property <string> album-kind-text: "All";
    in property <int> album-selected-index: 0;
    in property <int> album-scroll-row: 0;
    in property <int> album-visit-revision: 0;
    in property <string> album-selected-text: "";
    in property <bool> album-viewing: false;
    in property <string> album-viewer-text: "";
    in property <image> album-viewer-image;
    in property <bool> album-viewer-has-image: false;
    in property <image> album-viewer-previous-image;
    in property <bool> album-viewer-previous-has-image: false;
    in property <image> album-viewer-landing-image;
    in property <bool> album-viewer-landing-has-image: false;
    in property <int> album-slide-key: 0;
    in property <int> album-slide-direction: 1;
    in property <bool> album-viewer-is-video: false;
    in property <bool> album-viewer-playing: false;
    in property <string> album-viewer-problem: "";
    // Deleting (Horizon's own captures only). `selecting` is the grid's
    // multi-select; the dialog confirms. Focus is Rust-owned.
    in property <bool> album-selecting: false;
    in property <bool> album-can-delete: false;
    in property <bool> album-dialog-open: false;
    in property <string> album-dialog-title: "";
    in property <string> album-dialog-text: "";
    in property <int> album-dialog-focus: 0;
    callback album-dialog-choose(int);
    // Video clock: position at the last anchor; Slint advances it per frame.
    in property <int> album-video-position-ms: 0;
    in property <int> album-video-duration-ms: 0;
    in property <int> album-video-anchor: 0;
    in property <bool> album-video-clock-running: false;
    in property <bool> album-video-frame-live: false;
    in property <int> album-video-frame-ms: 33;
    // Bumped by Rust on every viewer input: shows the fullscreen overlay.
    in property <int> album-overlay-revision: 0;
    out property <int> album-grid-columns: album-page.grid-columns;
    out property <int> album-visible-rows: album-page.visible-rows;
    callback album-choose(int);
    callback album-cycle-game();
    callback album-cycle-kind();
    callback album-scroll-rows(int);
    callback album-step(int);
    callback album-toggle-play();
    callback album-seek(float);
    callback album-close-viewer();
    callback album-layout-changed();
    in-out property <int> activity-pressed-index: -1;
    out property <bool> activity-reduced-motion: Motion.reduced-motion;
    in property <bool> activity-details-visible: false;
    in property <GameCardData> activity-detail-game;
    in property <string> activity-detail-source;
    in property <string> activity-detail-last-played: "—";
    in property <string> activity-detail-observed: "0 min";
    in property <string> activity-detail-provider-label: "Source lifetime";
    in property <string> activity-detail-provider-time: "Not available";
    in property <string> activity-detail-sessions-summary: "0 sessions";
    in property <string> activity-detail-longest: "—";
    in property <string> activity-detail-average: "—";
    in property <[ActivityHistoryRowData]> activity-detail-rows;
    in property <int> activity-detail-session-count: 0;
    in property <int> activity-detail-first-row: 0;
    in property <int> activity-detail-model-start: 0;
    out property <int> activity-detail-visible-rows: activity-details-page.visible-rows;
    callback activity-detail-layout-changed();
    callback activity-detail-scroll(int);



    // Settings: root, Appearance, Third-Party. All selection and persistence Rust-owned.
    in property <int> settings-view: 0;
    in property <int> settings-selection: 0;
    in property <int> settings-theme-index: 0; // System, Light, Dark, Black
    in property <int> settings-accent-index: 0; // System, spectrum presets
    in property <bool> settings-ui-sounds-enabled: true;

    in property <bool> settings-key-present: false;
    in property <string> settings-steam-identity: "Not set";
    in property <bool> settings-steam-connected: false;
    in property <bool> settings-steam-saved: false;
    in property <int> settings-editor-kind: 0;
    in property <bool> settings-prefer-artwork: false;
    in property <bool> settings-editing-key: false;
    in property <int> settings-editor-target: 0;
    // Native Ctrl state from real TextInput key events. Synthetic paste must
    // not permanently consume a Ctrl key the user is still holding.
    out property <int> settings-physical-control-mask: settings-page.physical-control-mask;
    in property <bool> settings-synthetic-key-insertion: false;
    in-out property <string> settings-key-draft: "";
    in property <string> settings-feedback: "";
    // The profile picture (presentation/profile.rs): Home's avatar, and the
    // Profile page's.
    in property <image> profile-picture;
    in property <bool> profile-has-picture: false;
    // An animated picture's frames (empty when still).
    in property <[ProfileFrameData]> profile-picture-frames;
    // The avatar's letter without a picture, and its focus in the top row.
    in property <string> profile-monogram: "H";
    in property <bool> profile-focused: false;
    // The Profile page (presentation/profile.rs): its actions, the picture
    // dialog and the name editor.
    in property <string> profile-name: "";
    in property <string> profile-page-feedback: "";
    in property <bool> profile-edit-open: false;
    in property <int> profile-edit-selection: 0;
    in property <bool> profile-page-busy: false;
    in property <bool> profile-page-has-chosen: false;
    in property <bool> profile-page-uses-steam: false;
    in property <bool> profile-page-steam-available: false;
    in property <bool> profile-editing-name: false;
    in property <int> profile-editor-target: 0;
    in-out property <string> profile-name-draft: "";
    // The Profile page's Steam friends (presentation/friends.rs).
    in property <[FriendData]> profile-friends;
    in property <int> profile-friends-state: 0;
    in property <int> profile-friends-count: 0;
    in property <string> profile-friends-summary: "";
    in property <int> profile-friends-row: 0;
    out property <int> profile-friends-visible-rows: profile-page.friends-visible-rows;
    // The avatar was clicked; a Profile page action or a picture dialog
    // option was clicked; the name editor saved or cancelled.
    callback profile-open();
    callback profile-edit();
    callback profile-activate-option(int);
    callback profile-remove-picture();
    in property <bool> profile-confirm-open: false;
    in property <int> profile-confirm-focus: 0;
    callback profile-confirm(int);
    callback profile-scroll-friends(int);
    callback profile-save-name(string);
    callback profile-cancel-name();

    // Shop: Flathub, browsed in a grid (presentation/shop.rs). Selection,
    // paging and loading are Rust-owned.
    in property <[ShopAppData]> shop-apps;
    in property <int> shop-app-count: 0;
    in property <int> shop-selected: 0;
    in property <int> shop-first-row: 0;
    in property <int> shop-visit: 0;
    in property <int> shop-state: 0;
    in property <string> shop-category: "Games";
    in property <string> shop-count: "";
    in-out property <string> shop-query: "";
    in property <bool> shop-search-focused: false;
    in property <bool> shop-searching: false;
    in property <int> shop-catalog-revision: 0;
    in property <int> shop-catalog-base: 0;
    out property <int> shop-description-steps: shop-page.description-steps;
    out property <int> shop-columns: shop-page.columns;
    out property <int> shop-visible-rows: shop-page.visible-rows;
    in property <bool> shop-details-open: false;
    in property <string> shop-detail-name;
    in property <string> shop-detail-developer;
    in property <string> shop-detail-summary;
    in property <bool> shop-detail-verified: false;
    in property <image> shop-detail-icon;
    in property <bool> shop-detail-has-icon: false;
    in property <string> shop-detail-description;
    in property <int> shop-detail-state: 0;
    in property <[ShopShotData]> shop-shots;
    in property <int> shop-shot: 0;
    in property <int> shop-description-row: 0;
    in property <string> shop-feedback: "";
    in property <[string]> shop-actions;
    in property <int> shop-action-focus: 0;
    in property <string> shop-action-label: "";
    in property <string> shop-busy-label: "";
    in property <float> shop-progress: -1;
    in property <bool> shop-confirm-open: false;
    in property <int> shop-confirm-focus: 0;
    callback shop-choose(int);
    callback shop-cycle-category(int);
    callback shop-scroll-rows(int);
    callback shop-search-open();
    callback shop-search-edited(string);
    callback shop-search-finish();
    callback shop-search-clear();
    callback shop-activate-action(int);
    callback shop-confirm(int);
    callback shop-close-details();
    callback shop-step-shot(int);
    callback shop-scroll-description(int);
    in property <string> settings-appearance-feedback: "";
    in property <string> settings-artwork-status: "";
    in property <bool> settings-refresh-open: false;
    in property <bool> settings-refresh-running: false;
    in property <int> settings-refresh-completed: 0;
    in property <int> settings-refresh-total: 0;
    in property <string> settings-refresh-error: "";

    in property <int> connected-controller-count: 0;
    // The controller used last, drawn in the footer.
    in property <ControllerArt> controller-art: ControllerArt.generic;
    in property <int> status-network-kind: 0;
    in property <int> status-wifi-strength: 0;
    in property <bool> status-network-limited: false;
    in property <bool> status-battery-visible: false;
    in property <int> status-battery-percent: 0;
    in property <bool> status-battery-charging: false;
    in property <string> clock-time: "";
    in property <string> clock-suffix: "";

    callback select-game(int);
    callback open-library();
    callback library-select(int);
    callback library-cycle-filter();
    callback library-cycle-sort();
    callback library-scroll-rows(int);
    callback library-back();
    callback activity-choose(int);
    callback activity-detail-back();
    callback activate-utility(int);
    // X on a Settings row removes what it sets ("Remove", "Disconnect");
    // its label, or "" where X does nothing (presentation/settings.rs).
    in property <string> settings-secondary-label: "";
    callback settings-remove(int);
    // Its confirmation (presentation/settings.rs).
    in property <bool> settings-confirm-open: false;
    in property <string> settings-confirm-title: "";
    in property <string> settings-confirm-action: "";
    in property <int> settings-confirm-focus: 0;
    callback settings-confirm(int);
    callback settings-activate(int);
    callback settings-back();
    callback settings-save-key(string);
    callback settings-cancel-key();
    callback settings-dismiss-refresh();
    callback settings-request-wayland-paste();
    // Declarations and handlers are separate in Slint 1.18.1.
    callback settings-apply-wayland-paste(string);
    callback settings-activate-editor-target(int);
    settings-activate-editor-target(target) => {
        settings-page.activate-editor-target(target);
    }
    callback settings-paste-failed();
    settings-apply-wayland-paste(text) => {
        settings-page.apply-wayland-paste(text);
    }
    // Reports only OS/window activation changes from the root FocusScope.
    // Internal programmatic/pointer focus changes must not change SDL ownership.
    callback application-active-changed(bool);
    callback raw-key-input(string, bool) -> bool;
    // A clicked hint ("A", "B", "LB", "RB", "Left", "Right"): Rust runs it
    // as that controller button.
    callback hint-activated(string);
    callback raw-key-released(string) -> bool;

    changed settings-editing-key => {
        if (!root.settings-editing-key) { input-scope.focus(); }
        root.text-entry-changed(0, root.settings-editing-key);
    }
    changed profile-editing-name => {
        if (!root.profile-editing-name) { input-scope.focus(); }
        root.text-entry-changed(1, root.profile-editing-name);
    }
    changed shop-searching => {
        if (!root.shop-searching) { input-scope.focus(); }
        root.text-entry-changed(2, root.shop-searching);
    }

    // The on-screen keyboard (presentation/keyboard.rs). Text targets: 0 the
    // Settings key editor, 1 the Profile name editor, 2 the Shop's search.
    in property <bool> keyboard-open: false;
    in property <[KeyboardKeyData]> keyboard-keys;
    in property <int> keyboard-focused: 0;
    in property <int> keyboard-shift: 0;
    // Where the field's caret goes (a byte offset), applied each time
    // `keyboard-edit` changes (a key typed, LB or RB).
    in property <int> keyboard-caret: 0;
    in property <int> keyboard-edit: 0;
    // A key was clicked or tapped; a text editor opened or closed; a field
    // asked for the keyboard (its keyboard button).
    callback keyboard-key(int);
    callback text-entry-changed(int, bool);
    callback keyboard-show(int);
    // How much of the page's bottom the keyboard covers, for dialogs to
    // stay above it.
    private property <length> keyboard-inset: root.keyboard-open
        ? Metrics.footer-height + keyboard.panel-height : 0px;

    design-surface := Rectangle {
        x: 0px;
        y: 0px;
        width: root.logical-width;
        height: root.logical-height;
        background: Theme.background;
        clip: true;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.ui-scale;

        input-scope := FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-click: false;
            focus-on-tab-navigation: false;

            focus-gained(reason) => {
                if (reason == FocusReason.window-activation) {
                    root.application-active-changed(true);
                }
            }

            focus-lost(reason) => {
                if (reason == FocusReason.window-activation) {
                    root.application-active-changed(false);
                }
            }

            key-pressed(event) => {
                if (event.text == Key.F11 && !event.repeat) {
                    root.full-screen = !root.full-screen;
                    accept
                } else if (root.raw-key-input(event.text, event.repeat)) {
                    accept
                } else {
                    reject
                }
            }

            key-released(event) => {
                if (root.raw-key-released(event.text)) { accept } else { reject }
            }

            // Only Home occupies the centre between its persistent chrome.
            // Library and utility pages own the full logical surface.
            // Retaining every route layer preserves the Zoom overlap and local
            // presentation state without moving navigation ownership into Slint.
            TransitionLayer {
                x: 0px;
                rest-y: Metrics.top-chrome-height;
                width: parent.width;
                height: root.shell-content-height;
                active: root.current-route == AppRouteView.home;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.home
                    && root.transition-from-route == AppRouteView.home;

                HomePage {
                    width: parent.width;
                    height: parent.height;
                    games: root.games;
                    from-indices: root.home-from-indices;
                    previous-count: root.home-previous-count;
                    reorder-sequence: root.home-reorder-sequence;
                    reorder-delayed: root.home-reorder-delayed;
                    selected-index: root.selected-index;
                    selected-title: root.selected-title;
                    launching-game-index: root.launching-game-index;
                    launch-feedback-text: root.launch-feedback-text;
                    // A retained outgoing Home page remains visible during the
                    // transition, but it must not regain selection chrome after
                    // route-local focus switches to the destination route.
                    focus-visible: root.current-route == AppRouteView.home
                        && !root.top-utilities-focused;
                    select-game(index) => { root.select-game(index); }
                    open-library => { if (root.current-route == AppRouteView.home) { root.open-library(); } }
                    carousel-geometry-changed(first-game-center-x-px) => {
                        root.home-first-game-center-x-px = first-game-center-x-px;
                    }
                }
            }

            TransitionLayer {
                x: 0px;
                width: parent.width;
                height: parent.height;
                active: root.current-route == AppRouteView.library;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.library
                    && root.transition-from-route == AppRouteView.library;

                LibraryPage {
                    width: parent.width;
                    height: parent.height;
                    cards: root.library-cards;
                    previous-cards: root.library-previous-cards;
                    previous-grid-columns: root.library-previous-grid-columns;
                    previous-scroll-row: root.library-previous-scroll-row;
                    previous-total-count: root.library-previous-total-count;
                    previous-selected-index: root.library-previous-selected-index;
                    has-previous-grid: root.library-has-previous-grid;
                    selected-index: root.library-selected-index;
                    total-count: root.library-total-count;
                    collection-count: root.library-collection-count;
                    browse-sequence: root.library-browse-sequence;
                    filter-text: root.library-filter-text;
                    sort-text: root.library-sort-text;
                    selected-title: root.library-selected-title;
                    selected-source: root.library-selected-source;
                    grid-columns: root.library-grid-columns;
                    scroll-row: root.library-scroll-row;
                    metadata-sequence: root.library-metadata-sequence;
                    focus-visible: root.current-route == AppRouteView.library;
                    choose-card(index) => {
                        if (root.current-route == AppRouteView.library) { root.library-select(index); }
                    }
                    cycle-filter => {
                        if (root.current-route == AppRouteView.library) { root.library-cycle-filter(); }
                    }
                    cycle-sort => {
                        if (root.current-route == AppRouteView.library) { root.library-cycle-sort(); }
                    }
                    scroll-rows(direction) => {
                        if (root.current-route == AppRouteView.library) { root.library-scroll-rows(direction); }
                    }
                }
            }

            // All five top utilities are durable full-shell submenu routes. They
            // share normal Navigator history semantics.
            TransitionLayer {
                x: 0px;
                width: parent.width;
                height: parent.height;
                active: root.current-route == AppRouteView.album;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.album
                    && root.transition-from-route == AppRouteView.album;

                album-page := AlbumPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.current-route == AppRouteView.album;
                    tiles: root.album-tiles;
                    previous-tiles: root.album-previous-tiles;
                    previous-scroll-row: root.album-previous-scroll-row;
                    previous-total-count: root.album-previous-total-count;
                    previous-selected-index: root.album-previous-selected-index;
                    refresh-sequence: root.album-refresh-sequence;
                    total-count: root.album-total-count;
                    collection-count: root.album-collection-count;
                    status: root.album-status;
                    game-text: root.album-game-text;
                    kind-text: root.album-kind-text;
                    selected-index: root.album-selected-index;
                    scroll-row: root.album-scroll-row;
                    visit-revision: root.album-visit-revision;
                    selected-text: root.album-selected-text;
                    viewing: root.album-viewing;
                    viewer-text: root.album-viewer-text;
                    viewer-image: root.album-viewer-image;
                    viewer-has-image: root.album-viewer-has-image;
                    viewer-previous-image: root.album-viewer-previous-image;
                    viewer-previous-has-image: root.album-viewer-previous-has-image;
                    viewer-landing-image: root.album-viewer-landing-image;
                    viewer-landing-has-image: root.album-viewer-landing-has-image;
                    slide-key: root.album-slide-key;
                    slide-direction: root.album-slide-direction;
                    viewer-is-video: root.album-viewer-is-video;
                    viewer-playing: root.album-viewer-playing;
                    viewer-problem: root.album-viewer-problem;
                    overlay-revision: root.album-overlay-revision;
                    selecting: root.album-selecting;
                    can-delete: root.album-can-delete;
                    dialog-open: root.album-dialog-open;
                    dialog-title: root.album-dialog-title;
                    dialog-text: root.album-dialog-text;
                    dialog-focus: root.album-dialog-focus;
                    dialog-choose(choice) => { if (root.current-route == AppRouteView.album) { root.album-dialog-choose(choice); } }
                    video-position-ms: root.album-video-position-ms;
                    video-duration-ms: root.album-video-duration-ms;
                    video-anchor: root.album-video-anchor;
                    video-clock-running: root.album-video-clock-running;
                    video-frame-live: root.album-video-frame-live;
                    video-frame-ms: root.album-video-frame-ms;
                    choose(index) => { if (root.current-route == AppRouteView.album) { root.album-choose(index); } }
                    cycle-game => { if (root.current-route == AppRouteView.album) { root.album-cycle-game(); } }
                    cycle-kind => { if (root.current-route == AppRouteView.album) { root.album-cycle-kind(); } }
                    scroll-rows(rows) => { if (root.current-route == AppRouteView.album) { root.album-scroll-rows(rows); } }
                    step(direction) => { if (root.current-route == AppRouteView.album) { root.album-step(direction); } }
                    toggle-play => { if (root.current-route == AppRouteView.album) { root.album-toggle-play(); } }
                    seek(fraction) => { if (root.current-route == AppRouteView.album) { root.album-seek(fraction); } }
                    close-viewer => { if (root.current-route == AppRouteView.album) { root.album-close-viewer(); } }
                    layout-changed => { root.album-layout-changed(); }
                }
            }

            TransitionLayer {
                x: 0px;
                width: parent.width;
                height: parent.height;
                active: root.current-route == AppRouteView.activity;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.activity
                    && root.transition-from-route == AppRouteView.activity;

                ActivityPage {
                    width: parent.width;
                    height: parent.height;
                    // Historical Activity models remain application-owned but
                    // aren't rendered by this controller-first overview.
                    covers: root.activity-covers;
                    days: root.activity-days;
                    week-total: root.activity-week-total;
                    month-total: root.activity-month-total;
                    recent-achievements: root.activity-recent-achievements;
                    achievement-status: root.activity-achievement-status;
                    selected-index: root.activity-selected-index;
                    pressed-index: root.activity-pressed-index;
                    details-open: root.activity-details-visible;
                    focus-visible: root.current-route == AppRouteView.activity && !root.activity-details-visible;
                    choose-game(index) => {
                        if (root.current-route == AppRouteView.activity) { root.activity-choose(index); }
                    }
                }
                activity-details-page := ActivityGameDetailsPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.activity-details-visible;
                    first-row: root.activity-detail-first-row;
                    model-start: root.activity-detail-model-start;
                    game: root.activity-detail-game;
                    source-name: root.activity-detail-source;
                    last-played: root.activity-detail-last-played;
                    observed-time: root.activity-detail-observed;
                    provider-label: root.activity-detail-provider-label;
                    provider-time: root.activity-detail-provider-time;
                    sessions-summary: root.activity-detail-sessions-summary;
                    longest-session: root.activity-detail-longest;
                    average-session: root.activity-detail-average;
                    rows: root.activity-detail-rows;
                    session-count: root.activity-detail-session-count;
                    scroll-history(direction) => {
                        if (root.current-route == AppRouteView.activity && root.activity-details-visible) {
                            root.activity-detail-scroll(direction);
                        }
                    }
                    back => { root.activity-detail-back(); }
                }
            }

            TransitionLayer {
                x: 0px;
                width: parent.width;
                height: parent.height;
                active: root.current-route == AppRouteView.achievements;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.achievements
                    && root.transition-from-route == AppRouteView.achievements;

                achievements-page := AchievementsPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.current-route == AppRouteView.achievements;
                    game-count: root.achievements-game-count;
                    source-label: root.achievements-source-label;
                    has-source-choice: root.achievements-has-source-choice;
                    selected-game-title: root.achievements-selected-game-title;
                    selected-game-provider: root.achievements-selected-game-provider;
                    selected-game-progress: root.achievements-selected-game-progress;
                    selected-game-fraction: root.achievements-selected-game-fraction;
                    games: root.achievement-games;
                    entries: root.achievement-entries;
                    selected-index: root.achievements-selected-index;
                    visit-revision: root.achievements-visit-revision;
                    catalog-revision: root.achievements-catalog-revision;
                    first-entry: root.achievements-first-entry;
                    viewing-entries: root.achievements-viewing-entries;
                    status: root.achievements-status;
                    loading: root.achievements-loading;
                    choose-game(index) => {
                        if (root.current-route == AppRouteView.achievements) { root.achievements-select(index); }
                    }
                    scroll-entries(delta) => {
                        if (root.current-route == AppRouteView.achievements) { root.achievements-scroll-entries(delta); }
                    }
                    cycle-source(direction) => {
                        if (root.current-route == AppRouteView.achievements) { root.achievements-cycle-source(direction); }
                    }
                    close-details() => {
                        if (root.current-route == AppRouteView.achievements) { root.achievements-back(); }
                    }
                }
            }

            TransitionLayer {
                x: 0px;
                width: parent.width;
                height: parent.height;
                active: root.current-route == AppRouteView.profile;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.profile
                    && root.transition-from-route == AppRouteView.profile;

                profile-page := ProfilePage {
                    width: parent.width;
                    keyboard-inset: root.keyboard-inset;
                    keyboard-caret: root.keyboard-caret;
                    keyboard-edit: root.keyboard-edit;
                    keyboard-show => { root.keyboard-show(1); }
                    height: parent.height;
                    picture: root.profile-picture;
                    has-picture: root.profile-has-picture;
                    monogram: root.profile-monogram;
                    picture-frames: root.profile-picture-frames;
                    playing: root.current-route == AppRouteView.profile;
                    name: root.profile-name;
                    feedback: root.profile-page-feedback;
                    edit-open: root.profile-edit-open;
                    edit-selection: root.profile-edit-selection;
                    has-chosen: root.profile-page-has-chosen;
                    uses-steam: root.profile-page-uses-steam;
                    steam-available: root.profile-page-steam-available;
                    busy: root.profile-page-busy;
                    editing-name: root.profile-editing-name;
                    editor-target: root.profile-editor-target;
                    name-draft <=> root.profile-name-draft;
                    friends: root.profile-friends;
                    friends-state: root.profile-friends-state;
                    friends-count: root.profile-friends-count;
                    friends-summary: root.profile-friends-summary;
                    friends-row: root.profile-friends-row;
                    scroll-friends(rows) => { root.profile-scroll-friends(rows); }
                    edit => { if (root.current-route == AppRouteView.profile) { root.profile-edit(); } }
                    activate-option(row) => { if (root.current-route == AppRouteView.profile) { root.profile-activate-option(row); } }
                    remove-picture => { if (root.current-route == AppRouteView.profile) { root.profile-remove-picture(); } }
                    confirm-open: root.profile-confirm-open;
                    confirm-focus: root.profile-confirm-focus;
                    confirm(choice) => { if (root.current-route == AppRouteView.profile) { root.profile-confirm(choice); } }
                    save-name(name) => { root.profile-save-name(name); }
                    cancel-name => { root.profile-cancel-name(); }
                }
            }

            TransitionLayer {
                x: 0px;
                width: parent.width;
                height: parent.height;
                active: root.current-route == AppRouteView.settings;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.settings
                    && root.transition-from-route == AppRouteView.settings;

                settings-page := SettingsPage {
                    width: parent.width;
                    keyboard-inset: root.keyboard-inset;
                    keyboard-caret: root.keyboard-caret;
                    keyboard-edit: root.keyboard-edit;
                    keyboard-show => { root.keyboard-show(0); }
                    height: parent.height;
                    view: root.settings-view;
                    selection: root.settings-selection;
                    theme-index: root.settings-theme-index;
                    accent-index: root.settings-accent-index;
                    ui-sounds-enabled: root.settings-ui-sounds-enabled;
                    appearance-feedback: root.settings-appearance-feedback;
                    key-present: root.settings-key-present;
                    steam-identity: root.settings-steam-identity;
                    steam-connected: root.settings-steam-connected;
                    steam-saved: root.settings-steam-saved;
                    editor-kind: root.settings-editor-kind;
                    prefer-artwork: root.settings-prefer-artwork;
                    editing-key: root.settings-editing-key;
                    editor-target: root.settings-editor-target;
                    synthetic-key-insertion: root.settings-synthetic-key-insertion;
                    key-draft <=> root.settings-key-draft;
                    feedback: root.settings-feedback;
                    artwork-status: root.settings-artwork-status;
                    refresh-open: root.settings-refresh-open;
                    refresh-running: root.settings-refresh-running;
                    refresh-completed: root.settings-refresh-completed;
                    refresh-total: root.settings-refresh-total;
                    refresh-error: root.settings-refresh-error;
                    dismiss-refresh => { root.settings-dismiss-refresh(); }
                    activate(index) => { root.settings-activate(index); }
                    remove(index) => { root.settings-remove(index); }
                    confirm-open: root.settings-confirm-open;
                    confirm-title: root.settings-confirm-title;
                    confirm-action: root.settings-confirm-action;
                    confirm-focus: root.settings-confirm-focus;
                    confirm(choice) => { root.settings-confirm(choice); }
                    go-back => { root.settings-back(); }
                    save-key(key) => { root.settings-save-key(key); }
                    cancel-key => { root.settings-cancel-key(); }
                    request-wayland-paste => { root.settings-request-wayland-paste(); }
                }
            }

            TransitionLayer {
                x: 0px;
                width: parent.width;
                height: parent.height;
                active: root.current-route == AppRouteView.shop;
                phase: root.route-phase;
                returning: root.route-back;
                outgoing: root.current-route != AppRouteView.shop
                    && root.transition-from-route == AppRouteView.shop;

                shop-page := ShopPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.current-route == AppRouteView.shop;
                    keyboard-inset: root.keyboard-inset;
                    keyboard-caret: root.keyboard-caret;
                    keyboard-edit: root.keyboard-edit;
                    keyboard-show => { root.keyboard-show(2); }
                    apps: root.shop-apps;
                    app-count: root.shop-app-count;
                    selected: root.shop-selected;
                    first-row: root.shop-first-row;
                    visit: root.shop-visit;
                    state: root.shop-state;
                    category: root.shop-category;
                    count: root.shop-count;
                    query <=> root.shop-query;
                    search-focused: root.shop-search-focused;
                    searching: root.shop-searching;
                    catalog-revision: root.shop-catalog-revision;
                    catalog-base: root.shop-catalog-base;
                    details-open: root.shop-details-open;
                    detail-name: root.shop-detail-name;
                    detail-developer: root.shop-detail-developer;
                    detail-summary: root.shop-detail-summary;
                    detail-verified: root.shop-detail-verified;
                    detail-icon: root.shop-detail-icon;
                    detail-has-icon: root.shop-detail-has-icon;
                    detail-description: root.shop-detail-description;
                    detail-state: root.shop-detail-state;
                    shots: root.shop-shots;
                    shot: root.shop-shot;
                    description-row: root.shop-description-row;
                    feedback: root.shop-feedback;
                    choose(index) => { root.shop-choose(index); }
                    cycle-category(direction) => { root.shop-cycle-category(direction); }
                    scroll-rows(rows) => { root.shop-scroll-rows(rows); }
                    search-open => { root.shop-search-open(); }
                    search-edited(text) => { root.shop-search-edited(text); }
                    search-finish => { root.shop-search-finish(); }
                    search-clear => { root.shop-search-clear(); }
                    actions: root.shop-actions;
                    action-focus: root.shop-action-focus;
                    busy-label: root.shop-busy-label;
                    progress: root.shop-progress;
                    confirm-open: root.shop-confirm-open;
                    confirm-focus: root.shop-confirm-focus;
                    activate-action(index) => { root.shop-activate-action(index); }
                    confirm(choice) => { root.shop-confirm(choice); }
                    close-details => { root.shop-close-details(); }
                    step-shot(delta) => { root.shop-step-shot(delta); }
                    scroll-description(rows) => { root.shop-scroll-description(rows); }
                }
            }

            // One hint bar for every full-screen page, at the same position.
            // Display-only: these labels mirror what Rust's input handlers do
            // for the current page state (see NavigationController and the
            // page controllers). Update both together.
            HintBar {
                x: Metrics.page-margin;
                y: parent.height - Metrics.hint-row-center-from-bottom - self.height / 2;
                width: parent.width - Metrics.page-margin * 2;
                height: Metrics.hint-row-height;
                visible: root.current-route != AppRouteView.home;
                z: 3;
                // Appears once the page has zoomed into place. Its opacity is
                // also 0 while hidden on Home, so becoming visible always
                // fades in from 0 (never down from a stale 1 and back up).
                // Dialogs carry their own focusable buttons, so the bar fades
                // out with the page behind the dialog's dimmed backdrop.
                opacity: root.current-route == AppRouteView.home || root.route-phase < 3
                    || (root.current-route == AppRouteView.settings
                        && (root.settings-refresh-open || root.settings-editing-key))
                    || (root.current-route == AppRouteView.album && (root.album-dialog-open
                        || (root.album-viewing && !album-page.overlay-shown))) ? 0.0 : 1.0;
                animate opacity { duration: Motion.page-duration; easing: ease-in-out; }
                hints: root.page-hints;
                interactive: self.opacity > 0.5;
                activated(button) => { root.hint-activated(button); }
                // Album's fullscreen viewer: hints sit on its dark overlay.
                on-dark: root.current-route == AppRouteView.album && root.album-viewing;
            }

            // Above every page and its dialogs, docked over the hint bar's top.
            keyboard := OnScreenKeyboard {
                z: 40;
                area-width: parent.width;
                area-height: parent.height - Metrics.footer-height + 12px;
                open: root.keyboard-open;
                keys: root.keyboard-keys;
                focused: root.keyboard-focused;
                shift: root.keyboard-shift;
                key-activated(index) => { root.keyboard-key(index); }
            }

            // Persistent top chrome lives outside every page. Later Phase 4
            // passes can add focus/activation without duplicating this shell.
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: Metrics.top-chrome-height;
                visible: root.shell-chrome-visible;
                // Above the page layers (z 1-2): a leaving page shrinks to
                // 94% and must not cover the chrome unevenly while it fades.
                z: 3;
                opacity: root.chrome-opacity;
                transform-scale: root.chrome-scale;
                transform-origin: { x: self.width / 2, y: root.height / 2 - self.y };
                // The bar sits on the page in every theme, with no band or
                // divider, as the footer does: the icons float on the page.
                background: Theme.background;
            }

            TopNavigation {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: Metrics.top-chrome-height;
                icon-render-scale: root.ui-scale;
                profile-picture: root.profile-picture;
                profile-has-picture: root.profile-has-picture;
                profile-picture-frames: root.profile-picture-frames;
                profile-playing: root.shell-chrome-visible;
                profile-monogram: root.profile-monogram;
                profile-focused: root.profile-focused;
                profile-activated => { if (root.current-route == AppRouteView.home) { root.profile-open(); } }
                visible: root.shell-chrome-visible;
                // Above the page layers (z 1-2): a leaving page shrinks to
                // 94% and must not cover the chrome unevenly while it fades.
                z: 3;
                opacity: root.chrome-opacity;
                transform-scale: root.chrome-scale;
                transform-origin: { x: self.width / 2, y: root.height / 2 - self.y };
                utility-focus-visible: root.top-utilities-focused;
                focused-utility-index: root.focused-utility-index;
                network-kind: root.status-network-kind;
                wifi-strength: root.status-wifi-strength;
                network-limited: root.status-network-limited;
                battery-visible: root.status-battery-visible;
                battery-percent: root.status-battery-percent;
                battery-charging: root.status-battery-charging;
                utility-activated(index) => { root.activate-utility(index); }
            }

            Footer {
                icon-render-scale: root.ui-scale;
                x: 0px;
                y: parent.height - Metrics.footer-height;
                width: parent.width;
                height: Metrics.footer-height;
                visible: root.shell-chrome-visible;
                // Above the page layers (z 1-2): a leaving page shrinks to
                // 94% and must not cover the chrome unevenly while it fades.
                z: 3;
                opacity: root.chrome-opacity;
                transform-scale: root.chrome-scale;
                transform-origin: { x: self.width / 2, y: root.height / 2 - self.y };
                connected-controller-count: root.connected-controller-count;
                controller-art: root.controller-art;
                clock-time: root.clock-time;
                clock-suffix: root.clock-suffix;
                hint-activated(button) => { root.hint-activated(button); }
            }

        }
    }
}
