import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { GameCardData, CardRect } from "../models/game-card.slint";
import { ModalDialog } from "modal-dialog.slint";
import { FallbackCover } from "fallback-cover.slint";
import { ActionButton } from "action-button.slint";
import { ListRow, Surface } from "list-row.slint";
import { HintBar } from "hint-bar.slint";

// Floating game commands; only Properties opens a larger, centered dialog.
// Rust chooses placement, identity, focus and operations. The page stays visible.
export component GameContextMenu inherits Rectangle {
    in property <bool> open: false;
    in property <length> area-width;
    in property <length> area-height;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <GameCardData> game;
    in property <int> view: 0;
    in property <int> selected: 0;
    in property <bool> hidden-game: false;
    in property <bool> busy: false;
    in property <string> message;
    in property <string> details;
    in property <length> details-offset;
    out property <length> max-details-offset: max(0px, properties.preferred-height - 330px);
    out property <CardRect> popup-rect: { x: popup.x / 1px, y: popup.y / 1px, width: popup.width / 1px, height: popup.height / 1px };
    callback choose(int);
    callback hover-row(int);
    callback back();
    callback scroll(int);
    width: root.area-width; height: root.area-height;
    visible: root.open || popup.opacity > 0.01 || properties-dialog.opacity > 0.01 || error-dialog.opacity > 0.01;
    background: transparent;

    // Dismiss without activating anything on the page behind the menu.
    TouchArea {
        width: parent.width; height: parent.height;
        visible: popup.visible;
        clicked => { root.back(); }
        pointer-event(event) => { if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) { root.back(); } }
    }
    popup := Surface {
        x: root.anchor-x;
        y: root.anchor-y + (root.open && root.view == 0 ? 0px : Motion.dialog-rise / 2);
        width: min(Metrics.game-context-width, root.area-width - Metrics.spacing-xl);
        height: min(root.area-height - Metrics.spacing-xl, Metrics.game-context-height);
        opacity: root.open && root.view == 0 ? 1.0 : 0.0;
        visible: (root.open && root.view == 0) || self.opacity > 0.01;
        animate opacity, y { duration: Motion.dialog-duration; easing: ease-out; }
        background: Theme.surface-raised;
        drop-shadow-color: Theme.shadow.with-alpha(Theme.is-dark ? 0.42 : 0.18);
        drop-shadow-blur: 20px; drop-shadow-offset-y: 5px;
        for label[index] in ["Play", "Game properties", root.hidden-game ? "Unhide game" : "Hide game", "Uninstall game"] : ListRow {
            x: Metrics.spacing-sm;
            y: Metrics.spacing-sm + index * (Metrics.compact-row-height + Metrics.spacing-xs) + (index == 3 ? Metrics.spacing-sm : 0px);
            width: parent.width - Metrics.spacing-md;
            compact: true;
            title: label;
            trailing-width: Metrics.spacing-lg;
            focused: root.selected == index;
            enabled: root.open && !root.busy && root.view == 0;
            hovered => { root.hover-row(index); }
            activated => { root.choose(index); }
        }
        Rectangle { x: Metrics.spacing-md; y: 164px; width: parent.width - Metrics.spacing-xl; height: 1px; background: Theme.divider; }
    }
    error-dialog := ModalDialog {
        area-width: root.area-width; area-height: root.area-height;
        open: root.open && root.view == 3;
        card-height: 232px;
        dismissed => { root.back(); }
        Text {
            x: Metrics.spacing-lg; y: Metrics.spacing-lg;
            width: parent.width - Metrics.spacing-xxl; height: 116px;
            text: root.message; color: Theme.foreground;
            font-size: Typography.body-size; wrap: word-wrap;
        }
        ActionButton {
            x: parent.width - 124px; y: parent.height - 60px; width: 100px; height: 36px;
            label: "Close"; enabled: root.open && root.view == 3;
            activated => { root.back(); }
        }
    }
    properties-dialog := ModalDialog {
        area-width: root.area-width; area-height: root.area-height;
        open: root.open && root.view == 1;
        card-width: 504px; card-height: 582px;
        dismissed => { root.back(); }
    Rectangle {
        x: 24px; y: 24px; width: 64px; height: 64px;
        border-radius: Metrics.radius-md; clip: true;
        FallbackCover { width: parent.width; height: parent.height; typography-scale: 0.32; game: root.game; visible: !root.game.has-artwork; }
        Image { width: parent.width; height: parent.height; source: root.game.artwork; image-fit: cover; visible: root.game.has-artwork; }
    }
    menu-title := Text {
        x: 104px; y: 24px + max(0px, (64px - self.height - 26px) / 2);
        width: parent.width - 128px; height: min(48px, self.preferred-height);
        text: root.game.title; color: Theme.foreground;
        font-size: Typography.body-size; font-weight: Typography.heading-weight;
        wrap: word-wrap; overflow: elide;
    }
    Text {
        x: 104px; y: menu-title.y + menu-title.height + 6px; width: parent.width - 128px; height: 20px;
        text: root.view == 1 ? "Game properties" : root.game.platform;
        color: Theme.secondary-foreground; font-size: Typography.caption-size;
    }
    Rectangle { x: 24px; y: 108px; width: parent.width - 48px; height: 1px; background: Theme.divider; }
    Rectangle {
        x: 28px; y: 128px; width: parent.width - 56px; height: 330px; clip: true;
        properties := Text {
            y: -root.details-offset;
            width: parent.width;
            text: root.details; wrap: word-wrap;
            color: Theme.foreground; font-size: Typography.body-size;
        }
        TouchArea {
            width: parent.width; height: parent.height;
            scroll-event(event) => { if (event.delta-y != 0px) { root.scroll(event.delta-y < 0px ? 1 : -1); return accept; } reject }
        }
    }
        Text {
            x: 28px; y: 466px; width: parent.width - 56px; height: 44px;
            text: root.message;
            color: Theme.secondary-foreground; font-size: Typography.caption-size; wrap: word-wrap;
        }
        HintBar {
            x: 28px; y: parent.height - 48px; width: 260px; height: 22px;
            hints: [{ button: "B", label: "Close" }];
            activated(button) => { root.back(); }
        }
        ActionButton {
            x: parent.width - 124px; y: parent.height - 58px; width: 100px; height: 36px;
            label: "Close"; enabled: root.open && root.view == 1;
            activated => { root.back(); }
        }
    }
}
