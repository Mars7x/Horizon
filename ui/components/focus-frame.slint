import { Metrics, Theme } from "../theme/theme.slint";

// The shared cover/media focus: continuous outline, no glow or idle motion.
// Callers own selection fades and follow their actual animated shell.
export component FocusFrame inherits Rectangle {
    in property <length> shell-radius: Metrics.game-shell-radius;
    background: transparent;
    border-width: Metrics.focus-stroke;
    border-radius: root.shell-radius + Metrics.focus-offset;
    border-color: Theme.focus;
}
