import { Theme, Metrics, Motion } from "../theme/theme.slint";
import { FocusFrame } from "focus-frame.slint";
import { DemoCover } from "demo-cover.slint";
import { GameCardData } from "../models/game-card.slint";

export component GameTile inherits Rectangle {
    in property <GameCardData> game;
    in property <bool> selected: false;
    in property <bool> focus-visible: true;
    in property <int> item-index: 0;
    callback activated(int);

    width: Metrics.game-stride;
    height: Metrics.game-slot-height;
    background: transparent;
    z: root.selected ? 2.0 : 1.0;

    // Render the selected card at its real target dimensions instead of scaling
    // an already-rasterized subtree. This keeps procedural fallback text and
    // shapes crisp at fullscreen/HiDPI sizes. Internal placeholder typography
    // stays at a stable logical size during the transition, avoiding the
    // breathing/re-rasterizing effect from earlier prototypes.
    visual := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.selected
            ? Metrics.game-tile-size * Metrics.game-selected-scale
            : Metrics.game-tile-size;
        height: root.selected
            ? Metrics.game-tile-size * Metrics.game-selected-scale
            : Metrics.game-tile-size;
        background: transparent;

        animate width {
            duration: Motion.focus-duration;
            easing: ease-out;
        }
        animate height {
            duration: Motion.focus-duration;
            easing: ease-out;
        }

        shell := Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.surface-raised;
            border-radius: Metrics.game-shell-radius;
            border-width: Theme.high-contrast ? 2px : 1px;
            border-color: Theme.high-contrast ? Theme.foreground : Theme.divider.with-alpha(0.42);
            drop-shadow-offset-y: root.selected ? 7px : 4px;
            drop-shadow-blur: root.selected ? 20px : 14px;
            drop-shadow-color: Theme.shadow.with-alpha(root.selected ? 0.95 : 0.72);

            DemoCover {
                x: Metrics.game-art-inset;
                y: Metrics.game-art-inset;
                width: parent.width - (Metrics.game-art-inset * 2);
                height: parent.height - (Metrics.game-art-inset * 2);
                game: root.game;
            }
        }

        focus := FocusFrame {
            active: root.selected && root.focus-visible;
            x: -Metrics.focus-offset;
            y: -Metrics.focus-offset;
            width: parent.width + Metrics.focus-offset * 2;
            height: parent.height + Metrics.focus-offset * 2;
            opacity: root.selected && root.focus-visible ? 1 : 0;

            animate opacity {
                duration: Motion.focus-duration;
                easing: ease-out;
            }
        }
    }

    TouchArea {
        clicked => { root.activated(root.item-index); }
    }
}
