import { Motion } from "../theme/theme.slint";
import { Wheel } from "wheel.slint";
import { Momentum } from "momentum.slint";
import { InputResample } from "input-resample.slint";

// One scrolling standard for every vertical list and grid (Library, Album,
// Achievements, Activity history). See docs/UI_STANDARDS.md, "Scrolling".
//
// - The page (or Rust) picks the target: the first whole row in view.
// - `Scroll.camera` turns it into pixels, never past the content's end: at
//   the end, the last row rests on the viewport's bottom edge rather than
//   leaving empty space under it.
// - Every camera animates with `Motion.scroll-duration`, linear, so held
//   input glides at a constant speed, and stays still for one frame after a
//   fresh visit (`CameraSettle`) so a reset jumps instead of scrolling.
// - Scroll-edge shadows read the animated camera through `Scroll.edge`.
export global Scroll {
    // Pixel camera for a target offset, within [0, content - viewport].
    public pure function camera(target: length, content: length, viewport: length) -> length {
        max(0px, min(target, content - viewport))
    }
    // How far content stretches for a touchpad `pull` past its end: it
    // follows at first, then resists, never beyond `overscroll-limit`. None
    // with Reduced Motion.
    out property <length> overscroll-limit: 80px;
    public pure function rubber(pull: length) -> length {
        Motion.reduced-motion ? 0px
            : pull >= 0px ? Scroll.overscroll-limit * pull / (pull + Scroll.overscroll-limit)
            : -Scroll.overscroll-limit * -pull / (-pull + Scroll.overscroll-limit)
    }
    // The pull that stretches content by `stretch`: a new pull that starts
    // while the content is still springing back continues from where it is.
    public pure function unrubber(stretch: length) -> length {
        let s = max(-Scroll.overscroll-limit + 0.5px, min(Scroll.overscroll-limit - 0.5px, stretch));
        s >= 0px ? s * Scroll.overscroll-limit / (Scroll.overscroll-limit - s)
            : s * Scroll.overscroll-limit / (Scroll.overscroll-limit + s)
    }
    // How far `raw` is past `clamped` (a camera held at an end): none within
    // half a pixel. Stored lengths round, so a camera that only reached an
    // end can be a fraction off it, and that must not count as a stretch.
    public pure function past(raw: length, clamped: length) -> length {
        abs(raw - clamped) < 0.5px ? 0px : raw - clamped
    }
    // Shadow strength for `hidden` pixels of content beyond an edge.
    public pure function edge(hidden: length) -> float {
        max(0.0, min(1.0, hidden / 24px))
    }
}

// Changing `key` (a visit, opening a view) makes the next camera change
// instant. `settled` turns false the moment `key` changes (it is derived, so
// no handler runs a frame late) and true again once that change has drawn.
// Use as: `duration: settle.settled ? Motion.scroll-duration : 0ms`.
export component CameraSettle {
    in property <int> key: 0;
    private property <int> settled-key: 0;
    out property <bool> settled: root.settled-key == root.key;
    init => { root.settled-key = root.key; }
    changed key => {
        timer.stop();
        timer.start();
    }
    timer := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            self.stop();
            root.settled-key = root.key;
        }
    }
}

// The camera for a vertical list or grid. It rests wherever it was left, to
// the pixel; nothing snaps it back onto rows.
//
// - Focus (`focus-key` changes, with the focused item at `focus-row`, taking
//   `focus-span` from the top of its row) moves it only when that item isn't
//   fully in view, and then only as far as needed to show it, with the
//   standard glide.
// - `scroll(delta-y)` (from a `scroll-event`) moves it by pixels: a touchpad
//   directly, a wheel notch with the glide. It never moves focus.
// - The owner (Rust, or the page) keeps `rest-row`, the row at the top, for
//   mounting rows near the camera: whenever the camera's top edge moves into
//   another row it says so through `scrolled(rows)`, relative to `rest-row`.
// - The owner can also move the camera itself by setting `rest-row` to a row
//   it wasn't told (Up/Down in a read-only list), or reset it through
//   `settle-key` (a fresh visit: instant, as does `instant`).
// - A touchpad pulling past either end stretches the content (`Scroll.rubber`)
//   and springs back when the fingers lift (`Wheel.touching`); a swipe that
//   was still moving glides on (`Momentum`), reporting rows as it goes. A
//   glide that reaches an end runs into the stretch and springs back.
// - A finger dragging the list (`drag-begin`, `drag-to`, `drag-end`, from the
//   page's swipe handler) moves it the same way, and never moves focus.
export component ScrollCamera {
    in property <int> rest-row: 0;
    in property <length> stride: 1px;
    in property <length> content: 0px;
    in property <length> viewport: 0px;
    in property <int> settle-key: 0;
    in property <int> focus-key: 0;
    // The focused item's row (-1 for none), and how far it reaches from the
    // top of that row, margins included.
    in property <int> focus-row: -1;
    in property <length> focus-span: 0px;
    in property <bool> instant: false;
    callback scrolled(int);

    // Where the camera rests. Until something moves it, it follows the
    // owner's row.
    private property <length> position: Scroll.camera(root.rest-row * root.stride, root.content, root.viewport);
    // The top row last agreed with the owner.
    private property <int> agreed-row: 0;
    private property <int> seen-focus: 0;
    init => {
        root.agreed-row = root.rest-row;
        root.seen-focus = root.focus-key;
        root.glided = root.target;
        root.aimed = root.target;
    }
    // Touchpad input follows directly, without a glide.
    private property <bool> follow: false;
    // Touchpad travel past the content's ends (negative: above the top), and
    // whether the fingers are still moving.
    private property <length> pull: 0px;
    private property <bool> pulling: false;
    private property <length> limit: max(0px, root.content - root.viewport);
    // Where the camera is going.
    out property <length> target: max(0px, min(root.limit, root.position));
    // Where the camera is drawn, before any stretch: on the target while it
    // jumps (a fresh visit, `instant`) or follows a touchpad or finger;
    // otherwise gliding to it (`glided`).
    private property <bool> snap: !settle.settled || root.instant || root.follow
        || Motion.scroll-duration == 0ms;
    private property <length> base: root.snap ? root.target : root.glided;

    // The glide: linear, over `Motion.scroll-duration` from wherever it is
    // when the target changes. It steps every frame by the time since the
    // previous one, rather than as a Slint animation timed from the change:
    // a focus move reaches the camera in a `changed` handler just before the
    // frame is drawn, so an animation started there showed no movement on
    // its first frame, a stall on every step. Retargeted before it ends (held
    // input), it runs at one constant speed.
    private property <length> glided: 0px;
    // The target the speed was set for, and the speed (px per ms).
    private property <length> aimed: 0px;
    private property <float> speed: 0;
    private property <duration> stepped: 0ms;
    private property <bool> moving: root.glided != root.target;
    private property <duration> clock: root.moving ? animation-tick() : 0ms;
    changed clock => { root.step(); }
    function step() {
        let now = animation-tick();
        if !root.moving {
            return;
        }
        // Starting from rest, the first step is half a frame's worth: the
        // change came some time since the last frame, often only noticed now.
        let elapsed = now > root.stepped && now - root.stepped <= 50ms ? now - root.stepped : 8ms;
        root.stepped = now;
        if root.snap {
            root.glided = root.target;
            return;
        }
        if root.aimed != root.target {
            root.aimed = root.target;
            root.speed = abs(root.target - root.glided) / 1px / (Motion.scroll-duration / 1ms);
        }
        let left = root.target - root.glided;
        let travel = min(abs(left), root.speed * (elapsed / 1ms) * 1px);
        root.glided = abs(left) - travel < 0.25px ? root.target
            : root.glided + (left > 0px ? travel : -travel);
    }
    // Moving the camera another way: the glide carries on from where the
    // camera is drawn.
    function hold() {
        root.glided = root.base;
        root.aimed = root.base;
    }
    private property <length> stretch: Scroll.rubber(root.pull);
    // The spring back starts from rest and settles slowly, like a
    // critically damped spring: no jolt when a glide braked into the stretch.
    animate stretch {
        duration: root.pulling ? 0ms : Motion.overscroll-return-duration;
        easing: cubic-bezier(0.3, 0.0, 0.2, 1.0);
    }
    // Where it is, and where to draw it: touchpad and finger movement is
    // drawn where it was 4 ms before each frame, so it moves evenly.
    private property <length> placed: root.base + root.stretch;
    resample := InputResample { value: root.placed; }
    out property <length> camera: resample.shown;

    settle := CameraSettle { key: root.settle-key; }
    function spring-back() {
        release.stop();
        root.pulling = false;
        root.pull = 0px;
    }
    // Fingers lifting ends a swipe: a pull springs back, a moving swipe
    // glides on. The timer only covers a touchpad whose gesture end never
    // arrives (no winit, or a compositor without axis stop).
    private property <bool> fingers-down: Wheel.touching;
    changed fingers-down => {
        if !root.fingers-down && root.pulling {
            let pulled = root.pull != 0px;
            root.spring-back();
            if !pulled {
                momentum.release();
            }
        }
    }
    // A glide moves the camera; past an end it stretches the content instead,
    // braking hard, and springs back once it stops.
    momentum := Momentum {
        glide(travel) => {
            let before = root.placed;
            root.follow = true;
            root.pulling = true;
            let raw = root.target + root.pull + travel;
            root.position = max(0px, min(root.limit, raw));
            root.pull = Scroll.past(raw, root.position);
            if root.pull != 0px {
                momentum.brake();
            }
            resample.mark(before);
            root.report();
        }
        ended => { root.spring-back(); }
    }
    release := Timer {
        interval: 600ms;
        running: false;
        triggered => { root.spring-back(); }
    }

    // Tell the owner which row is now at the top.
    function report() {
        let top = Math.floor(root.target / root.stride);
        root.agreed-row = top;
        if top != root.rest-row {
            root.scrolled(top - root.rest-row);
        }
    }
    // Show the focused item, moving no further than needed.
    function reveal-focus() {
        root.hold();
        momentum.stop();
        root.seen-focus = root.focus-key;
        root.follow = false;
        root.pull = 0px;
        root.position = root.target;
        if root.focus-row >= 0 {
            let top = root.focus-row * root.stride;
            let lowest = top + root.focus-span - root.viewport;
            root.position = min(top, max(lowest, root.position));
        }
        root.report();
    }
    // Go where the owner says.
    function rest-on-row() {
        root.hold();
        momentum.stop();
        root.follow = false;
        root.pull = 0px;
        root.position = Scroll.camera(root.rest-row * root.stride, root.content, root.viewport);
        root.agreed-row = root.rest-row;
    }

    public function scroll(delta-y: length) {
        let before = root.placed;
        root.hold();
        root.follow = !Wheel.is-notch(delta-y);
        root.position = root.target;
        // New input catches a glide (the speed being measured stays).
        if momentum.gliding {
            momentum.stop();
        }
        if root.follow {
            momentum.add(Wheel.distance(delta-y));
            // Past an end, the travel becomes pull rather than movement. A
            // pull that starts while the content springs back takes it from
            // where it is.
            if !root.pulling {
                root.pull = Scroll.unrubber(Scroll.past(root.stretch, 0px));
            }
            let raw = root.position + root.pull + Wheel.distance(delta-y);
            root.position = max(0px, min(root.limit, raw));
            root.pull = Scroll.past(raw, root.position);
            root.pulling = true;
            release.stop();
            release.start();
            resample.mark(before);
        } else {
            // A wheel notch glides. Spun fast, notches would run the
            // destination (which the owner mounts rows around, with three
            // spare rows each side) far ahead of the camera still gliding
            // behind it, showing rows already let go. Keep it within a row of
            // where the camera is drawn.
            root.pull = 0px;
            root.pulling = false;
            let lead = root.stride;
            let next = max(root.base - lead, min(root.base + lead, root.position + Wheel.distance(delta-y)));
            root.position = max(0px, min(root.limit, next));
        }
        root.report();
    }

    // Gliding after a swipe: a touch catches it (`catch`).
    out property <bool> gliding: momentum.gliding;
    // A touch on gliding content stops it where it is, as on a phone (a
    // glide braking into the stretch springs back).
    public function catch() {
        if momentum.gliding {
            momentum.stop();
            if root.pull != 0px {
                root.spring-back();
            } else {
                // Stop where it is drawn (a moment behind the glide).
                root.hold();
                root.position = max(0px, min(root.limit, root.camera));
                resample.stop();
                root.report();
            }
        }
    }

    // A finger drag: the content follows it, stretching past an end, then
    // glides on or springs back.
    private property <bool> dragging: false;
    // The unclamped camera the drag started from, and its last position.
    private property <length> drag-start: 0px;
    private property <length> drag-last: 0px;
    // `moved`: how far the finger already is from where it went down (the
    // swipe is recognised a little way in); the content moves from here, so
    // it doesn't jump by that much.
    public function drag-begin(moved: length) {
        root.hold();
        momentum.stop();
        release.stop();
        root.dragging = true;
        // Take the content from wherever it is drawn (gliding, or springing).
        let drawn = root.camera;
        root.follow = true;
        root.pulling = true;
        root.position = max(0px, min(root.limit, drawn));
        root.pull = Scroll.unrubber(Scroll.past(drawn, root.position));
        root.drag-start = root.position + root.pull + moved;
        root.drag-last = root.position + root.pull;
        root.report();
    }
    // `moved`: how far the finger is from where it went down.
    public function drag-to(moved: length) {
        // The content follows the finger: moving down shows what's above.
        let before = root.placed;
        let raw = root.drag-start - moved;
        momentum.add(raw - root.drag-last);
        root.drag-last = raw;
        root.position = max(0px, min(root.limit, raw));
        root.pull = Scroll.past(raw, root.position);
        resample.mark(before);
        root.report();
    }
    public function drag-end() {
        if root.dragging {
            root.dragging = false;
            let pulled = root.pull != 0px;
            root.spring-back();
            if !pulled {
                momentum.release();
            }
        }
    }

    // Rust publishes focus and the row together; whichever change is seen
    // first, a focus move is handled as one.
    changed focus-key => {
        if root.focus-key != root.seen-focus {
            root.reveal-focus();
        }
    }
    changed rest-row => {
        if root.focus-key != root.seen-focus {
            root.reveal-focus();
        } else if root.rest-row != root.agreed-row {
            root.rest-on-row();
        }
    }
    changed settle-key => {
        root.seen-focus = root.focus-key;
        root.rest-on-row();
    }
}

// A finger (or mouse) dragging the content it wraps scrolls it: Home's
// shelf, and every list and grid. Once the drag is clearly along `vertical`
// (or sideways), it takes the drag from whatever it started on, so a tap
// still selects; the content moves from that point, so it doesn't jump.
// Pass the movement to the camera's `drag-begin`, `drag-to` and `drag-end`,
// and bind `catching` to its `gliding`: while it glides, a touch catches it
// (`caught`) instead of reaching what's beneath. Focus never moves.
export component DragScroll {
    in property <bool> enabled: true;
    in property <bool> vertical: true;
    in property <bool> catching: false;
    callback drag-begin(length);
    callback drag-to(length);
    callback drag-end();
    callback caught();

    swipe := SwipeGestureHandler {
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        handle-swipe-up: root.vertical;
        handle-swipe-down: root.vertical;
        handle-swipe-left: !root.vertical;
        handle-swipe-right: !root.vertical;
        property <bool> dragging: false;
        property <length> travel: root.vertical
            ? self.current-position.y - self.pressed-position.y
            : self.current-position.x - self.pressed-position.x;
        moved => {
            // Slint reports movement before it decides on a swipe too.
            if !self.swiping {
                return;
            }
            if !self.dragging {
                self.dragging = true;
                root.drag-begin(self.travel);
            }
            root.drag-to(self.travel);
        }
        // A touch lands: catch a glide at once (what's beneath only hears of
        // the touch a moment later).
        changed pressed-position => {
            if root.catching {
                root.holding = true;
                root.caught();
            }
        }
        swiped => { swipe.finish(); }
        cancelled => { swipe.finish(); }
        function finish() {
            root.holding = false;
            if self.dragging {
                self.dragging = false;
                root.drag-end();
            }
        }
        @children
        // Over the content while it glides, and for the rest of a touch that
        // caught it: the touch is the catch, not a tap on what's beneath.
        if root.catching || root.holding : TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.holding = true;
                    root.caught();
                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    root.holding = false;
                }
            }
        }
    }
    private property <bool> holding: false;
}
