export component WebIcon inherits Rectangle {
    in property <color> tint: Theme.nav-browser;
    background: transparent;

    // Polished outline derivative of the supplied GNOME Web symbolic globe.
    // The outer ring is slightly stronger than the internal meridians/latitudes
    // so the glyph stays crisp without looking heavy.
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 3.2 12 H 20.8 M 12 3 C 8.7 6.4 8.7 17.6 12 21 M 12 3 C 15.3 6.4 15.3 17.6 12 21 M 4.9 7.6 C 9 9.05 15 9.05 19.1 7.6 M 4.9 16.4 C 9 14.95 15 14.95 19.1 16.4";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.3px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component SettingsIcon inherits Rectangle {
    in property <color> tint: Theme.nav-settings;
    background: transparent;

    // Polished outline derivative of the supplied GNOME Settings symbolic.
    // Eight clear teeth and a larger optical footprint make it read as a gear
    // at the same size as the other utility glyphs.
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 9.17 5.16 L 10.09 3.00 L 13.91 3.00 L 14.83 5.16 L 17.01 4.28 L 19.72 6.99 L 18.84 9.17 L 21.00 10.09 L 21.00 13.91 L 18.84 14.83 L 19.72 17.01 L 17.01 19.72 L 14.83 18.84 L 13.91 21.00 L 10.09 21.00 L 9.17 18.84 L 6.99 19.72 L 4.28 17.01 L 5.16 14.83 L 3.00 13.91 L 3.00 10.09 L 5.16 9.17 L 4.28 6.99 L 6.99 4.28 Z";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.55px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 12 8.55 A 3.45 3.45 0 1 0 12 15.45 A 3.45 3.45 0 1 0 12 8.55";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.55px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

