import { Wheel } from "../components/wheel.slint";
import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { GameCardData } from "../models/game-card.slint";
import { ActivityHistoryRowData } from "../models/activity.slint";
import { FallbackCover } from "../components/fallback-cover.slint";
import { Breadcrumb, ScrollEdgeShadow } from "../components/page-header.slint";
import { MarqueeText } from "../components/marquee-text.slint";
import { TransitionDriver, TransitionLayer } from "../components/transition.slint";
import { Surface } from "../components/list-row.slint";

// Nested Activity detail destination, not a new shell route. The history is
// read-only and scrolls with Up/Down; no session row receives focus.
// Game launch is deliberately not available.
// Horizon-observed and source-reported playtime remain distinct measurements.
// Shared Rise: details rise over the Activity overview and drop on Back.
// Clear above the content so the overview's "Activity" header stays still.
export component ActivityGameDetailsPage inherits TransitionLayer {
    in property <GameCardData> game;
    in property <string> source-name;
    in property <string> last-played;
    in property <string> observed-time;
    in property <string> provider-label;
    in property <string> provider-time;
    in property <string> sessions-summary;
    in property <string> longest-session;
    in property <string> average-session;
    in property <[ActivityHistoryRowData]> rows;
    in property <int> session-count: 0;
    // First history row currently in view (the window is Rust-owned).
    in property <int> first-row: 0;
    callback back();
    callback scroll-history(int);

    opaque: true;
    cover-from: Metrics.page-header-height;
    outgoing: !root.active;
    returning: !root.active;
    phase: details-transition.phase;
    details-transition := TransitionDriver { key: root.active ? 1 : 0; }

    private property <bool> split: root.width >= 1080px && root.height >= 620px;
    private property <length> inset: Metrics.page-margin;
    private property <length> content-width: max(1px, root.width - 2 * root.inset);
    private property <length> cover-size: root.split ? 120px : 90px;
    // Shared frame: page header, breadcrumb, then the game's hero.
    private property <length> hero-y: Metrics.page-header-height + Metrics.breadcrumb-height + Metrics.spacing-sm;
    // Everything below the hero is laid out from its bottom edge.
    private property <length> below-hero: root.hero-y + root.cover-size;
    private property <length> gap: 24px;
    private property <length> summary-width: root.split
        ? min(510px, root.content-width * 0.43) : root.content-width;
    private property <length> history-x: root.split
        ? root.inset + root.summary-width + root.gap : root.inset;
    private property <length> history-width: root.split
        ? max(1px, root.content-width - root.summary-width - root.gap)
        : root.content-width;
    private property <length> history-heading-y: root.below-hero + (root.split ? 24px : 125px);
    private property <length> list-top: root.history-heading-y + 38px;
    private property <length> row-height: root.split ? 70px : 56px;
    private property <length> list-height: max(0px, root.height - root.list-top - Metrics.page-bottom-bar-height);
    out property <int> visible-rows: max(1, Math.floor(
        root.list-height / root.row-height));

    Breadcrumb {
        x: root.inset; y: Metrics.page-header-height;
        width: root.content-width;
        section: "Activity";
        page: root.game.title;
        back => { if (root.active) { root.back(); } }
    }

    // A restrained hero with the exact same rounded cover shell as Library.
    Rectangle {
        x: root.inset; y: root.hero-y;
        width: root.cover-size; height: root.cover-size;
        border-radius: root.cover-size * (20.0 / 148.0);
        background: Theme.surface-raised;
        border-width: Theme.high-contrast ? 2px : 1px;
        border-color: Theme.high-contrast ? Theme.foreground : Theme.divider.with-alpha(0.42);
        drop-shadow-offset-y: 3px;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.shadow.with-alpha(0.62);
        Rectangle {
            x: root.cover-size * 0.085; y: self.x;
            width: root.cover-size - 2 * self.x; height: self.width;
            border-radius: root.cover-size * (12.0 / 148.0);
            clip: true;
            if root.game.has-artwork : Image {
                width: parent.width; height: parent.height;
                source: root.game.artwork;
                image-fit: contain;
                image-rendering: root.game.pixelated-artwork ? pixelated : smooth;
            }
            if !root.game.has-artwork : FallbackCover {
                width: parent.width; height: parent.height;
                game: root.game;
            }
        }
    }
    Rectangle {
        x: root.inset + root.cover-size + 24px;
        y: root.hero-y + (root.split ? 8px : 3px);
        width: max(1px, root.content-width - root.cover-size - 24px);
        height: root.cover-size;
        background: transparent;
        MarqueeText {
            x: 0px; y: 0px;
            width: parent.width; height: root.split ? 47px : 35px;
            text: root.game.title;
            active: root.active;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
        }
        MarqueeText {
            x: 0px; y: root.split ? 52px : 36px;
            width: parent.width; height: 24px;
            text: root.source-name;
            text-color: Theme.secondary-foreground;
            font-size: Typography.body-size;
        }
        MarqueeText {
            x: 0px; y: root.split ? 92px : 66px;
            width: parent.width; height: 22px;
            text: "Last played  " + root.last-played;
            text-color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
        }
    }

    // On wider windows two quiet stat sections balance the tall history list.
    // Compact windows use one compressed read-only summary above the list.
    Text {
        x: root.inset; y: root.below-hero + (root.split ? 24px : 10px);
        width: root.summary-width; height: 29px;
        text: "Playtime";
        color: Theme.foreground;
        font-size: Typography.heading-size;
        font-weight: Typography.heading-weight;
    }
    Surface {
        x: root.inset; y: root.below-hero + (root.split ? 62px : 43px);
        width: root.summary-width; height: root.split ? 124px : 69px;
        Rectangle {
            x: 18px; y: 0px; width: (parent.width - 48px) / 2; height: parent.height;
            background: transparent;
            MarqueeText {
                edge-color: Theme.surface;
                x: 0px; y: root.split ? 21px : 9px;
                width: parent.width; height: 23px;
                text: "Tracked by Horizon";
                text-color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: 0px; y: root.split ? 58px : 32px;
                width: parent.width; height: 32px;
                text: root.observed-time;
                text-color: Theme.foreground;
                font-size: Typography.heading-size;
                font-weight: Typography.heading-weight;
            }
        }
        Rectangle {
            x: parent.width / 2 + 8px;
            width: max(1px, parent.width / 2 - 26px);
            height: parent.height; background: transparent;
            MarqueeText {
                edge-color: Theme.surface;
                x: 0px; y: root.split ? 21px : 9px;
                width: parent.width; height: 23px;
                text: root.provider-label;
                text-color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: 0px; y: root.split ? 58px : 32px;
                width: parent.width; height: 32px;
                text: root.provider-time;
                text-color: Theme.foreground;
                font-size: Typography.heading-size;
                font-weight: Typography.heading-weight;
            }
        }
    }
    if root.split : Text {
        x: root.inset; y: root.below-hero + 211px;
        width: root.summary-width; height: 29px;
        text: "Session summary";
        color: Theme.foreground;
        font-size: Typography.heading-size;
        font-weight: Typography.heading-weight;
    }
    if root.split : Surface {
        x: root.inset; y: root.below-hero + 248px;
        width: root.summary-width; height: 105px;
        Rectangle {
            x: 0px; width: parent.width / 3; height: parent.height;
            background: transparent;
            Text {
                x: 14px; y: 18px; width: parent.width - 28px; height: 23px;
                text: "Recorded"; color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: 14px; y: 50px; width: parent.width - 28px; height: 32px;
                text: root.sessions-summary;
                text-color: Theme.foreground; font-size: Typography.heading-size;
                font-weight: Typography.heading-weight;
            }
        }
        Rectangle {
            x: parent.width / 3; width: parent.width / 3; height: parent.height;
            background: transparent;
            Text {
                x: 14px; y: 18px; width: parent.width - 28px; height: 23px;
                text: "Longest"; color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: 14px; y: 50px; width: parent.width - 28px; height: 32px;
                text: root.longest-session;
                text-color: Theme.foreground; font-size: Typography.heading-size;
                font-weight: Typography.heading-weight;
            }
        }
        Rectangle {
            x: parent.width * 2 / 3; width: parent.width / 3; height: parent.height;
            background: transparent;
            Text {
                x: 14px; y: 18px; width: parent.width - 28px; height: 23px;
                text: "Average"; color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: 14px; y: 50px; width: parent.width - 28px; height: 32px;
                text: root.average-session;
                text-color: Theme.foreground; font-size: Typography.heading-size;
                font-weight: Typography.heading-weight;
            }
        }
    }

    // Read-only history: scroll the bounded visible window with Up/Down.
    // All rows remain available in Rust without mounting every row in Slint.
    Text {
        x: root.history-x; y: root.history-heading-y;
        width: root.history-width * 0.63; height: 30px;
        text: "Session history";
        color: Theme.foreground;
        font-size: Typography.heading-size;
        font-weight: Typography.heading-weight;
    }
    MarqueeText {
        x: root.history-x + root.history-width * 0.64;
        y: root.history-heading-y + 4px;
        width: root.history-width * 0.36; height: 23px;
        text: root.sessions-summary;
        text-color: Theme.secondary-foreground;
        font-size: Typography.caption-size;
        horizontal-alignment: right;
    }
    Rectangle {
        x: root.history-x; y: root.list-top;
        width: root.history-width; height: root.list-height;
        background: transparent;
        clip: true;
        // Pointer wheel pans the read-only session list; it never selects a row.
        TouchArea {
            width: parent.width; height: parent.height;
            enabled: root.active;
            scroll-event(event) => {
                if event.delta-y != 0px {
                    root.scroll-history(Wheel.rows(event.delta-y));
                    return accept;
                }
                reject
            }
        }
        if root.session-count == 0 : Text {
            x: 4px; y: 17px; width: parent.width - 8px;
            text: "No sessions recorded by Horizon yet.";
            color: Theme.secondary-foreground;
            font-size: Typography.body-size;
        }
        // Read-only and unfocusable: the shared surface, no focus ring.
        for record[index] in root.rows : Surface {
            y: index * root.row-height;
            width: parent.width;
            height: root.row-height - Metrics.list-row-gap;
            MarqueeText {
                edge-color: Theme.surface;
                x: 16px; y: root.split ? 9px : 4px;
                width: parent.width * 0.61 - 16px; height: 24px;
                text: record.date;
                text-color: Theme.foreground;
                font-size: Typography.body-size;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: 16px; y: root.split ? 34px : 27px;
                width: parent.width * 0.61 - 16px; height: 22px;
                text: record.times;
                text-color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: parent.width * 0.63;
                y: root.split ? 10px : 5px;
                width: parent.width * 0.33; height: 24px;
                text: record.duration;
                text-color: Theme.foreground;
                font-size: Typography.body-size;
                font-weight: Typography.emphasis-weight;
                horizontal-alignment: right;
            }
            MarqueeText {
                edge-color: Theme.surface;
                x: parent.width * 0.63;
                y: root.split ? 34px : 27px;
                width: parent.width * 0.33; height: 22px;
                text: record.status;
                text-color: Theme.secondary-foreground;
                font-size: Typography.caption-size;
                horizontal-alignment: right;
            }
        }
    }
    // Elevation only while sessions are hidden above or below the window.
    if root.session-count > 0 : ScrollEdgeShadow {
        x: root.history-x; y: root.list-top;
        width: root.history-width;
        strength: root.first-row > 0 ? 1.0 : 0.0;
    }
    if root.active && root.session-count > 0 : ScrollEdgeShadow {
        x: root.history-x; y: root.list-top + root.list-height - self.height;
        width: root.history-width;
        bottom: true;
        strength: root.first-row + root.visible-rows < root.session-count ? 1.0 : 0.0;
    }
}
