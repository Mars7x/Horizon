import { Theme, Motion } from "../theme/theme.slint";

// Horizon's one transition, Zoom, for pages and sub-pages alike.
// Forward: the incoming layer grows in from 0.94 while the outgoing one grows
// past to 1.06 and fades. Back mirrors it: the incoming layer settles from
// 1.06 while the outgoing one shrinks to 0.94 and fades. Section headers
// stay still (sub-page layers are clear above them). Motion.page-duration;
// Reduced Motion makes it instant.
//
// A transition steps through four phases (TransitionDriver.phase):
//   0  prewarm  incoming drawn once at near-zero opacity, so its first slow
//               frame (artwork upload, text layout) happens before timing
//               starts; the outgoing layer stays fully shown
//   1  placed   start scale and opacity, applied without animation
//   2  running  animate to end values
//   3  settled  outgoing layer hidden


export component TransitionDriver {
    // Routes prewarm; in-page sub-views are already drawn and start at 1.
    in property <bool> prewarm: false;
    // What is being shown (a route or a view index). Changing it starts a
    // transition from `from-key`, the last settled value.
    in property <int> key: 0;
    out property <int> from-key: 0;
    private property <int> raw-phase: 3;
    // Derived, not stored: the instant `key` changes this is already the
    // first phase, before any `changed` handler runs. Otherwise one frame
    // would show the new layer fully settled, then jump to its start.
    out property <int> phase: root.key != root.from-key && root.raw-phase == 3
        ? (root.prewarm ? 0 : 1) : root.raw-phase;

    init => { root.from-key = root.key; }
    changed key => {
        timer.stop();
        root.raw-phase = root.prewarm ? 0 : 1;
        timer.interval = 16ms;
        timer.start();
    }

    timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.stop();
            root.raw-phase += 1;
            if root.raw-phase == 2 {
                self.interval = max(1ms, Motion.page-duration);
                self.start();
            } else if root.raw-phase < 2 {
                self.interval = 16ms;
                self.start();
            } else {
                // Settled: this key is now where the next transition starts.
                root.from-key = root.key;
            }
        }
    }
}

export component TransitionLayer inherits Rectangle {
    // This layer is the destination of the current transition.
    in property <bool> active: false;
    // This layer is the source of the current transition.
    in property <bool> outgoing: false;
    // True when returning to a shallower layer (Back): the zoom reverses.
    in property <bool> returning: false;
    in property <int> phase: 3;
    in property <length> rest-y: 0px;
    // Paint Theme.background from this y down, so the incoming layer covers
    // what is under it. Header areas above it stay transparent and still.
    in property <bool> opaque: false;
    in property <length> cover-from: 0px;

    private property <bool> leaving: root.outgoing && !root.active && root.phase < 3;
    private property <float> scale: root.active
        ? (root.phase == 1 ? (root.returning ? 1.06 : 0.94) : 1.0)
        : (root.leaving && root.phase >= 2 ? (root.returning ? 0.94 : 1.06) : 1.0);

    background: transparent;
    y: root.rest-y;
    transform-scale: root.scale;
    opacity: root.active ? (root.phase == 0 ? 0.01 : (root.phase == 1 ? 0.0 : 1.0))
        : (root.leaving ? (root.phase >= 2 ? 0.0 : 1.0) : 0.0);
    visible: root.active || root.leaving;
    // The incoming layer is drawn over the one it replaces.
    z: root.active ? 2 : (root.leaving ? 1 : 0);
    animate opacity, transform-scale {
        duration: root.phase == 2 ? Motion.page-duration : 0ms;
        easing: ease-out;
    }

    if root.opaque : Rectangle {
        y: root.cover-from;
        width: parent.width;
        height: parent.height - root.cover-from;
        background: Theme.background;
    }
    // Pointer input belongs to the active layer only, never to one leaving.
    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.active;
    }

    @children
}
