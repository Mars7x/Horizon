import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { HintData } from "../models/hints.slint";

// Which device's glyphs hints show: the keyboard or the controller family
// used last (Rust's `input::GlyphStyle`, published on change).
export enum GlyphFamily { keyboard, xbox, playstation, nintendo, steam-deck, odin }

export global InputGlyphs {
    in-out property <GlyphFamily> family: GlyphFamily.keyboard;
    // Settings → Controller: controllers confirm with B and go back with A,
    // so confirm hints show B and back hints A. Keys stay Enter and Esc.
    in-out property <bool> swap-confirm: false;
}

// Button glyph in the same style as Home's footer "A": filled foreground
// shape, symbol in the background colour. `button` is the logical button
// ("A" confirm, "B" back, "X" secondary, "LB"/"RB", "+" menu, "L3"/"R3");
// the glyph drawn is that button on the device in use (A/B and X/Y trade
// places on a controller when the face-button preference is enabled): Enter/Esc/Del/Q/E
// key caps, ✕ ○ □ on PlayStation, L1/R1 or L/R shoulders (the Odin 3:
// Nintendo's letters, L1/R1). Face buttons are
// circles, shoulders pills, keys rounded squares. `compact` is the small
// size used beside a header value's label (LB/RB pickers).
export component ButtonGlyph inherits Rectangle {
    in property <string> button;
    in property <bool> on-dark: false;
    in property <bool> compact: false;
    private property <GlyphFamily> family: InputGlyphs.family;
    private property <bool> key: root.family == GlyphFamily.keyboard;
    // The controller button that does it: confirm and back trade places when
    // the user swapped them.
    private property <string> face: root.key || !InputGlyphs.swap-confirm ? root.button
        : root.button == "A" ? "B" : root.button == "B" ? "A"
        : root.button == "X" ? "Y" : root.button == "Y" ? "X" : root.button;
    private property <bool> shoulder: root.button == "LB" || root.button == "RB";
    // PlayStation face buttons are drawn shapes, not letters.
    private property <bool> ps-face: root.family == GlyphFamily.playstation
        && (root.face == "A" || root.face == "B" || root.face == "X" || root.face == "Y");
    private property <string> label:
        root.key ? (root.button == "A" ? "Enter" : root.button == "B" ? "Esc"
            : root.button == "X" ? "Del" : root.button == "LB" ? "Q"
            : root.button == "RB" ? "E" : root.button == "+" ? "F10" : root.button)
        : root.shoulder ? (root.family == GlyphFamily.nintendo ? (root.button == "LB" ? "L" : "R")
            : root.family == GlyphFamily.xbox ? root.button
            : (root.button == "LB" ? "L1" : "R1"))
        : root.ps-face ? ""
        : root.face;
    private property <color> ink: root.on-dark ? black : Theme.background;
    private property <length> mark-stroke: root.compact ? 1.25px : 1.75px;
    width: root.key ? max(root.compact ? 24px : 22px, glyph-text.preferred-width + (root.compact ? 8px : 10px))
        : root.shoulder ? (root.compact ? 24px : root.label.character-count > 1 ? 34px : 28px)
        : root.height;
    height: root.compact ? 16px : 22px;
    border-radius: root.key ? (root.compact ? 3px : 5px) : self.height / 2;
    background: root.on-dark ? white : Theme.foreground;
    glyph-text := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.ink;
        font-family: Typography.family;
        font-size: root.compact ? 9px : (root.label.character-count > 1 ? 11px : 12px);
        font-weight: Typography.emphasis-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // ✕ (confirm)
    if root.ps-face && root.face == "A" : Path {
        width: parent.width; height: parent.height;
        viewbox-width: 22; viewbox-height: 22;
        commands: "M 7.25 7.25 L 14.75 14.75 M 14.75 7.25 L 7.25 14.75";
        stroke: root.ink;
        stroke-width: root.mark-stroke;
    }
    // ○ (back)
    if root.ps-face && root.face == "B" : Path {
        width: parent.width; height: parent.height;
        viewbox-width: 22; viewbox-height: 22;
        commands: "M 11 6.25 A 4.75 4.75 0 1 1 11 15.75 A 4.75 4.75 0 1 1 11 6.25 Z";
        stroke: root.ink;
        stroke-width: root.mark-stroke;
    }
    // □ (secondary)
    if root.ps-face && root.face == "X" : Rectangle {
        width: parent.height * 0.38; height: self.width;
        border-width: root.mark-stroke;
        border-color: root.ink;
    }
    // △
    if root.ps-face && root.face == "Y" : Path {
        width: parent.width; height: parent.height;
        viewbox-width: 22; viewbox-height: 22;
        commands: "M 11 6.25 L 15.75 14.5 L 6.25 14.5 Z";
        stroke: root.ink;
        stroke-width: root.mark-stroke;
    }
}

// Right-aligned controller hints shown in every full-screen page's bottom bar.
// The mapping from page state to hints lives in one place (app.slint).
// Hints are also buttons for pointer users: clicking one sends that button
// (`activated("A")`, …) through the same Rust input path as a controller
// press. A hint pair activates the glyph clicked; its label activates the
// first.
export component HintBar inherits Rectangle {
    in property <[HintData]> hints;
    // Over media (Album's fullscreen viewer): white glyphs and labels.
    in property <bool> on-dark: false;
    // False while the bar is faded out, so invisible hints never take clicks.
    in property <bool> interactive: true;
    callback activated(string);
    background: transparent;
    // Each hint has click padding; the row runs that much past the bar's
    // right edge so the last label still ends exactly at the page margin.
    HorizontalLayout {
        x: 0px;
        width: parent.width + Metrics.spacing-sm;
        alignment: end;
        spacing: Metrics.spacing-sm;
        for hint in root.hints : hint-item := Rectangle {
            border-radius: Metrics.radius-sm;
            background: !hint-touch.has-hover ? transparent
                : root.on-dark ? #ffffff26 : Theme.surface.with-alpha(0.9);
            animate background { duration: Motion.hover-duration; easing: ease-in-out; }
            hint-touch := TouchArea {
                width: parent.width; height: parent.height;
                enabled: root.interactive;
                clicked => { root.activated(hint.button); }
            }
            HorizontalLayout {
                padding-left: Metrics.spacing-sm;
                padding-right: Metrics.spacing-sm;
                spacing: Metrics.spacing-sm;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    ButtonGlyph {
                        button: hint.button;
                        on-dark: root.on-dark;
                    }
                }
                if hint.button2 != "" : VerticalLayout {
                    alignment: center;
                    ButtonGlyph {
                        button: hint.button2;
                        on-dark: root.on-dark;
                        TouchArea {
                            width: parent.width; height: parent.height;
                            enabled: root.interactive;
                            clicked => { root.activated(hint.button2); }
                        }
                    }
                }
                Text {
                    text: hint.label;
                    color: root.on-dark ? #ffffffd9 : Theme.secondary-foreground;
                    // Explicit: Home's footer does not inherit the app font.
                    font-family: Typography.family;
                    font-size: Typography.caption-size;
                    font-weight: Typography.emphasis-weight;
                    vertical-alignment: center;
                }
            }
        }
    }
}
