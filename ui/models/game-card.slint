export struct GameCardData {
    title: string,
    platform: string,
    monogram: string,
    artwork: image,
    has-artwork: bool,
    pixelated-artwork: bool,
    is-playing: bool,
    cover-primary: color,
    cover-secondary: color,
    cover-highlight: color,
}

// Page helpers use logical pixels; the frozen player origin uses viewport fractions.
export struct CardRect { x: float, y: float, width: float, height: float }
