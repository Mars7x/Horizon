import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { GameCardData } from "../models/game-card.slint";
import { ModRow, PropertyRow } from "../models/game-options.slint";
import { ListRow } from "list-row.slint";
import { SettingsRow } from "settings-row.slint";
import { ActionButton } from "action-button.slint";
import { HintBar } from "hint-bar.slint";
import { MarqueeText } from "marquee-text.slint";
import { TransitionDriver, TransitionLayer } from "transition.slint";
import { ScrollEdgeShadow } from "page-header.slint";

// Game options: the quick menu's mirror, a full-height panel at the right
// edge over the dimmed page. One header (the page's caption above the game's
// title), pages that change inside it, the message line and hints at the
// bottom. Rust owns the page, focus and every operation.
//
// Pages: 0 options, 1 properties, 2 uninstall confirmation, 4 save data,
// 5 delete-saves confirmation, 6 mods (3DS).
export component GameContextMenu inherits Rectangle {
    in property <bool> open: false;
    in property <GameCardData> game;
    in property <int> view: 0;
    in property <int> selected: 0;
    in property <bool> hidden-game: false;
    in property <bool> mods-available: false;
    in property <bool> busy: false;
    in property <string> message;
    in property <string> confirm-text;
    in property <[PropertyRow]> properties;
    in property <length> properties-offset;
    in property <[ModRow]> mods;
    in property <length> footer-center: Metrics.hint-row-center-from-bottom;
    out property <length> max-properties-offset: max(0px, facts.preferred-height - root.content-height);
    callback choose(int);
    callback hover-row(int);
    // B: up one page (on the options page, closes).
    callback back();
    // A click beside the panel closes it.
    callback dismiss();
    callback scroll(int);

    private property <float> reveal: root.open ? 1.0 : 0.0;
    animate reveal {
        duration: root.open ? Motion.pause-open-duration : Motion.dialog-duration;
        easing: root.open ? ease-out-quart : ease-out;
    }
    visible: root.reveal > 0.001;
    background: transparent;

    // Rows of the options page: Manage mods only for 3DS games.
    private property <int> mods-row: root.mods-available ? 1 : -1;
    private property <int> properties-row: root.mods-available ? 2 : 1;
    private property <int> hide-row: root.properties-row + 1;
    private property <int> uninstall-row: root.properties-row + 2;
    private property <length> row-step: Metrics.compact-row-height + Metrics.spacing-xs;

    private property <length> content-top: Metrics.spacing-lg * 3 + Metrics.compact-title-height + Metrics.compact-row-height;
    private property <length> content-height: root.height - root.content-top - root.footer-center - Metrics.hint-row-height * 3;
    view-transition := TransitionDriver { key: root.view; prewarm: true; retargetable: true; }
    private property <int> view-phase: Motion.reduced-motion ? 3 : view-transition.phase;
    private property <bool> view-back: root.view-depth(root.view) < root.view-depth(view-transition.from-key);
    pure function view-depth(view: int) -> int { return view == 0 ? 0 : (view == 2 || view == 5 ? 2 : 1); }
    function pick(index: int) {
        if root.open && !root.busy { root.choose(index); }
    }

    // The page behind dims like the game behind the quick menu.
    Rectangle {
        width: parent.width; height: parent.height;
        background: #00000070; opacity: root.reveal;
        TouchArea {
            width: parent.width; height: parent.height;
            enabled: root.open && !root.busy;
            clicked => { root.dismiss(); }
            pointer-event(event) => { if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) { root.dismiss(); } }
        }
    }
    panel := Rectangle {
        width: min(Metrics.pause-panel-width, root.width);
        height: root.height;
        x: root.width - self.width * root.reveal;
        background: Theme.background;
        // Swallow pointer input so nothing behind the panel reacts.
        TouchArea { width: parent.width; height: parent.height; }
        ScrollEdgeShadow {
            x: -self.width;
            width: Metrics.scroll-edge-shadow-height; height: parent.height;
            direction: 270deg; strength: root.reveal;
        }
        Text {
            x: Metrics.spacing-lg; y: Metrics.spacing-lg;
            width: parent.width - Metrics.spacing-lg * 2; height: Metrics.compact-title-height;
            text: root.view == 1 ? "Game properties"
                : root.view == 2 ? "Uninstall game"
                : root.view == 4 ? "Save data"
                : root.view == 5 ? "Delete save data"
                : root.view == 6 ? "Mods"
                : root.game.platform;
            color: Theme.secondary-foreground; font-size: Typography.caption-size;
        }
        MarqueeText {
            active: root.open;
            edge-color: Theme.background;
            x: Metrics.spacing-lg; y: Metrics.spacing-lg + Metrics.compact-title-height;
            width: parent.width - Metrics.spacing-lg * 2; height: Metrics.compact-row-height + Metrics.spacing-md;
            text: root.game.title; text-color: Theme.foreground;
            font-size: Typography.heading-size; font-weight: Typography.heading-weight;
        }
        Rectangle {
            y: root.content-top; width: parent.width; height: root.content-height;
            background: transparent; clip: true;
            // Options.
            TransitionLayer {
                active: root.view == 0; outgoing: view-transition.from-key == 0;
                returning: root.view-back; phase: root.view-phase;
                x: Metrics.spacing-lg; rest-y: 0px;
                width: parent.width - Metrics.spacing-lg * 2; height: root.content-height;
                ListRow {
                    y: 0px; width: parent.width; compact: true;
                    title: "Manage save data"; trailing-width: Metrics.spacing-lg;
                    focused: root.view == 0 && root.selected == 0;
                    enabled: root.open && root.view == 0;
                    hovered => { root.hover-row(0); } activated => { root.pick(0); }
                }
                if root.mods-available : ListRow {
                    y: root.row-step; width: parent.width; compact: true;
                    title: "Manage mods"; trailing-width: Metrics.spacing-lg;
                    focused: root.view == 0 && root.selected == root.mods-row;
                    enabled: root.open && root.view == 0;
                    hovered => { root.hover-row(root.mods-row); } activated => { root.pick(root.mods-row); }
                }
                ListRow {
                    y: root.row-step * root.properties-row; width: parent.width; compact: true;
                    title: "Game properties"; trailing-width: Metrics.spacing-lg;
                    focused: root.view == 0 && root.selected == root.properties-row;
                    enabled: root.open && root.view == 0;
                    hovered => { root.hover-row(root.properties-row); } activated => { root.pick(root.properties-row); }
                }
                ListRow {
                    y: root.row-step * root.hide-row; width: parent.width; compact: true;
                    title: root.hidden-game ? "Unhide game" : "Hide game"; trailing-width: Metrics.spacing-lg;
                    focused: root.view == 0 && root.selected == root.hide-row;
                    enabled: root.open && root.view == 0;
                    hovered => { root.hover-row(root.hide-row); } activated => { root.pick(root.hide-row); }
                }
                // The destructive action sits apart.
                ListRow {
                    y: root.row-step * root.uninstall-row + Metrics.spacing-sm * 2; width: parent.width; compact: true;
                    title: "Uninstall game"; trailing-width: Metrics.spacing-lg;
                    focused: root.view == 0 && root.selected == root.uninstall-row;
                    enabled: root.open && root.view == 0;
                    hovered => { root.hover-row(root.uninstall-row); } activated => { root.pick(root.uninstall-row); }
                }
            }
            // Save data.
            TransitionLayer {
                active: root.view == 4; outgoing: view-transition.from-key == 4;
                returning: root.view-back; phase: root.view-phase;
                x: Metrics.spacing-lg; rest-y: 0px;
                width: parent.width - Metrics.spacing-lg * 2; height: root.content-height;
                for label[index] in ["Open save folder", "Back up save data", "Delete save data"] : ListRow {
                    y: root.row-step * index + (index == 2 ? Metrics.spacing-sm * 2 : 0px);
                    width: parent.width; compact: true; title: label; trailing-width: Metrics.spacing-lg;
                    focused: root.view == 4 && root.selected == index;
                    enabled: root.open && root.view == 4;
                    hovered => { root.hover-row(index); } activated => { root.pick(index); }
                }
            }
            // Mods: each one switches on or off; the folder opens below them.
            TransitionLayer {
                active: root.view == 6; outgoing: view-transition.from-key == 6;
                returning: root.view-back; phase: root.view-phase;
                x: Metrics.spacing-lg; rest-y: 0px;
                width: parent.width - Metrics.spacing-lg * 2; height: root.content-height;
                private property <length> list-height: (root.mods.length + 1) * root.row-step + Metrics.spacing-sm * 2;
                // Rows past the bottom scroll into view with the selection.
                private property <length> scroll: max(0px, min(root.selected * root.row-step + Metrics.compact-row-height + Metrics.spacing-sm * 2 - root.content-height, self.list-height - root.content-height));
                for row[index] in root.mods : SettingsRow {
                    y: root.row-step * index - parent.scroll;
                    animate y { duration: Motion.focus-duration; easing: ease-in-out; }
                    width: parent.width; height: Metrics.compact-row-height;
                    compact: true; title: row.title;
                    toggle: true; compact-toggle: true; checked: row.enabled;
                    focused: root.view == 6 && root.selected == index;
                    enabled: root.open && root.view == 6;
                    activated => { root.pick(index); }
                }
                ListRow {
                    y: root.row-step * root.mods.length + (root.mods.length > 0 ? Metrics.spacing-sm * 2 : 0px) - parent.scroll;
                    animate y { duration: Motion.focus-duration; easing: ease-in-out; }
                    width: parent.width; compact: true; title: "Open mods folder"; trailing-width: Metrics.spacing-lg;
                    focused: root.view == 6 && root.selected == root.mods.length;
                    enabled: root.open && root.view == 6;
                    hovered => { root.hover-row(root.mods.length); } activated => { root.pick(root.mods.length); }
                }
            }
            // Properties: read-only facts, scrolled with Up/Down or the wheel.
            TransitionLayer {
                active: root.view == 1; outgoing: view-transition.from-key == 1;
                returning: root.view-back; phase: root.view-phase;
                x: Metrics.spacing-lg; rest-y: 0px;
                width: parent.width - Metrics.spacing-lg * 2; height: root.content-height;
                clip: true;
                facts := VerticalLayout {
                    y: -root.properties-offset;
                    animate y { duration: Motion.focus-duration; easing: ease-out; }
                    width: parent.width;
                    spacing: Metrics.spacing-md;
                    for fact in root.properties : VerticalLayout {
                        spacing: Metrics.spacing-xs;
                        Text {
                            text: fact.label; color: Theme.secondary-foreground;
                            font-size: Typography.caption-size;
                        }
                        Text {
                            text: fact.value; color: Theme.foreground;
                            font-size: Typography.body-size; wrap: word-wrap;
                        }
                    }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    scroll-event(event) => { if (event.delta-y != 0px) { root.scroll(event.delta-y < 0px ? 1 : -1); return accept; } reject }
                }
            }
            // Confirmations, as in the quick menu: Cancel first and focused.
            for view in [2, 5] : TransitionLayer {
                active: root.view == view; outgoing: view-transition.from-key == view;
                returning: root.view-back; phase: root.view-phase;
                x: Metrics.spacing-lg; rest-y: 0px;
                width: parent.width - Metrics.spacing-lg * 2; height: root.content-height;
                VerticalLayout {
                    y: 0px; width: parent.width;
                    alignment: start; spacing: Metrics.spacing-lg;
                    Text {
                        text: root.confirm-text; wrap: word-wrap;
                        color: Theme.foreground; font-size: Typography.body-size;
                    }
                    ActionButton {
                        height: Metrics.pause-row-height; label: "Cancel";
                        focused: root.view == view && root.selected == 0;
                        enabled: root.open && root.view == view && !root.busy;
                        activated => { root.pick(0); }
                    }
                    ActionButton {
                        height: Metrics.pause-row-height;
                        label: root.busy ? (view == 2 ? "Uninstalling" : "Deleting") : (view == 2 ? "Uninstall" : "Delete save data");
                        focused: root.view == view && root.selected == 1;
                        enabled: root.open && root.view == view && !root.busy;
                        activated => { root.pick(1); }
                    }
                }
            }
        }
        Text {
            x: Metrics.spacing-lg;
            y: parent.height - root.footer-center - Metrics.hint-row-height / 2 - Metrics.spacing-md - Metrics.hint-row-height * 2;
            width: parent.width - Metrics.spacing-lg * 2; height: Metrics.hint-row-height * 2;
            vertical-alignment: bottom;
            text: root.message; wrap: word-wrap; overflow: elide;
            color: Theme.secondary-foreground; font-size: Typography.caption-size;
        }
        HintBar {
            x: Metrics.spacing-lg; y: parent.height - root.footer-center - Metrics.hint-row-height / 2;
            width: parent.width - Metrics.spacing-lg * 2; height: Metrics.hint-row-height;
            hints: root.view == 1
                ? [{ button: "B", label: "Back" }]
                : [{ button: "B", label: root.view == 0 ? "Close" : (root.view == 2 || root.view == 5) ? "Cancel" : "Back" }, { button: "A", label: "Select" }];
            interactive: root.open && !root.busy;
            activated(button) => {
                if button == "B" { root.back(); } else { root.pick(root.selected); }
            }
        }
    }
}
