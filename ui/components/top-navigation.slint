import { Theme, Metrics, Motion } from "../theme/theme.slint";
import { FriendsIcon, AlbumIcon, ActivityIcon, WebIcon, SettingsIcon, ShopIcon } from "utility-icons.slint";

component Separator inherits Rectangle {
    width: 1px;
    height: 30px;
    background: Theme.divider.with-alpha(0.78);
}

component WifiIndicator inherits Rectangle {
    width: 30px;
    height: 28px;
    background: transparent;

    Path {
        x: 1px;
        y: 2px;
        width: 28px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 2 8 C 7 3 17 3 22 8 M 5 12 C 9 8 15 8 19 12 M 8.5 16 C 10.5 14 13.5 14 15.5 16 M 12 20 L 12.01 20";
        fill: transparent;
        stroke: Theme.foreground;
        stroke-width: 2.15px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component BatteryIndicator inherits Rectangle {
    width: 35px;
    height: 24px;
    background: transparent;

    Path {
        x: 0px;
        y: 1px;
        width: 34px;
        height: 22px;
        viewbox-width: 30;
        viewbox-height: 20;
        commands: "M 3 4 H 23 Q 26 4 26 7 V 13 Q 26 16 23 16 H 3 Q 1 16 1 13 V 7 Q 1 4 3 4 M 28 8 V 12";
        fill: transparent;
        stroke: Theme.foreground;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    Rectangle {
        x: 5px;
        y: 8px;
        width: 18px;
        height: 8px;
        border-radius: 2px;
        background: Theme.foreground;
    }
}

component StatusCluster inherits Rectangle {
    width: 113px;
    height: 30px;
    background: transparent;

    Separator {
        x: 0px;
        y: (parent.height - self.height) / 2;
    }

    WifiIndicator {
        x: 28px;
        y: (parent.height - self.height) / 2;
    }

    BatteryIndicator {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
    }
}

component UtilityFocusSurface inherits Rectangle {
    in property <bool> focused: false;
    background: transparent;
    z: root.focused ? 2 : 0;

    // Keep utility focus visually related to the game focus without copying
    // the game's chunky corner-bracket language. The 40x40 cell itself never
    // changes size, so Rust's spatial center geometry remains stable.
    private property <bool> sweep-enabled:
        root.focused && !Motion.reduced-motion && !Theme.high-contrast;
    private property <float> sweep-progress: root.sweep-enabled
        ? mod(animation-tick(), 4000ms) / 4000ms
        : 0;
    private property <angle> sweep-angle: 35deg + root.sweep-progress * 360deg;
    private property <brush> ring-brush: root.sweep-enabled
        ? @linear-gradient(
            root.sweep-angle,
            Theme.focus 0%,
            Theme.focus 28%,
            Theme.focus-highlight 47%,
            Theme.focus-highlight 53%,
            Theme.focus 72%,
            Theme.focus 100%
        )
        : Theme.focus;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2
            + (root.focused && !Motion.reduced-motion ? -2px : 0px);
        width: 48px;
        height: 48px;
        border-radius: 24px;
        opacity: root.focused ? 1 : 0;
        background: Theme.accent-subtle.with-alpha(Theme.is-dark ? 0.40 : 0.58);
        border-width: 2px;
        border-color: root.ring-brush;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.focus.with-alpha(0.16);

        animate y { duration: Motion.focus-duration; easing: ease-out; }
        animate opacity { duration: Motion.focus-duration; easing: ease-out; }
    }
}

export component TopNavigation inherits Rectangle {
    in property <float> icon-render-scale: 1.0;
    in property <bool> utility-focus-visible: false;
    in property <int> focused-utility-index: 2;
    callback utility-activated(int);

    background: transparent;
    private property <length> content-center-y: root.height / 2;

    Rectangle {
        x: Metrics.top-edge-inset;
        y: root.content-center-y - self.height / 2;
        width: 50px;
        height: 50px;
        border-radius: 25px;
        background: @linear-gradient(145deg, Theme.accent 0%, Theme.accent-hover 100%);
        border-width: 3px;
        border-color: Theme.surface-raised;
        drop-shadow-offset-y: 3px;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.shadow;

        Text {
            text: "H";
            color: Theme.accent-foreground;
            font-size: 23px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 7px;
            y: 1px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Theme.accent;
            border-width: 2px;
            border-color: Theme.surface-raised;
        }
    }

    Separator {
        x: Metrics.top-edge-inset + 74px;
        y: root.content-center-y - self.height / 2;
    }

    // The entire utility row is one screen-level focus region. Rust owns which
    // item is focused; these cells only visualize state and emit activation.
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: root.content-center-y - self.height / 2;
        width: Metrics.utility-row-width;
        height: Metrics.utility-cell-size;
        spacing: Metrics.utility-spacing;

        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 0;
            FriendsIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (parent.focused && !Motion.reduced-motion ? -2px : 0px);
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(0); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 1;
            AlbumIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (parent.focused && !Motion.reduced-motion ? -2px : 0px);
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(1); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 2;
            ActivityIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (parent.focused && !Motion.reduced-motion ? -2px : 0px);
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(2); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 3;
            WebIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (parent.focused && !Motion.reduced-motion ? -2px : 0px);
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(3); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 4;
            SettingsIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (parent.focused && !Motion.reduced-motion ? -2px : 0px);
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(4); } }
        }
        UtilityFocusSurface {
            width: 40px; height: 40px;
            focused: root.utility-focus-visible && root.focused-utility-index == 5;
            ShopIcon {
                render-scale: root.icon-render-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (parent.focused && !Motion.reduced-motion ? -2px : 0px);
                width: Metrics.utility-cell-size;
                height: Metrics.utility-cell-size;
                animate y { duration: Motion.focus-duration; easing: ease-out; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.utility-activated(5); } }
        }
    }

    StatusCluster {
        x: parent.width - Metrics.top-edge-inset - self.width;
        y: root.content-center-y - self.height / 2;
    }
}
