import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { PageHeader } from "../components/page-header.slint";
import { HintBar } from "../components/hint-bar.slint";
import { HintData } from "../models/hints.slint";
import { ActionButton } from "../components/action-button.slint";
import { SelectionFocusSurface } from "../components/selection-focus-surface.slint";
import { ProfileAvatar } from "../components/profile-avatar.slint";
import { KeyboardButton } from "../components/on-screen-keyboard.slint";
import { TransitionDriver, TransitionLayer } from "../components/transition.slint";

component SetupProfile inherits Rectangle {
    in property <bool> active;
    in property <bool> busy;
    in property <bool> keyboard-open;
    in property <int> focused;
    in property <int> avatar;
    in property <string> initial;
    in property <string> monogram;
    in property <bool> avatar-changed;
    in property <image> picture;
    in property <bool> has-picture;
    in property <int> keyboard-edit;
    in property <int> keyboard-caret;
    in-out property <string> name-draft;
    callback choose(int);
    callback navigate(int);
    callback name-done();
    callback name-edited();
    callback name-focused();
    callback show-keyboard();
    background: transparent;
    private property <length> heading-y: root.keyboard-open ? 0px : 112px;
    private property <length> field-y: root.heading-y + 66px;

    page-focus := FocusScope {
        width: parent.width; height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        ProfileAvatar {
            x: (parent.width - self.width) / 2; y: 0px;
            size: 80px;
            visible: !root.keyboard-open;
            monogram: root.monogram;
            picture: root.picture;
            has-picture: root.has-picture && !root.avatar-changed;
        }
        Text {
            y: root.heading-y; width: parent.width; height: 48px;
            text: "What should we call you?";
            font-size: Typography.title-size;
            font-weight: Typography.title-weight;
            color: Theme.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            x: (parent.width - self.width) / 2; y: root.field-y;
            width: min(400px, parent.width); height: 52px;
            background: Theme.surface;
            border-radius: Metrics.radius-md;
            border-width: 1px;
            border-color: Theme.divider;
            SelectionFocusSurface {
                x: -3px; y: -3px;
                width: parent.width + 6px; height: parent.height + 6px;
                corner-radius: Metrics.radius-md + 3px;
                focused: root.active && root.focused == 0 && !root.keyboard-open;
                filled: false;
                soft-shadow: false;
            }
            name-input := TextInput {
                x: Metrics.spacing-md;
                width: parent.width - Metrics.spacing-md * 2 - 40px;
                height: parent.height;
                text <=> root.name-draft;
                font-family: Typography.family;
                font-size: Typography.body-size;
                color: Theme.foreground;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.accent-foreground;
                accessible-label: "Your name";
                vertical-alignment: center;
                single-line: true;
                enabled: root.active && !root.busy;
                accepted => { root.name-done(); }
                edited => { root.name-edited(); }
                changed has-focus => { if self.has-focus && root.active { root.name-focused(); } }
                key-pressed(event) => {
                    if event.text == Key.Escape { root.navigate(2); return accept; }
                    if event.text == Key.UpArrow { root.navigate(0); return accept; }
                    if event.text == Key.DownArrow { root.navigate(1); return accept; }
                    reject
                }
            }
            KeyboardButton {
                x: parent.width - self.width - Metrics.spacing-sm;
                y: (parent.height - self.height) / 2;
                visible: root.active && !root.busy;
                activated => { root.show-keyboard(); }
            }
        }
        HorizontalLayout {
            x: (parent.width - self.width) / 2; y: root.field-y + 84px;
            width: 268px; height: 52px;
            spacing: Metrics.spacing-md;
            visible: !root.keyboard-open;
            for avatar-label[index] in [root.initial, "●", "■", "◆"] : ActionButton {
                label: avatar-label;
                accessible-label: index == 0 ? "Initial placeholder" : index == 1 ? "Circle placeholder" : index == 2 ? "Square placeholder" : "Diamond placeholder";
                focused: root.active && root.focused == index + 1;
                primary: root.avatar == index;
                enabled: root.active && !root.busy;
                activated => { root.choose(index + 1); }
            }
        }
    }
    focus-after-opening := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.stop();
            if root.active && root.focused == 0 { name-input.focus(); }
        }
    }
    init => { if root.active { focus-after-opening.start(); } }
    changed active => {
        if root.active { focus-after-opening.start(); }
    }
    changed focused => {
        if root.active {
            if root.focused == 0 { name-input.focus(); }
            else { page-focus.focus(); }
        }
    }
    changed keyboard-edit => {
        if root.active { name-input.set-selection-offsets(root.keyboard-caret, root.keyboard-caret); }
    }
}

component SetupStep inherits Rectangle {
    in property <int> step;
    in property <bool> active;
    in property <bool> busy;
    in property <int> focused;
    in property <int> avatar;
    in property <bool> avatar-changed;
    in property <string> initial;
    in property <string> monogram;
    in property <string> profile-name;
    in property <image> picture;
    in property <bool> has-picture;
    in property <bool> keyboard-open;
    in property <int> keyboard-edit;
    in property <int> keyboard-caret;
    in property <length> keyboard-inset;
    in-out property <string> name-draft;
    callback choose(int);
    callback navigate(int);
    callback name-done();
    callback name-edited();
    callback name-focused();
    callback show-keyboard();
    background: transparent;
    private property <length> available-height: root.height - root.keyboard-inset;
    private property <length> body-height: root.step == 1 ? (root.keyboard-open ? 156px : 360px) : root.step == 0 ? 180px : 230px;
    private property <length> body-y: max(0px, (root.available-height - root.body-height) / 2 - (root.step == 0 ? 0px : Metrics.spacing-lg));

    if root.step == 1 : SetupProfile {
        x: Metrics.page-margin; y: root.body-y;
        width: parent.width - Metrics.page-margin * 2; height: root.body-height;
        active: root.active;
        busy: root.busy;
        focused: root.focused;
        avatar: root.avatar;
        avatar-changed: root.avatar-changed;
        initial: root.initial;
        monogram: root.monogram;
        picture: root.picture;
        has-picture: root.has-picture;
        name-draft <=> root.name-draft;
        keyboard-open: root.keyboard-open;
        keyboard-edit: root.keyboard-edit;
        keyboard-caret: root.keyboard-caret;
        choose(index) => { root.choose(index); }
        navigate(index) => { root.navigate(index); }
        name-done => { root.name-done(); }
        name-edited => { root.name-edited(); }
        name-focused => { root.name-focused(); }
        show-keyboard => { root.show-keyboard(); }
    }
    if root.step != 1 : Rectangle {
        x: Metrics.page-margin; y: root.body-y;
        width: parent.width - Metrics.page-margin * 2; height: root.body-height;
        background: transparent;
        if root.step == 3 : ProfileAvatar {
            x: (parent.width - self.width) / 2; y: -104px;
            size: 80px;
            picture: root.picture;
            has-picture: root.has-picture;
            monogram: root.monogram;
        }
        Text {
            x: 0px; y: 0px;
            width: parent.width; height: 64px;
            text: root.step == 0 ? "Welcome to Horizon" : root.step == 2 ? "Add your games" : "Welcome home, " + root.profile-name;
            font-size: Typography.title-size;
            font-weight: Typography.title-weight;
            color: Theme.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            y: 68px; width: parent.width; height: 56px;
            text: root.step == 0 ? "Make yourself at home." : root.step == 2 ? "Choose a folder, then review your games." : "Your profile is ready. Add games whenever you like.";
            font-size: Typography.body-size;
            color: Theme.secondary-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.step == 0 : ActionButton {
            x: (parent.width - self.width) / 2; y: 144px;
            width: 176px; height: 48px;
            label: "Let’s begin";
            primary: true;
            focused: root.active;
            enabled: root.active && !root.busy;
            activated => { root.choose(0); }
        }
        if root.step == 2 : Text {
            y: 136px; width: parent.width; height: 40px;
            text: "Your files stay where they are.";
            font-size: Typography.caption-size;
            color: Theme.secondary-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.step == 3 : Text {
            y: 136px; width: parent.width; height: 40px;
            text: "Playback will arrive with the first emulator.";
            font-size: Typography.caption-size;
            color: Theme.secondary-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.step != 0 && !root.keyboard-open : Rectangle {
        x: Metrics.page-margin; y: root.height - Metrics.page-bottom-bar-height - 64px;
        width: parent.width - Metrics.page-margin * 2; height: 48px;
        background: transparent;
        ActionButton {
            x: 0px; y: 0px;
            width: 112px; height: parent.height;
            label: "Back";
            focused: root.active && root.focused == (root.step == 1 ? 5 : root.step == 2 ? 2 : 1);
            enabled: root.active && !root.busy;
            activated => { root.choose(root.step == 1 ? 5 : root.step == 2 ? 2 : 1); }
        }
        if root.step == 2 : ActionButton {
            x: parent.width - 348px; width: 168px; height: parent.height;
            label: "Do this later";
            focused: root.active && root.focused == 1;
            enabled: root.active && !root.busy;
            activated => { root.choose(1); }
        }
        ActionButton {
            x: parent.width - self.width; width: 164px; height: parent.height;
            label: root.step == 1 ? "Continue" : root.step == 2 ? "Add games" : "Enter Horizon";
            primary: true;
            focused: root.active && root.focused == (root.step == 1 ? 6 : 0);
            enabled: root.active && !root.busy;
            activated => { root.choose(root.step == 1 ? 6 : 0); }
        }
    }
}

export component OnboardingPage inherits Rectangle {
    in property <bool> open;
    in property <int> step;
    in property <int> focused;
    in property <int> avatar;
    in property <bool> avatar-changed;
    in property <string> initial;
    in property <string> monogram;
    in property <string> profile-name;
    in property <image> picture;
    in property <bool> has-picture;
    in property <bool> busy;
    in property <string> message;
    in property <bool> keyboard-open;
    in property <length> keyboard-inset;
    in property <int> keyboard-edit;
    in property <int> keyboard-caret;
    in property <[HintData]> hints;
    in-out property <string> name-draft;
    callback choose(int);
    callback navigate(int);
    callback name-done();
    callback name-edited();
    callback name-focused();
    callback show-keyboard();
    callback hint-activated(string);
    background: Theme.background;
    visible: root.open;
    // A setup page consumes pointer input before Home underneath it.
    TouchArea { width: parent.width; height: parent.height; }
    header := PageHeader {
        x: 0px; y: 0px;
        width: parent.width; height: Metrics.page-header-height;
        z: 3;
        title: "Horizon";
        opacity: root.step != 0 && !root.keyboard-open ? 1.0 : 0.0;
    }
    transition := TransitionDriver { prewarm: true; key: root.step; }
    for shown in [0, 1, 2, 3] : TransitionLayer {
        width: parent.width; height: parent.height;
        active: root.step == shown;
        outgoing: transition.from-key == shown && root.step != shown;
        returning: root.step < transition.from-key;
        phase: transition.phase;
        SetupStep {
            width: parent.width; height: parent.height;
            step: shown;
            active: root.open && root.step == shown;
            focused: root.focused;
            avatar: root.avatar;
            avatar-changed: root.avatar-changed;
            initial: root.initial;
            monogram: root.monogram;
            profile-name: root.profile-name;
            picture: root.picture;
            has-picture: root.has-picture;
            busy: root.busy;
            keyboard-open: root.keyboard-open;
            keyboard-inset: root.keyboard-inset;
            keyboard-edit: root.keyboard-edit;
            keyboard-caret: root.keyboard-caret;
            name-draft <=> root.name-draft;
            choose(index) => { root.choose(index); }
            navigate(index) => { root.navigate(index); }
            name-done => { root.name-done(); }
            name-edited => { root.name-edited(); }
            name-focused => { root.name-focused(); }
            show-keyboard => { root.show-keyboard(); }
        }
    }
    Text {
        x: Metrics.page-margin; y: parent.height - Metrics.page-bottom-bar-height;
        width: parent.width - Metrics.page-margin * 2; height: 40px;
        text: root.message;
        color: Theme.secondary-foreground;
        font-size: Typography.caption-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.step != 0 && !root.keyboard-open : HintBar {
        x: Metrics.page-margin; y: parent.height - Metrics.page-bottom-bar-height;
        width: parent.width - Metrics.page-margin * 2; height: Metrics.page-bottom-bar-height;
        hints: root.hints;
        activated(button) => { root.hint-activated(button); }
    }
}
