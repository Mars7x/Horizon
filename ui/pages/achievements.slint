import { Wheel } from "../components/wheel.slint";
import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { AchievementGameData, AchievementEntryData } from "../models/achievements.slint";
import { PageHeader, HeaderValue, Breadcrumb, ScrollEdgeShadow } from "../components/page-header.slint";
import { ListRow, Surface, BadgeIcon } from "../components/list-row.slint";
import { MarqueeText } from "../components/marquee-text.slint";
import { TransitionDriver, TransitionLayer } from "../components/transition.slint";

// One full-width games list, then one full-width, read-only achievement list.
// Both views remain mounted; opening a game zooms between them.
// Lists run between the shared page header and the bottom bar.
export component AchievementsPage inherits Rectangle {
    in property <[AchievementGameData]> games;
    in property <[AchievementEntryData]> entries;
    in property <int> selected-index: 0;
    in property <int> visit-revision: 0;
    in property <int> catalog-revision: 0;
    private property <int> previous-catalog-count: 0;
    private property <int> displayed-catalog-count: 0;
    private property <duration> catalog-arrival-at: 0ms;
    changed catalog-revision => {
        root.previous-catalog-count = root.displayed-catalog-count;
        root.displayed-catalog-count = root.games.length;
        root.catalog-arrival-at = animation-tick();
    }
    in property <int> first-entry: 0;
    in property <bool> viewing-entries: false;
    in property <string> game-count: "0 games";
    in property <string> selected-game-title: "Select a game";
    in property <string> selected-game-provider: "";
    in property <string> selected-game-progress: "";
    in property <float> selected-game-fraction: 0.0;
    in property <string> source-label: "All sources";
    in property <bool> has-source-choice: false;
    in property <string> status: "Connect an account in Third-Party settings.";
    in property <bool> loading: false;
    // False while this page is fading out: bottom-bar chrome (the bottom
    // shadows) switches with the route like the hint bar.
    in property <bool> active: true;
    callback choose-game(int);
    callback scroll-entries(int);
    callback cycle-source(int);
    callback close-details();
    background: Theme.background;

    private property <length> margin: Metrics.page-margin;
    private property <bool> narrow: root.width < 760px;
    private property <length> row-stride: Metrics.list-row-height + Metrics.list-row-gap;
    private property <length> entry-stride: Metrics.list-row-height + Metrics.list-row-gap;
    private property <length> list-bottom: root.height - Metrics.page-bottom-bar-height;
    private property <length> game-top: Metrics.page-header-height;
    // Breadcrumb, then the game's own heading, then its achievements.
    private property <length> detail-heading-y: Metrics.page-header-height + Metrics.breadcrumb-height + Metrics.spacing-sm;
    private property <length> detail-top: root.detail-heading-y + 64px;
    private property <length> game-viewport-height: max(0px, root.list-bottom - root.game-top);
    private property <length> detail-viewport-height: max(0px, root.list-bottom - root.detail-top);
    private property <int> visible-games: max(1, Math.floor((root.game-viewport-height + Metrics.list-row-gap) / root.row-stride));
    out property <int> visible-entries: max(1, Math.floor((root.detail-viewport-height + Metrics.list-row-gap) / root.entry-stride));

    // Remember the viewport, not merely the selected index. Otherwise moving
    // UP after scrolling down can leave the focused game offscreen entirely.
    private property <int> first-game: 0;
    // A fresh visit jumps straight to the top. `settled-visit` lags
    // `visit-revision` until the reset has been drawn, so every camera change
    // the reset causes (here or in the selection handler, in whichever order
    // Slint runs them) has zero duration. Slint reads an animation's duration
    // when the animated value is next evaluated (at draw time), so settling
    // waits a frame rather than happening in this handler.
    private property <int> settled-visit: 0;
    changed visit-revision => {
        root.first-game = 0;
        camera-settle.stop();
        camera-settle.start();
    }
    camera-settle := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            self.stop();
            root.settled-visit = root.visit-revision;
        }
    }
    // Keep a wheel-panned camera in bounds when the catalog shrinks.
    changed games => {
        root.first-game = min(root.first-game,
            max(0, root.games.length - root.visible-games));
    }
    // Mouse wheel pans the camera only; selection and controller focus stay put.
    function pan-games(delta: int) {
        root.first-game = max(0, min(root.games.length - root.visible-games, root.first-game + delta));
    }
    changed selected-index => {
        if (root.selected-index < root.first-game) {
            root.first-game = max(0, root.selected-index);
        } else if (root.selected-index >= root.first-game + root.visible-games) {
            root.first-game = root.selected-index - root.visible-games + 1;
        }
    }
    changed visible-games => {
        if (root.selected-index < root.first-game) {
            root.first-game = max(0, root.selected-index);
        } else if (root.selected-index >= root.first-game + root.visible-games) {
            root.first-game = root.selected-index - root.visible-games + 1;
        }
    }
    private property <length> game-camera: root.first-game * root.row-stride;
    private property <length> entry-camera: root.first-entry * root.entry-stride;
    // Linear, just under the 115ms held-input repeat: steps join smoothly.
    animate game-camera, entry-camera {
        duration: root.settled-visit == root.visit-revision ? Motion.list-camera-duration : 0ms;
        easing: linear;
    }

    private property <float> detail-reveal: root.viewing-entries ? 1.0 : 0.0;
    animate detail-reveal { duration: Motion.page-duration; easing: ease-out; }

    PageHeader {
        width: parent.width;
        title: "Achievements";
        HorizontalLayout {
            width: 130px + 190px + Metrics.spacing-sm;
            x: parent.width - Metrics.page-margin - self.width + Metrics.spacing-sm + 2px;
            y: Metrics.page-accessory-y;
            height: Metrics.page-accessory-height;
            spacing: Metrics.spacing-sm;
            // Both describe the games list; they step aside in a game's view.
            HeaderValue {
                width: 130px; label: "Collection"; value: root.game-count;
                opacity: 1.0 - root.detail-reveal;
            }
            HeaderValue {
                width: 190px; label: "Source"; value: root.source-label;
                interactive: root.has-source-choice && !root.viewing-entries;
                opacity: 1.0 - root.detail-reveal;
                clicked => { root.cycle-source(1); }
            }
        }
    }

    // Shared Zoom: opening a game's achievements zooms in; Back zooms out.
    // The header above stays still (layers are clear above it).
    view-transition := TransitionDriver { key: root.viewing-entries ? 1 : 0; }

    games-view := TransitionLayer {
        width: root.width; height: root.height;
        opaque: true;
        cover-from: Metrics.page-header-height;
        active: !root.viewing-entries;
        outgoing: root.viewing-entries;
        returning: !root.viewing-entries;
        phase: view-transition.phase;

        game-viewport := Rectangle {
            x: root.margin; y: root.game-top;
            width: root.width - root.margin * 2;
            height: root.game-viewport-height;
            background: transparent; clip: true;
            TouchArea {
                width: parent.width; height: parent.height;
                enabled: !root.viewing-entries;
                scroll-event(event) => {
                    if event.delta-y != 0px {
                        root.pan-games(Wheel.rows(event.delta-y));
                        return accept;
                    }
                    reject
                }
            }
            for game[i] in root.games : ListRow {
                private property <float> entrance: Motion.reduced-motion || i < root.previous-catalog-count
                    ? 1.0 : min(1.0, max(0.0, (animation-tick() - root.catalog-arrival-at) / 195ms));
                opacity: self.entrance;
                x: 1px + (1.0 - self.entrance) * 8px;
                y: i * root.row-stride - root.game-camera + 2px;
                width: parent.width - 2px - (1.0 - self.entrance) * 8px;
                // Culling follows the ANIMATED camera, not the target index:
                // never disappear while a rapid key/analog sequence is panning.
                visible: i * root.row-stride >= root.game-camera - 4 * root.row-stride
                    && i * root.row-stride <= root.game-camera + root.game-viewport-height + 4 * root.row-stride;
                title: game.title;
                subtitle: game.provider;
                focused: root.selected-index == i;
                enabled: !root.viewing-entries;
                trailing-width: root.narrow ? 175px : 300px;
                activated => { root.choose-game(i); }
                wheel(rows) => { root.pan-games(rows); }

                Text {
                    x: parent.width - (root.narrow ? 158px : 273px); y: 12px;
                    width: root.narrow ? 119px : 231px; height: 29px;
                    text: root.narrow ? game.compact-progress : game.progress;
                    color: Theme.foreground; font-size: Typography.body-size;
                    font-weight: Typography.emphasis-weight;
                    horizontal-alignment: right; vertical-alignment: center;
                }
                Rectangle {
                    x: parent.width - (root.narrow ? 153px : 233px); y: 52px;
                    width: root.narrow ? 112px : 192px;
                    height: 4px; border-radius: 2px;
                    background: Theme.divider.with-alpha(0.76);
                    Rectangle {
                        x: 0px; y: 0px; height: parent.height;
                        width: parent.width * max(0.0, min(1.0, game.fraction));
                        border-radius: 2px; background: Theme.accent;
                        animate width { duration: Motion.carousel-duration; easing: ease-in-out; }
                    }
                }
                Text {
                    x: parent.width - 28px; y: 0px; height: parent.height;
                    text: "›"; color: Theme.secondary-foreground;
                    font-size: Typography.heading-size;
                    vertical-alignment: center;
                }
            }
            if root.games.length == 0 : Text {
                x: 0px; y: Metrics.spacing-lg; width: parent.width;
                text: root.loading ? "Retrieving achievements…" : root.status;
                color: Theme.secondary-foreground; font-size: Typography.body-size;
                wrap: word-wrap;
            }
        }
        if root.games.length > 0 : ScrollEdgeShadow {
            x: 0px; y: root.game-top; width: root.width;
            strength: root.game-camera / root.row-stride;
        }
        if root.active && root.games.length > 0 : ScrollEdgeShadow {
            x: 0px; y: root.list-bottom - self.height; width: root.width;
            bottom: true;
            strength: (root.games.length * root.row-stride - Metrics.list-row-gap
                - root.game-camera - root.game-viewport-height) / root.row-stride;
        }
    }

    details-view := TransitionLayer {
        width: root.width; height: root.height;
        opaque: true;
        cover-from: Metrics.page-header-height;
        active: root.viewing-entries;
        outgoing: !root.viewing-entries;
        returning: !root.viewing-entries;
        phase: view-transition.phase;
        Breadcrumb {
            x: root.margin; y: Metrics.page-header-height;
            width: root.width - root.margin * 2;
            section: "Achievements";
            page: root.selected-game-title;
            back => { if (root.viewing-entries) { root.close-details(); } }
        }
        MarqueeText {
            x: root.margin; y: root.detail-heading-y;
            width: max(100px, root.width - root.margin * 2 - 240px);
            height: 36px;
            text: root.selected-game-title;
            active: root.viewing-entries;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
        }
        Text {
            x: root.margin; y: root.detail-heading-y + 36px;
            height: 22px;
            text: root.selected-game-provider;
            color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
            vertical-alignment: center;
        }
        Text {
            x: root.width - root.margin - 232px; y: root.detail-heading-y;
            width: 232px; height: 36px; horizontal-alignment: right;
            text: root.selected-game-progress;
            color: Theme.foreground; font-size: Typography.body-size;
            font-weight: Typography.emphasis-weight;
            vertical-alignment: center;
        }
        entry-viewport := Rectangle {
            x: root.margin; y: root.detail-top;
            width: root.width - root.margin * 2;
            height: root.detail-viewport-height;
            background: transparent; clip: true;
            TouchArea {
                width: parent.width; height: parent.height;
                enabled: root.viewing-entries;
                scroll-event(event) => {
                    if event.delta-y != 0px {
                        root.scroll-entries(Wheel.rows(event.delta-y));
                        return accept;
                    }
                    reject
                }
            }
            // Read-only and unfocusable: the shared surface, no focus ring.
            for achievement[i] in root.entries : Surface {
                x: 1px; y: i * root.entry-stride - root.entry-camera + 2px;
                width: parent.width - 2px; height: Metrics.list-row-height;
                visible: i * root.entry-stride >= root.entry-camera - 4 * root.entry-stride
                    && i * root.entry-stride <= root.entry-camera + root.detail-viewport-height + 4 * root.entry-stride;
                BadgeIcon {
                    x: 11px; y: 11px; width: 58px; height: 58px;
                    badge: achievement.badge;
                    has-badge: achievement.has-badge;
                    unlocked: achievement.unlocked;
                }
                MarqueeText {
                    x: 87px; y: 6px; width: parent.width - 106px; height: 25px;
                    text: achievement.title;
                    edge-color: Theme.surface;
                    font-weight: Typography.emphasis-weight;
                }
                MarqueeText {
                    x: 87px; y: 30px; width: parent.width - 106px; height: 22px;
                    text: achievement.description != "" ? achievement.description : achievement.when;
                    edge-color: Theme.surface;
                    text-color: Theme.secondary-foreground;
                    font-size: Typography.caption-size;
                }
                MarqueeText {
                    x: 87px; y: 52px; width: parent.width - 106px; height: 22px;
                    text: achievement.description != "" ? achievement.when : "";
                    edge-color: Theme.surface;
                    text-color: Theme.secondary-foreground;
                    font-size: Typography.caption-size;
                }
            }
            if root.entries.length == 0 : Text {
                x: 0px; y: Metrics.spacing-lg; width: parent.width;
                text: "No achievement details are available for this game.";
                color: Theme.secondary-foreground; font-size: Typography.body-size;
            }
        }
        if root.entries.length > 0 : ScrollEdgeShadow {
            x: 0px; y: root.detail-top; width: root.width;
            strength: root.entry-camera / root.entry-stride;
        }
        if root.active && root.entries.length > 0 : ScrollEdgeShadow {
            x: 0px; y: root.list-bottom - self.height; width: root.width;
            bottom: true;
            strength: (root.entries.length * root.entry-stride - Metrics.list-row-gap
                - root.entry-camera - root.detail-viewport-height) / root.entry-stride;
        }
    }
}
