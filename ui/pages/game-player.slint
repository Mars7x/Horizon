import { SaveStateRow } from "../models/save-state.slint";
import { PausePanel } from "../components/pause-panel.slint";
import { CardRect } from "../models/game-card.slint";
import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { ActionButton } from "../components/action-button.slint";
import { ModalDialog } from "../components/modal-dialog.slint";

export component GamePlayer inherits Rectangle {
    in property <bool> open;
    in property <int> phase;
    in property <CardRect> origin;
    out property <float> progress: root.phase == 1 || root.phase == 2 ? 1.0 : 0.0;
    animate progress {
        duration: root.phase == 1 || root.phase == 3 ? Motion.player-zoom-duration : 0ms;
        easing: root.phase == 3 ? ease-in-out : ease-out-back;
    }
    in property <bool> paused;
    in property <bool> frozen;
    out property <float> picture-opacity: root.phase == 3
        ? max(0.0, min(1.0, root.progress / Motion.player-card-blend-window)) : 1.0;
    in property <image> screenshot-preview;
    in property <bool> screenshot-visible: false;
    in property <int> screenshot-sequence: 0;
    in property <int> speed: 1;
    in property <bool> speed-forward: true;
    in property <int> state-mode;
    in property <int> state-focus;
    in property <[SaveStateRow]> state-rows;
    callback state-choose(int);
    in property <bool> restart-confirm;
    in property <int> restart-focus;
    callback restart-answer(int);
    private property <float> pause-reveal: root.paused && !root.failed && root.phase == 2 ? 1.0 : 0.0;
    animate pause-reveal {
        duration: root.paused ? Motion.pause-open-duration : Motion.dialog-duration;
        easing: root.paused ? ease-out-quart : ease-out;
    }
    in property <bool> busy;
    in property <bool> failed;
    in property <bool> has-frame;
    in property <bool> smooth;
    // Nonzero: the frame is already the screen's size; show it 1:1 when
    // fully open, without resampling. Otherwise fit it.
    in property <int> exact-width;
    in property <int> exact-height;
    // The shell's scale: the player sits on a design surface scaled to the
    // window, so one screen pixel is 1phx / screen-scale here.
    in property <float> screen-scale: 1.0;
    private property <length> screen-pixel: 1phx / max(root.screen-scale, 0.01);
    private property <length> exact-w: root.exact-width * root.screen-pixel;
    private property <length> exact-h: root.exact-height * root.screen-pixel;
    in property <image> frame;
    // While the game loads: the picture of the state it resumes (if any),
    // shown dimmed under a spinner until the first real frame.
    in property <image> loading-frame;
    in property <bool> loading-picture;
    private property <bool> live: root.has-frame;
    private property <float> loading-veil: root.open && !root.live && !root.failed ? 1.0 : 0.0;
    animate loading-veil { duration: Motion.reduced-motion ? 0ms : 200ms; easing: ease-out; }
    in property <string> title;
    in property <string> message;
    in property <int> focused;
    callback choose(int);
    callback touch(float, float, bool);
    // A DS game: the frame holds the top screen above the bottom one, each
    // `*-clip` pixels; `ds-top`/`ds-bottom` place them as fractions of the
    // player area. Changes (a swap, a new layout) animate.
    in property <bool> ds;
    in property <string> ds-layout;
    in property <bool> ds-layout-forward: true;
    in property <CardRect> ds-top;
    in property <CardRect> ds-bottom;
    in property <int> ds-top-clip-width;
    in property <int> ds-top-clip-height;
    in property <int> ds-bottom-clip-width;
    in property <int> ds-bottom-clip-height;
    private property <float> top-x: root.ds-top.x;
    private property <float> top-y: root.ds-top.y;
    private property <float> top-w: root.ds-top.width;
    private property <float> top-h: root.ds-top.height;
    private property <float> bottom-x: root.ds-bottom.x;
    private property <float> bottom-y: root.ds-bottom.y;
    private property <float> bottom-w: root.ds-bottom.width;
    private property <float> bottom-h: root.ds-bottom.height;
    animate top-x, top-y, top-w, top-h, bottom-x, bottom-y, bottom-w, bottom-h {
        duration: Motion.ds-swap-duration; easing: ease-in-out;
    }
    visible: root.open;
    background: transparent;
    TouchArea {width:parent.width;height:parent.height;}
    Rectangle {
        width: parent.width; height: parent.height;
        background: #000;
        opacity: max(0.0, min(1.0, root.progress));
    }
    Rectangle {
        x: root.origin.x * root.width * (1.0 - root.progress);
        y: root.origin.y * root.height * (1.0 - root.progress);
        width: root.width * (root.origin.width + (1.0 - root.origin.width) * root.progress);
        height: root.height * (root.origin.height + (1.0 - root.origin.height) * root.progress);
        // Upload the first frame during the card press, before the zoom clock.
        opacity: root.phase == 0 ? (root.has-frame || root.loading-picture ? 0.01 : 0.0) : root.picture-opacity;
        background: #000;
        border-radius: Metrics.game-shell-radius * (1.0 - max(0.0, min(1.0, root.progress)));
        clip: true;
        // DS: each screen cut from the frame and placed by the layout, on
        // whole screen pixels. The bottom screen takes touch.
        if root.ds : Image {
            x: round(parent.width * root.top-x / root.screen-pixel) * root.screen-pixel;
            y: round(parent.height * root.top-y / root.screen-pixel) * root.screen-pixel;
            width: round(parent.width * root.top-w / root.screen-pixel) * root.screen-pixel;
            height: round(parent.height * root.top-h / root.screen-pixel) * root.screen-pixel;
            source: root.frame;
            source-clip-x: 0; source-clip-y: 0;
            source-clip-width: root.ds-top-clip-width; source-clip-height: root.ds-top-clip-height;
            visible: root.live;
            image-fit: fill;
            image-rendering: root.smooth ? ImageRendering.smooth : ImageRendering.pixelated;
        }
        if root.ds : Image {
            x: round(parent.width * root.bottom-x / root.screen-pixel) * root.screen-pixel;
            y: round(parent.height * root.bottom-y / root.screen-pixel) * root.screen-pixel;
            width: round(parent.width * root.bottom-w / root.screen-pixel) * root.screen-pixel;
            height: round(parent.height * root.bottom-h / root.screen-pixel) * root.screen-pixel;
            source: root.frame;
            source-clip-x: 0; source-clip-y: root.ds-top-clip-height;
            source-clip-width: root.ds-bottom-clip-width; source-clip-height: root.ds-bottom-clip-height;
            visible: root.live;
            image-fit: fill;
            image-rendering: root.smooth ? ImageRendering.smooth : ImageRendering.pixelated;
            // melonDS takes touch in its own stacked frame: the bottom half.
            TouchArea {
                enabled: root.phase == 2 && !root.paused && !root.busy && !root.failed;
                moved => { root.touch(self.mouse-x / self.width, 0.5 + 0.5 * self.mouse-y / self.height, self.pressed); }
                pointer-event(event) => {
                    if event.button == PointerEventButton.left {
                        root.touch(self.mouse-x / self.width, 0.5 + 0.5 * self.mouse-y / self.height, event.kind == PointerEventKind.down);
                    } else if event.kind == PointerEventKind.cancel {
                        root.touch(0, 0, false);
                    }
                }
            }
        }
        picture := Image {
            private property <bool> exact: root.live && root.exact-width > 0 && root.exact-height > 0;
            // Grows with the zoom like a fitted picture, ending at the exact
            // size on whole physical pixels.
            private property <float> grow: self.exact
                ? min(parent.width / root.exact-w, parent.height / root.exact-h)
                    / min(root.width / root.exact-w, root.height / root.exact-h)
                : 1.0;
            width: self.exact ? root.exact-w * self.grow : parent.width;
            height: self.exact ? root.exact-h * self.grow : parent.height;
            x: self.exact ? round((parent.width - self.width) / 2 / root.screen-pixel) * root.screen-pixel : 0px;
            y: self.exact ? round((parent.height - self.height) / 2 / root.screen-pixel) * root.screen-pixel : 0px;
            source: root.frame;
            visible: root.live && !root.ds;
            image-fit: self.exact ? ImageFit.fill : ImageFit.contain;
            // 1:1 when open; during the card zoom it is shrunk, so smooth.
            image-rendering: self.exact
                ? (root.progress >= 1.0 ? ImageRendering.pixelated : ImageRendering.smooth)
                : (root.smooth ? ImageRendering.smooth : ImageRendering.pixelated);
        }
        // Loading: the resumed state's picture, blurred and dimmed (or
        // black), with a spinner. It's a layer of its own above the game, so
        // the first real frame appears beneath it and the whole layer fades:
        // a crossfade, with nothing switching underneath.
        Rectangle {
            width: parent.width; height: parent.height;
            visible: root.loading-veil > 0.001;
            opacity: root.loading-veil;
            background: #000;
            if root.loading-picture && root.ds : Image {
                x: round(parent.width * root.top-x / root.screen-pixel) * root.screen-pixel;
                y: round(parent.height * root.top-y / root.screen-pixel) * root.screen-pixel;
                width: round(parent.width * root.top-w / root.screen-pixel) * root.screen-pixel;
                height: round(parent.height * root.top-h / root.screen-pixel) * root.screen-pixel;
                source: root.loading-frame;
                source-clip-x: 0; source-clip-y: 0;
                source-clip-width: root.loading-frame.width; source-clip-height: root.loading-frame.height / 2;
                image-fit: fill; image-rendering: ImageRendering.smooth;
            }
            if root.loading-picture && root.ds : Image {
                x: round(parent.width * root.bottom-x / root.screen-pixel) * root.screen-pixel;
                y: round(parent.height * root.bottom-y / root.screen-pixel) * root.screen-pixel;
                width: round(parent.width * root.bottom-w / root.screen-pixel) * root.screen-pixel;
                height: round(parent.height * root.bottom-h / root.screen-pixel) * root.screen-pixel;
                source: root.loading-frame;
                source-clip-x: 0; source-clip-y: root.loading-frame.height / 2;
                source-clip-width: root.loading-frame.width; source-clip-height: root.loading-frame.height / 2;
                image-fit: fill; image-rendering: ImageRendering.smooth;
            }
            if root.loading-picture && !root.ds : Image {
                width: parent.width; height: parent.height;
                source: root.loading-frame;
                image-fit: contain; image-rendering: ImageRendering.smooth;
            }
            Rectangle {
                width: parent.width; height: parent.height;
                background: #00000073;
            }
            Rectangle {
                width: 48px; height: 48px;
                border-radius: 24px; border-width: 4px;
                border-color: #ffffff38; background: transparent;
            }
            // Turns at a constant speed; stays still with Reduced Motion.
            Path {
                width: 48px; height: 48px;
                commands: "M 24 2 A 22 22 0 1 1 2 24";
                fill: transparent;
                stroke: #ffffffe6;
                stroke-width: 4px;
                stroke-line-cap: round;
                transform-origin: { x: 24px, y: 24px };
                transform-rotation: Motion.reduced-motion ? 0deg
                    : mod(animation-tick(), Motion.spinner-cycle) / Motion.spinner-cycle * 360deg;
            }
        }
    }
    Rectangle {
        width: parent.width; height: parent.height;
        visible: root.phase == 2 && !root.failed && (root.paused || root.pause-reveal > 0.001);
        background: transparent;
        clip: true;
        Rectangle {
            width: parent.width; height: parent.height;
            background: #00000070; opacity: root.pause-reveal;
            TouchArea { width: parent.width; height: parent.height; enabled: root.paused && !root.busy;
                clicked => { if root.restart-confirm || root.state-mode == 3 { root.restart-answer(0); } else { root.choose(0); } }
            }
        }
        PausePanel {
            x: -self.width * (1.0 - root.pause-reveal);
            width: min(Metrics.pause-panel-width, root.width);
            height: root.height;
            shadow-strength: root.pause-reveal;
            open: root.paused; busy: root.busy; ds: root.ds; ds-layout: root.ds-layout; ds-layout-forward: root.ds-layout-forward; speed: root.speed; speed-forward: root.speed-forward;
            screenshot-preview: root.screenshot-preview;
            screenshot-visible: root.screenshot-visible;
            screenshot-sequence: root.screenshot-sequence;
            title: root.title; message: root.message; focused: root.focused;
            state-mode: root.state-mode; state-focus: root.state-focus; state-rows: root.state-rows;
            state-choose(slot) => { root.state-choose(slot); }
            restart-confirm: root.restart-confirm; restart-focus: root.restart-focus;
            choose(index) => { root.choose(index); }
            restart-answer(choice) => { root.restart-answer(choice); }
        }
    }
    if root.phase == 2 : ModalDialog {
        open: root.failed || (root.busy && !root.paused && root.live);
        area-width: parent.width; area-height: parent.height;
        card-width: 520px; card-height: root.message == "" ? 196px : 272px;
        VerticalLayout {
            padding: Metrics.spacing-lg; spacing: Metrics.spacing-md;
            Text {text:root.failed ? "Game unavailable" : root.paused ? root.title : "Starting game";color:Theme.foreground;font-size:Typography.heading-size;overflow:elide;min-height:36px;}
            if root.message != "" : Text {text:root.message;color:Theme.secondary-foreground;font-size:Typography.body-size;wrap:word-wrap;min-height:64px;}
            if !root.busy : HorizontalLayout {
                height: 48px;
                spacing: Metrics.spacing-md;
                ActionButton {label:root.failed ? "Back" : "Continue";focused:root.focused==0;activated=>{root.choose(0);}}
                if !root.failed : ActionButton {label:"Save and quit";focused:root.focused==1;activated=>{root.choose(6);}}
            }
        }
    }
}
