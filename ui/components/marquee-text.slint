import { Theme, Typography, Motion } from "../theme/theme.slint";

// The one long-text treatment for every page. Text never shows an ellipsis:
// - active (the focused item): Home's marquee pacing. 2s hold, distance-sensitive
//   linear travel, 2.4s end hold, then an invisible fade back to the start.
// - inactive: clipped, with a soft fade at the right edge.
// Short text never moves. Reduced Motion keeps it static.
// `edge-color` must match whatever is painted behind the text (page background
// or a row surface) so the edge fades blend in without a visible band.
export component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <length> font-size: Typography.body-size;
    in property <int> font-weight: Typography.body-weight;
    in property <color> text-color: Theme.foreground;
    in property <color> edge-color: Theme.background;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    background: transparent;
    clip: true;

    private property <length> natural-width: text-measure.preferred-width;
    private property <bool> overflows: root.natural-width > root.width;
    private property <length> distance: root.overflows
        ? root.natural-width - root.width + 4px : 0px;
    private property <duration> travel-duration: Motion.marquee-travel(root.distance);
    private property <length> offset: 0px;
    private property <bool> animate-travel: false;
    private property <bool> animate-fade: false;
    private property <float> text-opacity: 1.0;
    // Each edge fade is exactly as strong as the text hidden behind it,
    // following the (animated) offset, so no glyph is caught at a clipping
    // edge while its fade is still appearing.
    private property <length> fade-width: min(22px, root.width / 6);
    private property <float> fade-left: max(0.0, min(1.0, root.offset / root.fade-width));
    private property <float> fade-right: max(0.0, min(1.0, (root.distance - root.offset) / root.fade-width));
    private property <bool> running: root.active && root.overflows && !Motion.reduced-motion;

    function restart() {
        delay.stop(); travel.stop(); end-pause.stop(); fade-out.stop(); fade-in.stop();
        root.animate-travel = false;
        root.animate-fade = false;
        root.offset = 0px;
        root.text-opacity = 1.0;
        if root.running { delay.start(); }
    }
    init => { root.restart(); }
    changed active => { root.restart(); }
    changed text => { root.restart(); }
    changed width => { root.restart(); }
    changed overflows => { root.restart(); }

    text-measure := Text {
        text: root.text;
        font-family: Typography.family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        opacity: 0.0;
    }
    Text {
        x: -root.offset;
        width: root.overflows ? root.natural-width : parent.width;
        height: parent.height;
        text: root.text;
        overflow: clip;
        color: root.text-color;
        font-family: Typography.family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: root.overflows ? TextHorizontalAlignment.left : root.horizontal-alignment;
        vertical-alignment: center;
        opacity: root.text-opacity;
        animate opacity {
            enabled: root.animate-fade && !Motion.reduced-motion;
            duration: root.text-opacity < 0.5 ? Motion.marquee-fade-out : Motion.marquee-fade-in;
            easing: ease-in-out;
        }
    }
    // Stationary edge fades (not segmented glyph masks, which caused seams).
    // A solid band at the clip, then a taper.
    if root.overflows && root.active : Rectangle {
        x: 0px; width: root.fade-width; height: parent.height;
        opacity: root.fade-left;
        background: @linear-gradient(90deg,
            root.edge-color 0%, root.edge-color 25%, root.edge-color.with-alpha(0.6) 55%, transparent 100%);
    }
    if root.overflows : Rectangle {
        x: parent.width - self.width;
        width: root.fade-width; height: parent.height;
        opacity: root.fade-right;
        background: @linear-gradient(90deg,
            transparent 0%, root.edge-color.with-alpha(0.6) 45%, root.edge-color 75%, root.edge-color 100%);
    }
    animate offset {
        enabled: root.animate-travel && !Motion.reduced-motion;
        duration: root.travel-duration;
        easing: linear;
    }
    delay := Timer {
        interval: Motion.marquee-start-delay;
        running: false;
        triggered => {
            self.stop();
            if root.running {
                root.animate-travel = true;
                root.offset = root.distance;
                travel.start();
            }
        }
    }
    travel := Timer {
        interval: root.travel-duration;
        running: false;
        triggered => { self.stop(); end-pause.start(); }
    }
    end-pause := Timer {
        interval: Motion.marquee-end-pause;
        running: false;
        triggered => {
            self.stop();
            if root.running {
                root.animate-fade = true;
                root.text-opacity = 0.0;
                fade-out.start();
            }
        }
    }
    fade-out := Timer {
        interval: Motion.marquee-fade-out;
        running: false;
        triggered => {
            self.stop();
            root.animate-travel = false;
            root.offset = 0px;
            root.text-opacity = 1.0;
            fade-in.start();
        }
    }
    fade-in := Timer {
        interval: Motion.marquee-fade-in;
        running: false;
        triggered => {
            self.stop();
            root.animate-fade = false;
            if root.running { delay.start(); }
        }
    }
}
