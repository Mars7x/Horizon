// Shared mouse-wheel and touchpad mapping for camera-only scrolling.
//
// Slint follows Winit: a positive `delta-y` moves content toward the TOP
// (a Flickable adds it to `viewport-y`). The compositor has already applied
// the user's natural/reverse scrolling setting, so mapping this sign
// faithfully is what makes Horizon honour that setting. Do not invert it.
//
// Scrolling moves the camera by pixels, never by rows or items: a touchpad's
// stream of small deltas follows the fingers, and a wheel notch glides a
// fixed distance.
//
// Slint's scroll events don't say which device sent them or when a touchpad
// gesture ends, so Rust reads both from winit before each event reaches Slint
// (`source`, `touching`). Without them (no winit, as offscreen) a whole
// multiple of 60px, Slint's line height, counts as a notch.
export global Wheel {
    // 0 unknown, 1 a wheel, 2 a touchpad: the device of the event being
    // handled.
    in-out property <int> source: 0;
    // Fingers are on the touchpad: from a touchpad gesture's first event
    // until its end (Wayland's axis stop).
    in-out property <bool> touching: false;
    out property <length> notch: 60px;
    // Camera travel per notch, and per pixel of touchpad travel.
    out property <float> notch-scale: 3.0;
    out property <float> touchpad-scale: 2.5;

    // A wheel notch (or several), rather than a touchpad's stream.
    public pure function is-notch(delta: length) -> bool {
        Wheel.source == 1 || (Wheel.source == 0 && delta != 0px
            && Math.round(delta / Wheel.notch) == delta / Wheel.notch)
    }
    // How far a scroll event moves the camera: positive down (or right).
    public pure function distance(delta: length) -> length {
        -delta * (Wheel.is-notch(delta) ? Wheel.notch-scale : Wheel.touchpad-scale)
    }
}
