import { Theme, Metrics, Motion } from "../theme/theme.slint";
import { GameCardData } from "../models/game-card.slint";
import { GameTile } from "game-tile.slint";
import { LibraryTile } from "library-tile.slint";
import { SelectedGameLabel } from "selected-game-label.slint";
import { Wheel } from "wheel.slint";
import { Scroll } from "scroll.slint";
import { Momentum } from "momentum.slint";

// The home carousel is modeled as a camera looking onto one larger scene.
// The rounded shelf, title/connector, game row, and focus frame all share the
// same world-space camera offset. Focus can move freely through a safe zone;
// only when it reaches a camera threshold does the complete scene pan.
export component GameCarousel inherits Rectangle {
    in property <[GameCardData]> games;
    in property <int> selected-index: 0;
    in property <string> selected-title;
    in property <int> launching-game-index: -1;
    in property <string> launch-feedback-text;
    in property <bool> focus-visible: true;
    callback game-selected(int);
    callback open-library();
    callback geometry-changed(float);

    private property <length> camera-offset: 0px;
    private property <length> content-width: (root.games.length + 1) * Metrics.game-stride;
    private property <length> shelf-width:
        root.content-width + Metrics.carousel-content-padding * 2;
    private property <length> selected-center-world-x:
        Metrics.carousel-shelf-left
        + Metrics.carousel-content-padding
        + root.selected-index * Metrics.game-stride
        + Metrics.game-stride / 2;
    private property <length> shelf-right-world-x:
        Metrics.carousel-shelf-left + root.shelf-width;
    private property <length> local-shelf-y:
        Metrics.carousel-shelf-y - Metrics.selected-label-y;
    out property <float> first-game-center-x-px:
        (Metrics.carousel-shelf-left
            + Metrics.carousel-content-padding
            + Metrics.game-stride / 2
            - root.camera-offset) / 1px;

    background: transparent;

    // This is the camera viewport. The shelf itself does not clip its games;
    // the entire scene is clipped only at the screen/view boundaries so the
    // title, connector, shelf, and tiles enter/leave together.
    clip: true;

    function ensure-selection-in-camera-zone() {
        // The Library destination is present even when no recent games exist.

        let selected-screen-x = root.selected-center-world-x - root.camera-offset;
        // After a swipe, focus moves the camera only to bring a game that
        // isn't fully on screen into view; otherwise the usual camera zone.
        let zone = root.panned ? Metrics.game-stride / 2 : Metrics.carousel-camera-edge-zone;
        let left-bound = zone;
        let right-bound = root.width - zone;

        if selected-screen-x < left-bound {
            root.camera-offset -= left-bound - selected-screen-x;
        } else if selected-screen-x > right-bound {
            root.camera-offset += selected-screen-x - right-bound;
        }
        // At either end, the shelf's rounded end and padding come into view
        // too, as they always do without a swipe (clamped below).
        if root.panned && root.selected-index <= 0 {
            root.camera-offset = 0px;
        } else if root.panned && root.selected-index >= root.games.length {
            root.camera-offset = root.shelf-right-world-x;
        }

        root.clamp-camera();
    }

    // At the start, the shelf's left rounded end sits at the standard
    // inset. At the end, the right rounded end resolves to the same inset.
    function clamp-camera() {
        let maximum-camera = root.shelf-right-world-x
            - (root.width - Metrics.carousel-shelf-left);

        if maximum-camera <= 0px {
            root.camera-offset = 0px;
        } else {
            if root.camera-offset < 0px {
                root.camera-offset = 0px;
            }
            if root.camera-offset > maximum-camera {
                root.camera-offset = maximum-camera;
            }
        }
    }

    // A swipe or tilt-wheel step pans the camera by pixels (a touchpad or a
    // finger directly, a notch with the usual glide) and never moves the
    // selection, even off screen; the next selection change brings the camera
    // back to it. A touchpad or finger pulling past either end stretches the
    // shelf (`Scroll.rubber`) and it springs back when the fingers lift
    // (`Wheel.touching`, or the drag's end); otherwise the camera glides on
    // (`Momentum`).
    private property <bool> following-pointer: false;
    private property <bool> springing: false;
    private property <length> pull: 0px;
    // The camera has been swiped since the games were last published.
    private property <bool> panned: false;
    public function pan(delta-x: length) {
        root.panned = true;
        let was-springing = root.springing;
        root.following-pointer = !Wheel.is-notch(delta-x);
        root.springing = false;
        // New input catches a glide (the speed being measured stays).
        if momentum.gliding {
            momentum.stop();
        }
        if root.following-pointer {
            if was-springing {
                // Still springing back: continue from where the shelf is.
                root.pull = Scroll.unrubber(-scene.x - root.camera-offset);
            }
            momentum.add(Wheel.distance(delta-x));
            let raw = root.camera-offset + root.pull + Wheel.distance(delta-x);
            root.camera-offset = raw;
            root.clamp-camera();
            root.pull = raw - root.camera-offset;
            release.stop();
            release.start();
        } else {
            root.pull = 0px;
            root.camera-offset += Wheel.distance(delta-x);
            root.clamp-camera();
        }
    }
    function spring-back() {
        release.stop();
        momentum.stop();
        root.following-pointer = false;
        root.springing = true;
        root.pull = 0px;
    }
    // The end of a swipe or drag: spring back from a pull, else glide on.
    function let-go() {
        release.stop();
        if root.pull != 0px {
            root.spring-back();
        } else {
            momentum.release();
        }
    }
    // A glide moves the camera; past an end it stretches the shelf instead,
    // braking hard, and springs back once it stops.
    momentum := Momentum {
        glide(travel) => {
            root.following-pointer = true;
            root.springing = false;
            let raw = root.camera-offset + root.pull + travel;
            root.camera-offset = raw;
            root.clamp-camera();
            root.pull = raw - root.camera-offset;
            // Stored lengths round, so a glide short of the end isn't exact.
            if abs(root.pull) > 0.5px {
                momentum.brake();
            } else {
                root.pull = 0px;
            }
        }
        ended => {
            if root.pull != 0px {
                root.spring-back();
            } else {
                root.following-pointer = false;
            }
        }
    }
    // Fingers lifting ends a swipe; the timer only covers a missing gesture
    // end (and doesn't glide: the fingers had stopped).
    private property <bool> fingers-down: Wheel.touching;
    changed fingers-down => {
        if !root.fingers-down && root.following-pointer && !momentum.gliding && !root.dragging {
            root.let-go();
        }
    }

    // A finger (or mouse) drag on the shelf, from Home's swipe handler: the
    // shelf follows it, then glides or springs back.
    private property <bool> dragging: false;
    // The unclamped camera the drag started from, and its last position.
    private property <length> drag-start: 0px;
    private property <length> drag-last: 0px;
    // `moved`: how far the finger already is from where it went down (the
    // swipe is recognised a little way in); the shelf moves from here, so it
    // doesn't jump by that much.
    public function drag-begin(moved: length) {
        root.panned = true;
        root.dragging = true;
        momentum.stop();
        release.stop();
        // Take the shelf from wherever it is drawn (gliding, or springing).
        let drawn = -scene.x;
        root.following-pointer = true;
        root.springing = false;
        root.camera-offset = drawn;
        root.clamp-camera();
        root.pull = Scroll.unrubber(drawn - root.camera-offset);
        root.drag-start = root.camera-offset + root.pull + moved;
        root.drag-last = root.camera-offset + root.pull;
    }
    // `moved`: how far the finger is from where it went down.
    public function drag-to(moved: length) {
        // The shelf follows the finger: moving right shows what's to the left.
        let raw = root.drag-start - moved;
        momentum.add(raw - root.drag-last);
        root.drag-last = raw;
        root.camera-offset = raw;
        root.clamp-camera();
        root.pull = raw - root.camera-offset;
    }
    public function drag-end() {
        if root.dragging {
            root.dragging = false;
            root.let-go();
        }
    }
    release := Timer {
        interval: 600ms;
        running: false;
        triggered => { root.spring-back(); }
    }

    init => {
        root.ensure-selection-in-camera-zone();
        root.geometry-changed(root.first-game-center-x-px);
    }
    // A spring-back's slower timing is for the spring only: the next move
    // (a wrap-around too) glides at the carousel's usual pace.
    changed selected-index => {
        root.following-pointer = false;
        root.springing = false;
        momentum.stop();
        root.pull = 0px;
        root.ensure-selection-in-camera-zone();
        root.geometry-changed(root.first-game-center-x-px);
    }
    changed width => {
        root.springing = false;
        momentum.stop();
        root.ensure-selection-in-camera-zone();
        root.geometry-changed(root.first-game-center-x-px);
    }
    // Leaving the carousel (another page, or the top icons) ends the swiped
    // state: coming back uses Home's usual camera.
    changed focus-visible => {
        if !root.focus-visible {
            root.panned = false;
        }
    }
    changed games => {
        root.panned = false;
        root.springing = false;
        momentum.stop();
        root.ensure-selection-in-camera-zone();
        root.geometry-changed(root.first-game-center-x-px);
    }
    changed camera-offset => { root.geometry-changed(root.first-game-center-x-px); }

    scene := Rectangle {
        x: -root.camera-offset - Scroll.rubber(root.pull);
        y: 0px;
        width: Metrics.carousel-shelf-left
            + root.shelf-width
            + Metrics.carousel-shelf-left;
        height: root.height;
        background: transparent;

        animate x {
            duration: root.following-pointer ? 0ms
                : root.springing ? Motion.overscroll-return-duration : Motion.carousel-duration;
            easing: ease-out;
        }

        // The backdrop is world geometry, not a fixed viewport. Render it
        // before the connector so the connector color stays visually constant
        // where it meets the shelf instead of being tinted by the translucent
        // shelf surface.
        Rectangle {
            x: Metrics.carousel-shelf-left;
            y: root.local-shelf-y;
            width: root.shelf-width;
            height: Metrics.carousel-shelf-height;
            background: Theme.surface.with-alpha(Theme.is-dark ? 0.60 : 0.88);
            border-radius: Metrics.carousel-shelf-radius;
            border-width: Theme.high-contrast ? 2px : 1px;
            border-color: Theme.divider.with-alpha(0.32);
        }

        SelectedGameLabel {
            x: root.selected-center-world-x - self.width / 2;
            y: 0px;
            title: root.selected-title;
            status: root.launch-feedback-text;
            visible: root.focus-visible;
        }

        // Connector and endpoint sit above the shelf. Both use one exact color
        // from end to end, including at the backdrop boundary.
        Rectangle {
            x: root.selected-center-world-x - 1px;
            y: Metrics.selected-label-height;
            width: 2px;
            visible: root.focus-visible;
            height: root.local-shelf-y - Metrics.selected-label-height + 6px;
            background: Theme.divider;

            Rectangle {
                x: -3px;
                y: parent.height - 2px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.divider;
            }
        }

        track := Rectangle {
            x: Metrics.carousel-shelf-left + Metrics.carousel-content-padding;
            y: root.local-shelf-y
                + (Metrics.carousel-shelf-height - Metrics.game-slot-height) / 2;
            width: root.content-width;
            height: Metrics.game-slot-height;
            background: transparent;

            for game[index] in root.games : GameTile {
                x: index * Metrics.game-stride;
                y: 0px;
                game: game;
                item-index: index;
                // Keep the logical selected index while content focus is away,
                // but remove every game-selection visual when the utility row owns focus.
                // This prevents the previously selected game from staying enlarged.
                selected: root.focus-visible && index == root.selected-index;
                launching: index == root.launching-game-index;
                focus-visible: root.focus-visible;
                activated(index) => { root.game-selected(index); }
            }
            LibraryTile {
                x: root.games.length * Metrics.game-stride;
                y: 0px;
                selected: root.focus-visible && root.selected-index == root.games.length;
                focus-visible: root.focus-visible;
                activated => { root.open-library(); }
            }
        }
    }
}
