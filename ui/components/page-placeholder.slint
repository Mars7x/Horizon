import { Theme, Metrics, Typography } from "../theme/theme.slint";
import { PageHeader } from "page-header.slint";

// Placeholder for utilities without production content yet. Uses the shared
// page frame (header, hint bar from app.slint) so it reads like every other
// page; the message sits where real content will go.
export component PagePlaceholder inherits Rectangle {
    in property <string> title;
    in property <string> description;

    background: Theme.background;

    PageHeader { width: parent.width; title: root.title; }

    Text {
        x: Metrics.page-margin;
        y: Metrics.page-header-height;
        width: parent.width - Metrics.page-margin * 2;
        height: parent.height - Metrics.page-header-height - Metrics.page-bottom-bar-height;
        text: root.description;
        color: Theme.secondary-foreground;
        font-size: Typography.body-size;
        font-weight: Typography.body-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}
