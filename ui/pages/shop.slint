import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { ShopAppData, ShopShotData } from "../models/shop.slint";
import { PageHeader, HeaderValue, Breadcrumb, ScrollEdgeShadow } from "../components/page-header.slint";
import { MarqueeText } from "../components/marquee-text.slint";
import { TransitionDriver, TransitionLayer } from "../components/transition.slint";
import { DragScroll, Scroll, ScrollCamera } from "../components/scroll.slint";
import { Stopwatch } from "../components/stopwatch.slint";
import { SelectionFocusSurface } from "../components/selection-focus-surface.slint";
import { ActionButton } from "../components/action-button.slint";
import { KeyboardButton } from "../components/on-screen-keyboard.slint";
import { ConfirmDialog } from "../components/confirm-dialog.slint";
import { Wheel } from "../components/wheel.slint";

// A job's progress: a filled bar, or a sliding segment while flatpak
// doesn't say how far it is (still with Reduced Motion).
component ProgressBar inherits Rectangle {
    in property <float> progress: -1;
    height: 4px;
    border-radius: 2px;
    background: Theme.divider.with-alpha(0.76);
    clip: true;
    private property <float> sweep: Motion.reduced-motion || Motion.loops-paused ? 0.35
        : Math.mod(animation-tick() / 1400ms, 1.0);
    Rectangle {
        x: root.progress >= 0 ? 0px : (root.width * 1.35) * root.sweep - root.width * 0.35;
        width: root.progress >= 0 ? root.width * max(0.0, min(1.0, root.progress)) : root.width * 0.35;
        height: parent.height;
        border-radius: 2px;
        background: Theme.accent;
        animate width { duration: Motion.value-swap-duration; easing: ease-out; }
    }
}

// A card's state: Installed, Update (accent), or the job on it.
component StatusPill inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    in property <color> base;
    width: label.preferred-width + 16px;
    height: 20px;
    border-radius: 10px;
    background: root.accent ? Theme.accent : root.base.mix(Theme.foreground, 0.88);
    label := Text {
        x: 8px; height: parent.height;
        text: root.text;
        color: root.accent ? Theme.accent-foreground : Theme.secondary-foreground;
        font-size: Typography.label-size;
        font-weight: Typography.emphasis-weight;
        vertical-alignment: center;
    }
}

// An app's icon: its picture once downloaded (fading in), a quiet tile
// until then.
component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: false;
    border-radius: self.width * 0.22;
    background: Theme.surface-raised;
    clip: true;
    private property <float> shown: root.has-icon ? 1.0 : 0.0;
    animate shown { duration: Motion.value-swap-duration; easing: ease-in-out; }
    Image {
        width: parent.width; height: parent.height;
        source: root.icon;
        image-fit: contain;
        opacity: root.shown;
        accessible-role: none;
    }
}

// Flathub's verified mark: a small accent tick before the developer.
component VerifiedMark inherits Path {
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    commands: "M 7 0.5 A 6.5 6.5 0 1 1 6.99 0.5 Z M 3.8 7.2 L 6.1 9.4 L 10.3 4.8";
    fill: Theme.accent;
    stroke: Theme.accent-foreground;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    accessible-role: none;
}

// One app in the grid: the shared row surface and focus outline (ListRow's),
// laid out as a card. The focused card's text marquees.
component AppCard inherits Rectangle {
    in property <ShopAppData> app;
    in property <bool> focused: false;
    in property <bool> enabled: true;
    callback activated();
    callback wheel(length);

    private property <color> surface-color: root.enabled && (touch.pressed || touch.has-hover)
        ? Theme.surface-raised : Theme.surface;
    background: root.surface-color;
    border-radius: Metrics.radius-lg;
    private property <float> focus-reveal: root.focused ? 1.0 : 0.0;
    animate focus-reveal { duration: Motion.focus-duration; easing: ease-in-out; }
    border-width: root.focused ? (Theme.high-contrast ? 3px : 2px) : 1px;
    border-color: Theme.divider.with-alpha(0.65).mix(Motion.menu-focus-color, 1.0 - root.focus-reveal);
    animate border-width { duration: Motion.focus-duration; easing: ease-in-out; }
    animate background { duration: Motion.hover-duration; easing: ease-in-out; }
    accessible-role: button;
    accessible-label: root.app.name;
    accessible-description: root.app.summary;

    AppIcon {
        x: 18px; y: (parent.height - self.height) / 2;
        width: 64px; height: 64px;
        icon: root.app.icon;
        has-icon: root.app.has-icon;
    }
    MarqueeText {
        x: 98px; y: 16px;
        width: parent.width - 98px - 16px - (root.app.status != "" ? pill.width + 8px : 0px); height: 26px;
        text: root.app.name;
        active: root.focused;
        edge-color: root.surface-color;
        font-weight: Typography.emphasis-weight;
    }
    if root.app.verified : VerifiedMark {
        x: 98px; y: 45px;
    }
    MarqueeText {
        x: root.app.verified ? 118px : 98px; y: 41px;
        width: parent.width - self.x - 16px; height: 22px;
        text: root.app.developer;
        active: root.focused;
        text-color: Theme.secondary-foreground;
        edge-color: root.surface-color;
        font-size: Typography.caption-size;
    }
    MarqueeText {
        x: 98px; y: 63px;
        width: parent.width - 98px - 16px; height: 22px;
        text: root.app.summary;
        active: root.focused;
        text-color: Theme.secondary-foreground;
        edge-color: root.surface-color;
        font-size: Typography.caption-size;
    }
    pill := StatusPill {
        x: parent.width - self.width - 14px; y: 19px;
        visible: root.app.status != "";
        text: root.app.status;
        accent: root.app.status == "Update";
        base: root.surface-color;
    }
    if root.app.busy : ProgressBar {
        x: 98px; y: parent.height - 12px;
        width: parent.width - 98px - 16px;
        progress: root.app.progress;
    }
    touch := TouchArea {
        width: parent.width; height: parent.height;
        enabled: root.enabled;
        clicked => { root.activated(); }
        scroll-event(event) => {
            if event.delta-y != 0px {
                root.wheel(event.delta-y);
                return accept;
            }
            reject
        }
    }
}

// Flathub, browsed with a controller: a category or a search, as a grid of
// apps; A opens an app's page, whose Install hands it to the system's
// software store. Selection, loading and paging are Rust-owned
// (presentation/shop.rs).
export component ShopPage inherits Rectangle {
    // The mounted apps (those near the camera), and how many the listing
    // has loaded.
    in property <[ShopAppData]> apps;
    in property <int> app-count: 0;
    in property <int> selected: 0;
    in property <int> first-row: 0;
    in property <int> visit: 0;
    // 0 loading, 1 ready, 2 failed.
    in property <int> state: 0;
    in property <string> category: "Games";
    in property <string> count: "";
    in-out property <string> query: "";
    // The search field has focus (Up from the first row); typing in it.
    in property <bool> search-focused: false;
    in property <bool> searching: false;
    // Bumped when new apps arrive: they fade in, those shown stay put.
    in property <int> catalog-revision: 0;
    // How far the description scrolls, in Up/Down steps.
    out property <int> description-steps: Math.ceil(description-viewport.overflow / description-viewport.step);
    in property <bool> active: true;
    in property <length> keyboard-inset: 0px;
    in property <int> keyboard-caret: 0;
    in property <int> keyboard-edit: 0;

    // An app's page.
    in property <bool> details-open: false;
    in property <string> detail-name;
    in property <string> detail-developer;
    in property <string> detail-summary;
    in property <bool> detail-verified: false;
    in property <image> detail-icon;
    in property <bool> detail-has-icon: false;
    in property <string> detail-description;
    // 0 loading, 1 ready, 2 failed.
    in property <int> detail-state: 0;
    in property <[ShopShotData]> shots;
    in property <int> shot: 0;
    in property <int> description-row: 0;
    in property <string> feedback: "";
    // The page's buttons, left to right (Install; or Open, Update,
    // Uninstall), the focused one, and what's happening to the app instead
    // ("Installing", "Waiting"), with its progress (-1 unknown).
    in property <[string]> actions;
    in property <int> action-focus: 0;
    in property <string> busy-label: "";
    in property <float> progress: -1;
    in property <bool> confirm-open: false;
    in property <int> confirm-focus: 0;

    callback choose(int);
    callback cycle-category(int);
    callback scroll-rows(int);
    callback search-open();
    callback search-edited(string);
    callback search-finish();
    callback search-clear();
    callback keyboard-show();
    callback activate-action(int);
    callback confirm(int);
    callback close-details();
    callback step-shot(int);
    callback scroll-description(int);
    background: Theme.background;

    private property <length> margin: Metrics.page-margin;
    private property <length> search-y: Metrics.page-header-height;
    private property <length> search-height: 52px;
    private property <length> grid-top: root.search-y + root.search-height + 20px;
    private property <length> card-height: 104px;
    private property <length> gap: 16px;
    private property <length> stride: root.card-height + root.gap;
    private property <length> grid-width: root.width - root.margin * 2;
    private property <length> list-bottom: root.height - Metrics.page-bottom-bar-height;
    private property <length> viewport-height: max(0px, root.list-bottom - root.grid-top);
    out property <int> columns: max(1, Math.floor((root.grid-width + root.gap) / (340px + root.gap)));
    out property <int> visible-rows: max(1, Math.floor((root.viewport-height + root.gap) / root.stride));
    private property <length> card-width: (root.grid-width - (root.columns - 1) * root.gap) / root.columns;
    private property <int> row-count: Math.floor((root.app-count + root.columns - 1) / root.columns);
    // Cards sit 2px in, for the focus border.
    private property <length> content: max(0px, root.row-count * root.stride - root.gap + 4px);

    // Apps before this index were already shown when the last ones arrived.
    in property <int> catalog-base: 0;
    private property <int> previous-count: 0;
    private property <int> arrivals: 0;
    changed catalog-revision => {
        root.previous-count = root.catalog-base;
        root.arrivals += 1;
    }
    arrival-clock := Stopwatch {
        key: root.arrivals;
        length: Motion.value-swap-duration;
    }

    camera := ScrollCamera {
        rest-row: root.first-row;
        stride: root.stride;
        content: root.content;
        viewport: root.viewport-height;
        settle-key: root.visit;
        focus-key: root.selected;
        focus-row: root.search-focused ? -1 : Math.floor(root.selected / root.columns);
        focus-span: root.card-height + 4px;
        scrolled(rows) => { root.scroll-rows(rows); }
    }
    private property <length> grid-camera: camera.camera;

    private property <float> detail-reveal: root.details-open ? 1.0 : 0.0;
    animate detail-reveal { duration: Motion.page-duration; easing: ease-out; }

    PageHeader {
        width: parent.width;
        title: "Shop";
        HorizontalLayout {
            width: 130px + 200px + Metrics.spacing-sm;
            x: parent.width - Metrics.page-margin - self.width + Metrics.spacing-sm + 2px;
            y: Metrics.page-accessory-y;
            height: Metrics.page-accessory-height;
            spacing: Metrics.spacing-sm;
            // They describe the grid; they step aside on an app's page.
            HeaderValue {
                width: 130px; label: "Apps"; value: root.count;
                opacity: 1.0 - root.detail-reveal;
            }
            HeaderValue {
                width: 200px; label: "Category";
                value: root.query != "" ? "Search" : root.category;
                interactive: !root.details-open;
                button: "LB"; button2: "RB";
                opacity: 1.0 - root.detail-reveal;
                clicked => { root.cycle-category(1); }
            }
        }
    }

    view-transition := TransitionDriver { key: root.details-open ? 1 : 0; }

    browse-view := TransitionLayer {
        width: root.width; height: root.height;
        opaque: true;
        cover-from: Metrics.page-header-height;
        active: !root.details-open;
        outgoing: root.details-open;
        returning: !root.details-open;
        phase: view-transition.phase;

        // The search field: Up from the first row, or a click.
        search-field := Rectangle {
            x: root.margin; y: root.search-y;
            width: root.grid-width; height: root.search-height;
            background: Theme.surface;
            border-radius: Metrics.radius-md;
            border-width: 1px;
            border-color: Theme.divider;
            SelectionFocusSurface {
                x: -3px; y: -3px;
                width: parent.width + 6px; height: parent.height + 6px;
                corner-radius: Metrics.radius-md + 3px;
                focused: root.search-focused && !root.details-open;
                filled: false;
                soft-shadow: false;
            }
            Path {
                x: 18px; y: (parent.height - self.height) / 2;
                width: 18px; height: 18px;
                viewbox-width: 18; viewbox-height: 18;
                commands: "M 7.5 1.5 A 6 6 0 1 1 7.49 1.5 Z M 12 12 L 16.5 16.5";
                fill: transparent;
                stroke: Theme.secondary-foreground;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                accessible-role: none;
            }
            field-touch := TouchArea {
                width: parent.width; height: parent.height;
                mouse-cursor: text;
                clicked => {
                    if (!root.details-open) {
                        root.search-open();
                        search-input.focus();
                    }
                }
            }
            Rectangle {
                x: 48px; width: parent.width - 48px - 96px; height: parent.height;
                background: transparent;
                clip: true;
                if root.query == "" : Text {
                    width: parent.width; height: parent.height;
                    text: "Search Flathub";
                    color: Theme.secondary-foreground;
                    font-size: Typography.body-size;
                    vertical-alignment: center;
                }
                search-input := TextInput {
                    width: parent.width; height: parent.height;
                    text <=> root.query;
                    enabled: !root.details-open;
                    font-family: Typography.family;
                    font-size: Typography.body-size;
                    color: Theme.foreground;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.accent-foreground;
                    accessible-label: "Search Flathub";
                    vertical-alignment: center;
                    single-line: true;
                    edited => { root.search-edited(self.text); }
                    accepted => { root.search-finish(); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape || event.text == Key.DownArrow) {
                            root.search-finish();
                            return accept;
                        }
                        reject
                    }
                }
            }
            // Clear, for a pointer (X on a controller).
            if root.query != "" : Rectangle {
                x: parent.width - 88px; y: (parent.height - self.height) / 2;
                width: 36px; height: 36px;
                border-radius: Metrics.radius-sm;
                background: clear-touch.pressed ? Theme.divider
                    : clear-touch.has-hover ? Theme.surface-raised : transparent;
                animate background { duration: Motion.hover-duration; easing: ease-in-out; }
                accessible-role: button;
                accessible-label: "Clear";
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 12px; height: 12px;
                    viewbox-width: 12; viewbox-height: 12;
                    commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                    stroke: Theme.secondary-foreground;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                }
                clear-touch := TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.search-clear(); }
                }
            }
            KeyboardButton {
                x: parent.width - self.width - 8px; y: (parent.height - self.height) / 2;
                activated => {
                    if (!root.details-open) {
                        root.search-open();
                        root.keyboard-show();
                    }
                }
            }
        }

        grid-viewport := Rectangle {
            x: root.margin; y: root.grid-top;
            width: root.grid-width;
            height: root.viewport-height;
            background: transparent; clip: true;
            DragScroll {
                width: parent.width; height: parent.height;
                enabled: !root.details-open;
                drag-begin(moved) => { camera.drag-begin(moved); }
                drag-to(moved) => { camera.drag-to(moved); }
                drag-end => { camera.drag-end(); }
                TouchArea {
                    width: parent.width; height: parent.height;
                    enabled: !root.details-open;
                    scroll-event(event) => {
                        if event.delta-y != 0px {
                            camera.scroll(event.delta-y);
                            return accept;
                        }
                        reject
                    }
                }
                for app in root.apps : AppCard {
                    property <int> grid-row: Math.floor(app.index / root.columns);
                    property <float> entrance: app.index < root.previous-count
                        ? 1.0 : 1.0 - (1.0 - arrival-clock.progress) * (1.0 - arrival-clock.progress);
                    opacity: self.entrance;
                    x: Math.mod(app.index, root.columns) * (root.card-width + root.gap);
                    y: self.grid-row * root.stride - root.grid-camera + 2px + (1.0 - self.entrance) * 8px;
                    width: root.card-width; height: root.card-height;
                    // Culling follows the animated camera.
                    visible: self.grid-row * root.stride >= root.grid-camera - 3 * root.stride
                        && self.grid-row * root.stride <= root.grid-camera + root.viewport-height + 3 * root.stride;
                    app: app;
                    focused: !root.search-focused && root.selected == app.index;
                    enabled: !root.details-open;
                    activated => { root.choose(app.index); }
                    wheel(delta) => { camera.scroll(delta); }
                }
                if root.app-count == 0 && root.state != 0 : Text {
                    x: 0px; y: Metrics.spacing-lg; width: parent.width;
                    text: root.state == 2 ? "Can't reach Flathub right now" : "Nothing found";
                    color: Theme.secondary-foreground; font-size: Typography.body-size;
                    wrap: word-wrap;
                }
            }
        }
        if root.app-count > 0 : ScrollEdgeShadow {
            x: 0px; y: root.grid-top; width: root.width;
            strength: Scroll.edge(root.grid-camera);
        }
        if root.active && root.app-count > 0 : ScrollEdgeShadow {
            x: 0px; y: root.list-bottom - self.height; width: root.width;
            bottom: true;
            strength: Scroll.edge(root.content - root.grid-camera - root.viewport-height);
        }
    }

    details-view := TransitionLayer {
        width: root.width; height: root.height;
        opaque: true;
        cover-from: Metrics.page-header-height;
        active: root.details-open;
        outgoing: !root.details-open;
        returning: !root.details-open;
        phase: view-transition.phase;

        property <length> top: Metrics.page-header-height + Metrics.breadcrumb-height + Metrics.spacing-md;
        property <length> available: max(0px, root.list-bottom - self.top);
        property <length> left-width: min(400px, root.grid-width * 0.36);
        property <length> right-x: root.margin + self.left-width + 40px;
        property <length> right-width: max(0px, root.width - root.margin - self.right-x);
        // The screenshot frame: 16:9, as large as fits above its dots.
        property <length> shot-height: min(self.right-width * 9 / 16, self.available - 28px);
        property <length> shot-width: self.shot-height * 16 / 9;

        Breadcrumb {
            x: root.margin; y: Metrics.page-header-height;
            width: root.grid-width;
            section: "Shop";
            page: root.detail-name;
            back => { if (root.details-open) { root.close-details(); } }
        }
        AppIcon {
            x: root.margin; y: parent.top;
            width: 96px; height: 96px;
            icon: root.detail-icon;
            has-icon: root.detail-has-icon;
        }
        MarqueeText {
            x: root.margin + 116px; y: parent.top + 14px;
            width: parent.left-width - 116px; height: 34px;
            text: root.detail-name;
            active: root.details-open;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
        }
        if root.detail-verified : VerifiedMark {
            x: root.margin + 116px; y: parent.top + 56px;
        }
        MarqueeText {
            x: root.margin + 116px + (root.detail-verified ? 20px : 0px); y: parent.top + 52px;
            width: parent.left-width - 116px - (root.detail-verified ? 20px : 0px); height: 22px;
            text: root.detail-developer;
            active: root.details-open;
            text-color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
        }
        summary := Text {
            x: root.margin; y: parent.top + 116px;
            width: parent.left-width;
            text: root.detail-summary;
            color: Theme.foreground;
            font-size: Typography.body-size;
            wrap: word-wrap;
        }
        // The buttons, or what's happening to the app instead.
        buttons := Rectangle {
            x: root.margin; y: summary.y + summary.preferred-height + Metrics.spacing-md;
            width: parent.left-width; height: 48px;
            background: transparent;
            if root.busy-label == "" : HorizontalLayout {
                spacing: 12px;
                alignment: start;
                for label[i] in root.actions : ActionButton {
                    width: max(120px, self.preferred-width + 40px);
                    primary: i == 0;
                    label: label;
                    focused: root.details-open && !root.confirm-open && root.action-focus == i;
                    activated => { if (root.details-open) { root.activate-action(i); } }
                }
            }
            if root.busy-label != "" : Rectangle {
                x: 0px; width: min(parent.width, 280px);
                background: transparent;
                Text {
                    x: 0px; y: 2px; width: parent.width; height: 22px;
                    text: root.progress >= 0 ? root.busy-label + "  " + Math.round(root.progress * 100) + "%" : root.busy-label;
                    color: Theme.foreground;
                    font-size: Typography.body-size;
                    font-weight: Typography.emphasis-weight;
                    vertical-alignment: center;
                }
                ProgressBar {
                    x: 0px; y: 34px; width: parent.width;
                    progress: root.progress;
                }
            }
        }
        if root.feedback != "" : Text {
            x: root.margin; y: buttons.y + buttons.height + 4px; height: 20px;
            width: parent.left-width;
            text: root.feedback;
            color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
            vertical-alignment: center;
        }

        // The description, read-only: Up/Down or the wheel scroll it.
        description-viewport := Rectangle {
            property <length> step: 48px;
            x: root.margin; y: buttons.y + buttons.height + Metrics.spacing-lg + (root.feedback != "" ? 12px : 0px);
            width: parent.left-width;
            height: max(0px, root.list-bottom - self.y);
            background: transparent; clip: true;
            property <length> overflow: max(0px, description.preferred-height - self.height);
            property <length> offset: min(root.description-row * self.step, self.overflow);
            animate offset { duration: Motion.scroll-duration; easing: linear; }
            TouchArea {
                width: parent.width; height: parent.height;
                scroll-event(event) => {
                    if event.delta-y != 0px {
                        root.scroll-description(event.delta-y < 0px ? 1 : -1);
                        return accept;
                    }
                    reject
                }
            }
            description := Text {
                y: -parent.offset;
                width: parent.width;
                text: root.detail-state == 2 ? "Can't reach Flathub right now" : root.detail-description;
                color: root.detail-state == 2 ? Theme.secondary-foreground : Theme.foreground;
                font-size: Typography.body-size;
                wrap: word-wrap;
            }
            if description-viewport.offset > 0px : Rectangle {
                y: 0px; width: parent.width; height: 24px;
                background: @linear-gradient(180deg, Theme.background 0%, Theme.background.with-alpha(0) 100%);
            }
            if description-viewport.offset < description-viewport.overflow : Rectangle {
                y: parent.height - self.height; width: parent.width; height: 32px;
                background: @linear-gradient(180deg, Theme.background.with-alpha(0) 0%, Theme.background 100%);
            }
        }

        // Screenshots: LB/RB; a click (the left edge goes back, the rest
        // forward, as Album's viewer); or a swipe: a finger or mouse drag, or
        // two fingers on a touchpad. None of it moves focus.
        shot-frame := Rectangle {
            x: parent.right-x + (parent.right-width - parent.shot-width) / 2;
            y: parent.top;
            width: parent.shot-width; height: parent.shot-height;
            background: Theme.surface;
            border-radius: Metrics.radius-lg;
            border-width: Theme.high-contrast ? 2px : 1px;
            border-color: Theme.divider.with-alpha(0.65);
            clip: true;
            for item[i] in root.shots : Image {
                width: parent.width; height: parent.height;
                source: item.image;
                image-fit: contain;
                property <float> shown: item.loaded && root.shot == i ? 1.0 : 0.0;
                opacity: self.shown;
                animate opacity { duration: Motion.value-swap-duration; easing: ease-in-out; }
                accessible-role: none;
            }
            if root.shots.length > 1 : shot-touch := TouchArea {
                width: parent.width; height: parent.height;
                // How far back the left edge reaches.
                property <length> back-edge: min(140px, self.width / 4);
                // A drag this long is a swipe, not a click.
                property <length> swipe-distance: 40px;
                // Touchpad travel this gesture, and whether it has stepped.
                property <length> travel: 0px;
                property <bool> stepped: false;
                property <bool> fingers: Wheel.touching;
                changed fingers => {
                    if !self.fingers { self.travel = 0px; self.stepped = false; }
                }
                // On release (Slint's `clicked` would also fire after a drag).
                pointer-event(event) => {
                    if event.kind != PointerEventKind.up || event.button != PointerEventButton.left {
                        return;
                    }
                    if abs(self.mouse-x - self.pressed-x) >= self.swipe-distance {
                        // Content follows the finger: dragging left shows the next.
                        root.step-shot(self.mouse-x < self.pressed-x ? 1 : -1);
                    } else if self.mouse-x >= 0px && self.mouse-x <= self.width
                        && self.mouse-y >= 0px && self.mouse-y <= self.height {
                        root.step-shot(self.mouse-x < self.back-edge ? -1 : 1);
                    }
                }
                scroll-event(event) => {
                    if event.delta-x == 0px {
                        return reject;
                    }
                    // A wheel tilt steps once per notch; a touchpad steps once
                    // per gesture, after enough travel.
                    if Wheel.is-notch(event.delta-x) {
                        root.step-shot(Wheel.distance(event.delta-x) > 0px ? 1 : -1);
                        return accept;
                    }
                    self.travel += Wheel.distance(event.delta-x);
                    if !self.stepped && abs(self.travel) >= self.swipe-distance * 2 {
                        self.stepped = true;
                        root.step-shot(self.travel > 0px ? 1 : -1);
                    }
                    accept
                }
                for side in [-1, 1] : Rectangle {
                    x: side < 0 ? Metrics.spacing-md : parent.width - self.width - Metrics.spacing-md;
                    y: (parent.height - self.height) / 2;
                    width: 40px; height: 40px; border-radius: 20px;
                    background: #00000080;
                    opacity: shot-touch.has-hover && (side < 0) == (shot-touch.mouse-x < shot-touch.back-edge)
                        ? 1.0 : 0.0;
                    animate opacity { duration: Motion.hover-duration; easing: ease-in-out; }
                    Text {
                        width: parent.width; height: parent.height;
                        text: side < 0 ? "‹" : "›";
                        color: white;
                        font-size: Typography.heading-size;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
        }
        if root.shots.length > 1 : HorizontalLayout {
            x: shot-frame.x + (shot-frame.width - self.width) / 2;
            y: shot-frame.y + shot-frame.height + 14px;
            width: root.shots.length * 8px + (root.shots.length - 1) * 8px;
            height: 8px;
            spacing: 8px;
            for item[i] in root.shots : Rectangle {
                width: 8px; height: 8px;
                border-radius: 4px;
                background: root.shot == i ? Theme.accent : Theme.divider;
                animate background { duration: Motion.focus-duration; easing: ease-in-out; }
            }
        }
    }

    ConfirmDialog {
        area-width: root.width; area-height: root.height;
        z: 30;
        open: root.confirm-open;
        title: "Uninstall " + root.detail-name + "?";
        text: "Its saved data stays";
        action: "Uninstall";
        selected: root.confirm-focus;
        choose(choice) => { root.confirm(choice); }
    }

    // The text field takes keys once a search starts, its text selected so
    // typing replaces it; the keyboard's caret lands where it types.
    focus-after-opening := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.stop();
            if (root.searching) {
                search-input.focus();
                search-input.select-all();
            }
        }
    }
    changed searching => {
        if (root.searching) {
            focus-after-opening.start();
        } else {
            focus-after-opening.stop();
        }
    }
    changed keyboard-edit => {
        if (root.searching) {
            search-input.set-selection-offsets(root.keyboard-caret, root.keyboard-caret);
        }
    }
}
