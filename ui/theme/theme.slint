export global Theme {
    in-out property <bool> is-dark: false;
    in-out property <bool> high-contrast: false;

    in-out property <color> background: #ffffff;
    in-out property <color> surface: #f5f5f7;
    in-out property <color> surface-raised: #ffffff;
    in-out property <color> foreground: #18181b;
    in-out property <color> secondary-foreground: #63636b;
    in-out property <color> divider: #dadae0;
    in-out property <color> shadow: #00000026;

    // The Playing capsule stays dark/neutral over any cover artwork in both
    // themes; only the small status dot follows the current accent colour.
    in-out property <color> playing-pill-background: #202126;
    in-out property <color> playing-pill-foreground: #ffffff;

    in-out property <color> accent: #3584e4;
    in-out property <color> accent-hover: #317acb;
    in-out property <color> accent-pressed: #2d70b8;
    in-out property <color> accent-subtle: #e4effc;
    in-out property <color> accent-foreground: #ffffff;
    in-out property <color> focus: #3584e4;
    in-out property <color> focus-highlight: #62a0ea;
    // Picker preview of the White preset uses the very same contrast-adjusted
    // focus colour chosen by the Rust appearance resolver for Light/Dark.
    in-out property <color> appearance-white-swatch: #ffffff;

}

export global Metrics {
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;
    out property <length> spacing-xxl: 48px;

    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 18px;

    out property <length> page-margin: 40px;
    out property <length> design-width: 1280px;
    out property <length> design-height: 720px;
    out property <length> top-edge-inset: 28px;

    // Shared full-screen page frame (every page except Home). One title-only
    // header at a fixed position, content from page-header-height down, and a
    // bottom bar: page context on the left, controller hints on the right.
    out property <length> page-title-y: 20px;
    out property <length> page-title-height: 48px;
    out property <length> page-header-height: 88px;
    // Same height as Home's footer, so hints are centred in every page's bar
    // and on exactly the same line as Home's "A OK".
    out property <length> page-bottom-bar-height: footer-height;
    // Hints and bottom-bar context share ONE line on every page, Home
    // included: the vertical midpoint of Home's footer.
    out property <length> hint-row-height: 40px;
    out property <length> hint-row-center-from-bottom: footer-height / 2;
    // Header accessories (Source/Sort pickers) sit on the title row, right side.
    out property <length> page-accessory-height: 52px;
    out property <length> page-accessory-y: page-title-y + (page-title-height - page-accessory-height) / 2;
    // Sub-pages open with a "Section  /  Page" breadcrumb at the content top.
    out property <length> breadcrumb-height: 26px;
    // Every focusable list row (Settings, Achievements) shares one height.
    out property <length> list-row-height: 80px;
    out property <length> list-row-gap: 8px;
    out property <length> scroll-edge-shadow-height: 11px;

    // Persistent top-utility geometry. Navigation uses these same values when
    // comparing rendered center-to-center distances across focus regions.
    out property <length> utility-cell-size: 40px;
    out property <length> utility-spacing: 24px;
    out property <length> utility-center-step: utility-cell-size + utility-spacing;
    out property <length> utility-row-width:
        utility-cell-size * 7 + utility-spacing * 6;

    // One reference-style focus layer. The frame sits deliberately outside
    // the game shell with a visible air gap while keeping the same radius
    // language. `focus-offset` is the world-space separation from the shell.
    out property <length> focus-stroke: 10px;
    out property <length> focus-arm: 58px;
    out property <length> focus-offset: 9px;

    // Home shell geometry. Phase 3.14.13 brings the main scene closer to
    // the reference proportions: title nearer the top chrome, a larger shelf,
    // and larger game cards that occupy more of the central view.
    out property <length> top-chrome-height: 86px;
    out property <length> selected-label-y: 112px;
    out property <length> selected-label-width: 220px;
    out property <length> selected-label-height: 42px;
    out property <length> carousel-shelf-y: 190px;
    out property <length> carousel-shelf-height: 360px;
    out property <length> carousel-shelf-left: 46px;
    out property <length> carousel-shelf-radius: 38px;
    out property <length> carousel-content-padding: 18px;
    out property <length> carousel-camera-edge-zone: 190px;

    // Phase 3.13 trims only the footer; the top chrome intentionally remains
    // unchanged. Footer contents sit on the true vertical midpoint.
    out property <length> footer-height: 92px;
    out property <length> footer-content-lift: 0px;

    // Larger reference-density cards. The shell/art proportions stay intact while
    // the carousel occupies more of the vertical and horizontal main view.
    out property <length> game-tile-size: 220px;
    out property <length> game-stride: 250px;
    out property <length> game-slot-height: 320px;
    out property <float> game-selected-scale: 1.10;
    // Bottom inset measured inside the actual artwork frame; unlike a
    // screen-space compensation this stays constant while the art grows.
    out property <length> playing-pill-artwork-bottom-inset: 12px;
    out property <float> game-launch-pressed-scale: 1.055;
    out property <length> game-shell-radius: 30px;
    out property <length> game-art-inset: 20px;
    out property <length> cover-radius: 18px;
}

export global Typography {
    // LINE Seed JP is Horizon's bundled application typeface. The Flatpak
    // builds the pinned upstream font sources and installs the family into
    // /app/share/fonts so Slint/fontconfig always resolves this exact family.
    out property <string> family: "LINE Seed JP";
    out property <string> clock-family: "LINE Seed JP";
    out property <string> game-title-family: "LINE Seed JP";

    out property <length> title-size: 32px;
    out property <length> heading-size: 22px;
    out property <length> body-size: 16px;
    out property <length> caption-size: 13px;
    // Small label above a header value ("Source", "Sort", "Last 7 days").
    out property <length> label-size: 11px;
    out property <length> clock-size: 49px;
    out property <length> clock-suffix-size: 12px;
    out property <length> cover-mark-size: 36px;
    out property <length> cover-caption-size: 10px;

    out property <int> title-weight: 700;
    out property <int> heading-weight: 700;
    out property <int> body-weight: 400;
    out property <int> emphasis-weight: 700;
    // LINE Seed JP has four static weights. Clock uses ExtraBold while
    // emphasized labels/game titles use Bold.
    out property <int> clock-weight: 800;
    out property <int> clock-suffix-weight: 700;
    out property <int> game-title-weight: 700;
}

export global Motion {
    in-out property <bool> reduced-motion: false;

    out property <duration> focus-duration: reduced-motion ? 0ms : 140ms;
    // Peripheral HUD status, not menu focus. No motion with Reduced Motion.
    out property <duration> status-enter-duration: reduced-motion ? 0ms : 220ms;
    out property <duration> status-exit-duration: reduced-motion ? 0ms : 155ms;
    out property <length> status-slide-distance: reduced-motion ? 0px : 7px;

    // Preserve the existing Home game bracket cadence and its accent-derived
    // colour breathing; menu strokes share that same single clock/brush.
    // Unlike alpha-only changes, colour mixing stays visible on opaque surfaces.
    out property <duration> focus-idle-cycle: 3200ms;
    out property <float> focus-idle-highlight-strength: 0.80;
    out property <color> menu-focus-color:
        reduced-motion || Theme.high-contrast ? Theme.focus
        : Theme.focus.mix(Theme.focus-highlight,
            1.0 - focus-idle-highlight-strength
                * (0.5 - 0.5 * cos(animation-tick() / focus-idle-cycle * 360deg)));
    out property <length> game-focus-idle-expansion: 2.2px;
    out property <duration> launch-press-duration: reduced-motion ? 0ms : 90ms;
    out property <duration> launch-release-duration: reduced-motion ? 0ms : 230ms;
    // Playing badges are persistent card overlays. Fade/slide both directions;
    // never tie these presentation timings to the source's session lifecycle.
    out property <duration> playing-pill-enter-duration: reduced-motion ? 0ms : 210ms;
    out property <duration> playing-pill-exit-duration: reduced-motion ? 0ms : 155ms;
    // Fade the stationary text/dot slightly faster than the travelling capsule,
    // so the glyphs are fully settled before the final movement frames.
    out property <duration> playing-pill-label-enter-duration: reduced-motion ? 0ms : 160ms;
    out property <duration> playing-pill-label-exit-duration: reduced-motion ? 0ms : 120ms;
    out property <length> playing-pill-travel: reduced-motion ? 0px : 7px;
    out property <duration> carousel-duration: reduced-motion ? 0ms : 190ms;
    out property <duration> page-duration: reduced-motion ? 0ms : 220ms;
    out property <duration> hover-duration: reduced-motion ? 0ms : 100ms;
    // Changing values (picker labels, counts, the selected game's name) slide
    // and crossfade over this one duration on every page.
    out property <duration> value-swap-duration: reduced-motion ? 0ms : 180ms;
    // Every list and grid camera (components/scroll.slint): linear and
    // slightly under the 115ms input repeat, so held steps join into one
    // continuous movement.
    out property <duration> scroll-duration: reduced-motion ? 0ms : 110ms;
}
