import { Wheel } from "../components/wheel.slint";
import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { FallbackCover } from "../components/fallback-cover.slint";
import { FocusFrame } from "../components/focus-frame.slint";
import { LibraryCardData } from "../models/library.slint";
import { PageHeader, HeaderValue, ScrollEdgeShadow } from "../components/page-header.slint";
import { MarqueeText } from "../components/marquee-text.slint";

// Library is a durable, full-shell destination, never a panel beneath Home chrome.
// Clean, shallow previews reveal collection continuity without a scrollbar.
// Header/footer stay on the SAME Theme.background as the gallery; narrow, soft
// elevation shadows indicate their stationary scroll boundaries without bands.
export component LibraryPage inherits Rectangle {
    in property <[LibraryCardData]> cards;
    // A frozen, bounded snapshot of the previous on-screen cards. The old
    // arrangement must survive replacement of the current VecModel so a
    // source/sort change can genuinely crossfade instead of blinking.
    in property <[LibraryCardData]> previous-cards;
    in property <int> previous-grid-columns: 1;
    in property <int> previous-scroll-row: 0;
    in property <int> previous-selected-index: -1;
    in property <bool> has-previous-grid: false;
    in property <int> selected-index: 0;
    in property <bool> focus-visible: true;
    in property <string> filter-text: "All sources";
    in property <string> sort-text: "Alphabetical";
    in property <int> total-count: 0;
    in property <string> count-text: "0 games";
    in property <int> collection-count: 0;
    in property <string> selected-title: "";
    in property <string> selected-source: "";
    in property <int> grid-columns: 7;
    in property <int> scroll-row: 0;
    in property <int> metadata-sequence: 0;
    in property <int> browse-sequence: 0;
    // 0 = no reorder, 1 = Source, 2 = Sort. The controller sets this
    // before browse-sequence so Slint starts the correct transition.
    in property <int> browse-transition-kind: 0;
    private property <duration> browse-changed-at: 0ms;
    // These animations do not overlap the outgoing and incoming artwork.
    // Source: old grid clears in 85ms, then covers reveal left-to-right
    // (145ms each, 7ms per column), about 230-293ms overall.
    // Sort: old grid fades/shrinks in 95ms, then new grid grows/fades for
    // 140ms. This avoids a prolonged ghosted overlay of two full grids.
    private property <bool> reorder-enabled: !Motion.reduced-motion
        && root.focus-visible && root.browse-sequence != 0
        && root.browse-transition-kind != 0;
    private property <duration> browse-age: animation-tick() - root.browse-changed-at;
    private property <float> outgoing-progress: !root.reorder-enabled || !root.has-previous-grid
        ? 1.0 : min(1.0, max(0.0,
            root.browse-age / (root.browse-transition-kind == 1 ? 85ms : 95ms)));
    private property <float> sort-arrival-progress: !root.reorder-enabled
        ? 1.0 : min(1.0, max(0.0, (root.browse-age - 95ms) / 140ms));
    private property <bool> grid-reordering: root.reorder-enabled && root.browse-age
        < (root.browse-transition-kind == 1 ? 300ms : 235ms);
    changed browse-sequence => { root.browse-changed-at = animation-tick(); }

    // Snapshot the old/new metadata only when Rust publishes a NEW game ID.
    // A sequence signal arrives after both current text properties are updated.
    private property <string> presented-title: "";
    private property <string> presented-source: "";
    private property <string> departing-title: "";
    private property <string> departing-source: "";
    private property <duration> metadata-start: 0ms;
    // Title and provider transition independently. Identical text never flashes.
    private property <float> metadata-linear-progress: Motion.reduced-motion || !root.focus-visible
        ? 1.0 : min(1.0, max(0.0, (animation-tick() - root.metadata-start) / Motion.value-swap-duration));
    private property <float> eased-metadata-progress: 1.0 - (1.0 - root.metadata-linear-progress)
        * (1.0 - root.metadata-linear-progress) * (1.0 - root.metadata-linear-progress);
    private property <float> title-progress: root.departing-title == ""
        || root.departing-title == root.presented-title ? 1.0 : root.eased-metadata-progress;
    private property <float> source-progress: root.departing-source == ""
        || root.departing-source == root.presented-source ? 1.0 : root.eased-metadata-progress;
    changed metadata-sequence => {
        root.departing-title = root.presented-title;
        root.departing-source = root.presented-source;
        root.presented-title = root.selected-title;
        root.presented-source = root.selected-source;
        root.metadata-start = animation-tick();
    }

    callback choose-card(int);
    callback cycle-filter();
    callback cycle-sort();
    callback scroll-rows(int);
    background: Theme.background;

    // Width bands are mirrored exactly in Rust GridLayout::for_width().
    // Do not scale down covers just to squeeze seven/eight columns into a
    // Switch-sized viewport; larger tiles and a calmer column count win.
    private property <length> card-size: root.width < 800px ? 132px
        : root.width < 1100px ? 156px
        : root.width < 1450px ? 180px
        : root.width < 2200px ? 206px
        : root.width < 3000px ? 218px : 226px;
    private property <length> card-stride: root.card-size + 28px;
    private property <length> row-stride: root.card-size + 28px;
    private property <length> art-inset: root.card-size * 0.085;
    private property <length> grid-pad: 22px;
    private property <length> top-content-inset: Metrics.page-header-height;
    private property <length> bottom-content-reserve: Metrics.page-bottom-bar-height;
    // Keep exact parity with Rust LibraryController::visible_rows().
    private property <int> displayed-rows: max(1, Math.floor(
        (root.height - root.top-content-inset - root.bottom-content-reserve
            - 2 * root.grid-pad + (root.row-stride - root.card-size)) / root.row-stride));
    private property <length> grid-height: root.grid-pad * 2
        + root.displayed-rows * root.row-stride - (root.row-stride - root.card-size);
    private property <int> total-rows: max(0,
        Math.floor((root.total-count + root.grid-columns - 1) / root.grid-columns));
    // Mirror the gallery's continuation at BOTH ends. The cover preview is
    // deliberately clean-cropped rather than fading into a muddy dark overlay.
    // Keep the full-row calculation identical to LibraryController::visible_rows.
    private property <length> available-grid-height:
        root.height - root.top-content-inset - root.bottom-content-reserve;
    private property <length> peek-limit:
        min(54px, max(0px, (root.available-grid-height - root.grid-height) / 2 - 8px));

    // Compact top chrome: title/count stay legible, but the collection gets
    // the recovered vertical room. Elevation is drawn at the boundary BELOW,
    // not as a separately painted header slab.

    PageHeader {
        width: parent.width;
        title: "Library";
        // Non-focusable values; LB/RB cycle Source and Sort for controllers.
        HorizontalLayout {
            // Right-aligned so each value's text edge meets the page margin.
            width: 130px + 160px + 180px + Metrics.spacing-sm * 2;
            x: parent.width - Metrics.page-margin - self.width + Metrics.spacing-sm + 2px;
            y: Metrics.page-accessory-y;
            height: Metrics.page-accessory-height;
            spacing: Metrics.spacing-sm;
            HeaderValue { width: 130px; label: "Collection"; value: root.count-text; }
            HeaderValue {
                width: 160px; label: "Source"; value: root.filter-text;
                interactive: true;
                clicked => { root.cycle-filter(); }
            }
            HeaderValue {
                width: 180px; label: "Sort"; value: root.sort-text;
                interactive: true;
                clicked => { root.cycle-sort(); }
            }
        }
    }

    if root.collection-count == 0 : Text {
        x: Metrics.page-margin; y: root.height / 2;
        width: parent.width - Metrics.page-margin * 2;
        horizontal-alignment: center;
        text: "No games found. Install games in Steam or Heroic, then refresh your library.";
        color: Theme.secondary-foreground; font-size: Typography.body-size;
    }
    if root.collection-count > 0 && root.total-count == 0 : Text {
        x: Metrics.page-margin; y: root.height / 2;
        width: parent.width - Metrics.page-margin * 2;
        horizontal-alignment: center;
        text: "No games match this source.";
        color: Theme.secondary-foreground; font-size: Typography.body-size;
    }

    grid-viewport := Rectangle {
        x: Metrics.page-margin - 16px;
        // Stable viewport geometry: scrolling never shifts the clipping edges.
        // At the beginning/end, the unused peek simply becomes empty space.
        // Keep gallery slightly higher than dead-centre, especially in
        // windows where only two full rows fit.
        y: root.top-content-inset + max(0px,
            (root.available-grid-height - root.grid-height) / 2 - 18px) - root.peek-limit;
        width: parent.width - (Metrics.page-margin - 16px) * 2;
        height: root.grid-height + 2 * root.peek-limit;
        background: transparent;
        clip: true;

        TouchArea {
            width: parent.width; height: parent.height;
            scroll-event(event) => {
                if event.delta-y != 0px {
                    root.scroll-rows(Wheel.rows(event.delta-y));
                    return accept;
                }
                reject
            }
        }

        // Outgoing grid: one frozen overscan window at the previous scroll
        // offset. No pointer targets, no sliding brackets, and no model updates
        // after the transition begins. It disappears automatically as the
        // timeline reaches its end (or immediately for Reduced Motion).
        if root.has-previous-grid && root.outgoing-progress < 1.0 : Rectangle {
            width: root.previous-grid-columns * root.card-stride
                - (root.card-stride - root.card-size) + 2 * root.grid-pad;
            x: max(0px, (parent.width - self.width) / 2);
            y: root.peek-limit - root.previous-scroll-row * root.row-stride;
            height: parent.height;
            opacity: 1.0 - root.outgoing-progress;
            background: transparent;
            for old[index] in root.previous-cards : Rectangle {
                x: root.grid-pad + Math.mod(old.absolute-index, root.previous-grid-columns) * root.card-stride;
                y: root.grid-pad + Math.floor(old.absolute-index / root.previous-grid-columns) * root.row-stride;
                width: root.card-size; height: root.card-size;
                background: transparent;
                private property <bool> was-selected:
                    root.previous-selected-index == old.absolute-index;
                old-shell := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.card-size * (parent.was-selected ? Metrics.game-selected-scale : 1.0)
                        * (root.browse-transition-kind == 2 ? 1.0 - 0.04 * root.outgoing-progress : 1.0);
                    height: root.card-size * (parent.was-selected ? Metrics.game-selected-scale : 1.0)
                        * (root.browse-transition-kind == 2 ? 1.0 - 0.04 * root.outgoing-progress : 1.0);
                    border-radius: root.card-size * (20.0 / 148.0);
                    background: Theme.surface-raised;
                    border-width: Theme.high-contrast ? 2px : 1px;
                    border-color: Theme.high-contrast ? Theme.foreground : Theme.divider.with-alpha(0.42);
                    drop-shadow-offset-y: parent.was-selected ? 5px : 3px;
                    drop-shadow-blur: parent.was-selected ? 16px : 11px;
                    drop-shadow-color: Theme.shadow.with-alpha(parent.was-selected ? 0.90 : 0.68);
                    Rectangle {
                        x: root.art-inset; y: root.art-inset;
                        width: parent.width - 2 * root.art-inset;
                        height: parent.height - 2 * root.art-inset;
                        border-radius: root.card-size * (12.0 / 148.0);
                        clip: true; background: transparent;
                        if old.game.has-artwork : Image {
                            width: parent.width; height: parent.height;
                            source: old.game.artwork;
                            image-fit: contain;
                            image-rendering: old.game.pixelated-artwork ? pixelated : smooth;
                        }
                        if !old.game.has-artwork : FallbackCover {
                            width: parent.width; height: parent.height;
                            game: old.game;
                        }
                    }
                }
                // The outgoing focus outline follows the outgoing shell too.
                // Keep the exact Home bracket geometry while Sort shrinks it.
                FocusFrame {
                    x: old-shell.x - Metrics.focus-offset;
                    y: old-shell.y - Metrics.focus-offset;
                    width: old-shell.width + Metrics.focus-offset * 2;
                    height: old-shell.height + Metrics.focus-offset * 2;
                    active: root.focus-visible && parent.was-selected;
                    opacity: parent.was-selected ? 1.0 : 0.0;
                }
            }
        }

        gallery := Rectangle {
            width: root.grid-columns * root.card-stride - (root.card-stride - root.card-size) + 2 * root.grid-pad;
            x: max(0px, (parent.width - self.width) / 2);
            y: root.peek-limit - (root.scroll-row * root.row-stride);
            height: max(1, Math.floor((root.total-count + root.grid-columns - 1) / root.grid-columns))
                * root.row-stride + 2 * root.grid-pad;
            background: transparent;
            // Incoming artwork animates per cover instead of fading an entire
            // model at once. Row-to-row navigation retains Home camera easing.
            animate y {
                duration: root.grid-reordering ? 0ms : Motion.carousel-duration;
                easing: ease-out;
            }

            for row[index] in root.cards : Rectangle {
                // Source staggers by column, irrespective of virtualized rows.
                // Express the 7ms delay as a dimensionless fraction of 145ms;
                // this keeps the duration arithmetic accepted by Slint 1.18.
                private property <float> reveal-linear: !root.reorder-enabled ? 1.0
                    : root.browse-transition-kind == 1
                    ? min(1.0, max(0.0, (root.browse-age - 85ms) / 145ms
                        - Math.mod(row.absolute-index, root.grid-columns) * (7.0 / 145.0)))
                    : root.sort-arrival-progress;
                private property <float> reveal-eased: 1.0 - (1.0 - self.reveal-linear)
                    * (1.0 - self.reveal-linear) * (1.0 - self.reveal-linear);
                private property <float> reveal-size: (root.browse-transition-kind == 1 ? 0.97 : 0.96)
                    + (root.browse-transition-kind == 1 ? 0.03 : 0.04) * self.reveal-eased;
                x: root.grid-pad + Math.mod(row.absolute-index, root.grid-columns) * root.card-stride;
                y: root.grid-pad + Math.floor(row.absolute-index / root.grid-columns) * root.row-stride
                    + (root.browse-transition-kind == 1 ? 6px * (1.0 - self.reveal-eased) : 0px);
                width: root.card-size; height: root.card-size;
                background: transparent;
                opacity: self.reveal-eased;
                clip: false;
                private property <bool> selected: root.focus-visible
                    && root.selected-index == row.absolute-index;
                private property <float> card-scale: self.selected ? Metrics.game-selected-scale : 1.0;

                // Selection size and focus outline now both follow Home's
                // 1.10x focus rhythm instead of a separate 1.045x grid rule.
                // The same two-layer Home cover composition: a rounded shell
                // surrounding inset art, rather than edge-to-edge cover squares.
                shell := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.card-size * parent.card-scale * parent.reveal-size;
                    height: root.card-size * parent.card-scale * parent.reveal-size;
                    border-radius: root.card-size * (20.0 / 148.0);
                    background: Theme.surface-raised;
                    border-width: Theme.high-contrast ? 2px : 1px;
                    border-color: Theme.high-contrast ? Theme.foreground : Theme.divider.with-alpha(0.42);
                    drop-shadow-offset-y: parent.selected ? 5px : 3px;
                    drop-shadow-blur: parent.selected ? 16px : 11px;
                    drop-shadow-color: Theme.shadow.with-alpha(parent.selected ? 0.90 : 0.68);
                    // Per-card reveal already drives width/height. Disabling
                    // implicit animation during a reorder avoids double easing;
                    // normal Home-style focus lifting remains animated.
                    animate width, height {
                        duration: root.grid-reordering ? 0ms : Motion.focus-duration;
                        easing: ease-out;
                    }

                    artwork := Rectangle {
                        x: root.art-inset; y: root.art-inset;
                        width: parent.width - 2 * root.art-inset;
                        height: parent.height - 2 * root.art-inset;
                        background: transparent;
                        border-radius: root.card-size * (12.0 / 148.0);
                        clip: true;
                        if row.game.has-artwork : Image {
                            width: parent.width; height: parent.height;
                            source: row.game.artwork;
                            image-fit: contain;
                            image-rendering: row.game.pixelated-artwork ? pixelated : smooth;
                        }
                        if !row.game.has-artwork : FallbackCover {
                            width: parent.width; height: parent.height;
                            game: row.game;
                        }
                    }
                }
                // As on Home, each cover owns its focus brackets; newly
                // selected brackets fade in in-place rather than sliding between
                // arbitrary grid positions or diagonally across row boundaries.
                FocusFrame {
                    // Home's frame is attached to the scaling tile, not its
                    // fixed navigation slot. Keep the same 9px token gap and
                    // original 1x bracket paths/stroke through both motions.
                    x: shell.x - Metrics.focus-offset;
                    y: shell.y - Metrics.focus-offset;
                    width: shell.width + Metrics.focus-offset * 2;
                    height: shell.height + Metrics.focus-offset * 2;
                    active: parent.selected;
                    opacity: parent.selected ? 1.0 : 0.0;
                    animate opacity { duration: Motion.focus-duration; easing: ease-in-out; }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    // Peeking rows signal vertical continuation; they are not
                    // interactive until the camera brings them fully into view.
                    enabled: row.absolute-index >= root.scroll-row * root.grid-columns
                        && row.absolute-index < (root.scroll-row + root.displayed-rows) * root.grid-columns;
                    clicked => { root.choose-card(row.absolute-index); }
                    scroll-event(event) => {
                        if event.delta-y != 0px {
                            root.scroll-rows(Wheel.rows(event.delta-y));
                            return accept;
                        }
                        reject
                    }
                }
            }

        }

    }

    // Scroll-edge elevation follows the ANIMATED camera (gallery.y): the top
    // shadow appears once a row has passed under the header, the bottom one
    // while more rows remain below. None when everything is in view.
    if root.total-count > 0 : ScrollEdgeShadow {
        x: 0px; y: grid-viewport.y;
        width: parent.width;
        strength: (root.peek-limit - gallery.y) / root.row-stride;
    }
    // Bottom-bar chrome (this shadow, the selected game) switches with the
    // route like the hint bar instead of crossfading into Home's footer.
    if root.total-count > 0 && root.focus-visible : ScrollEdgeShadow {
        x: 0px; y: grid-viewport.y + grid-viewport.height - self.height;
        width: parent.width;
        bottom: true;
        strength: (gallery.y + gallery.height - grid-viewport.height + root.peek-limit) / root.row-stride;
    }

    // Bottom bar, left side: the selected game. The hint bar (app.slint)
    // owns the right side. Title and source swap independently; unchanged
    // strings stay still. The selected identity/revision is owned by Rust.
    title-window := Rectangle {
        visible: root.focus-visible;
        x: Metrics.page-margin;
        // Title on the shared hint line; source directly below it.
        y: root.height - Metrics.hint-row-center-from-bottom - self.height / 2;
        width: (parent.width - Metrics.page-margin * 2) / 2;
        height: 28px; clip: true; background: transparent;
        if root.title-progress < 1.0 : MarqueeText {
            y: -6px * root.title-progress;
            width: parent.width; height: parent.height;
            text: root.total-count > 0 ? root.departing-title : "";
            font-weight: Typography.emphasis-weight;
            opacity: 1.0 - root.title-progress;
        }
        MarqueeText {
            y: 6px * (1.0 - root.title-progress);
            width: parent.width; height: parent.height;
            text: root.total-count > 0 ? root.presented-title : "";
            font-weight: Typography.emphasis-weight;
            active: root.focus-visible;
            opacity: root.title-progress;
        }
    }
    source-window := Rectangle {
        visible: root.focus-visible;
        x: Metrics.page-margin;
        y: title-window.y + title-window.height;
        width: title-window.width;
        height: 22px; clip: true; background: transparent;
        Text {
            y: -4px * root.source-progress;
            width: parent.width; height: parent.height;
            text: root.total-count > 0 ? root.departing-source : "";
            color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
            vertical-alignment: center;
            opacity: 1.0 - root.source-progress;
        }
        Text {
            y: 4px * (1.0 - root.source-progress);
            width: parent.width; height: parent.height;
            text: root.total-count > 0 ? root.presented-source : "";
            color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
            vertical-alignment: center;
            opacity: root.source-progress;
        }
    }
}
