import { Theme, Metrics } from "../theme/theme.slint";
import { GameCardData } from "../models/game-card.slint";
import { GameCarousel } from "../components/game-carousel.slint";

// Home is now a routed content page. Persistent header/footer chrome lives in
// AppWindow; the carousel keeps its established design-space Y coordinates by
// subtracting the shell's top inset here.
export component HomePage inherits Rectangle {
    in property <[GameCardData]> games;
    in property <int> selected-index: 0;
    in property <string> selected-title;
    in property <bool> focus-visible: true;
    callback select-game(int);
    callback carousel-geometry-changed(float);

    background: Theme.background;

    GameCarousel {
        x: 0px;
        y: Metrics.selected-label-y - Metrics.top-chrome-height;
        width: parent.width;
        height: Metrics.carousel-shelf-y
            + Metrics.carousel-shelf-height
            - Metrics.selected-label-y;
        games: root.games;
        selected-index: root.selected-index;
        selected-title: root.selected-title;
        focus-visible: root.focus-visible;
        game-selected(index) => { root.select-game(index); }
        geometry-changed(first-game-center-x-px) => {
            root.carousel-geometry-changed(first-game-center-x-px);
        }
    }
}
