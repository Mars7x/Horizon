import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { GameCardData, CardRect } from "../models/game-card.slint";
import { ModalDialog } from "modal-dialog.slint";
import { FallbackCover } from "fallback-cover.slint";
import { ActionButton } from "action-button.slint";
import { ListRow, Surface } from "list-row.slint";
import { HintBar } from "hint-bar.slint";
import { ModRow } from "../models/mods.slint";

// Floating game commands; details, saves and mods use shared dialogs.
// Rust chooses placement, identity, focus and operations. The page stays visible.
export component GameContextMenu inherits Rectangle {
    in property <bool> open: false;
    in property <length> area-width;
    in property <length> area-height;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <GameCardData> game;
    in property <int> view: 0;
    in property <int> selected: 0;
    in property <bool> hidden-game: false;
    in property <bool> busy: false;
    in property <string> message;
    in property <string> details;
    in property <length> details-offset;
    in property <[ModRow]> mods;
    out property <length> max-details-offset: max(0px, properties.preferred-height - 330px);
    out property <CardRect> popup-rect: { x: popup.x / 1px, y: popup.y / 1px, width: popup.width / 1px, height: popup.height / 1px };
    callback choose(int);
    callback hover-row(int);
    callback back();
    callback scroll(int);
    width: root.area-width; height: root.area-height;
    visible: root.open || popup.opacity > 0.01 || properties-dialog.opacity > 0.01 || error-dialog.opacity > 0.01 || saves-dialog.opacity > 0.01 || mods-dialog.opacity > 0.01;
    background: transparent;
    private property <length> popup-rise: root.open && root.view == 0 ? 0px : Motion.dialog-rise / 2;
    animate popup-rise { duration: Motion.dialog-duration; easing: ease-out; }

    // Dismiss without activating anything on the page behind the menu.
    TouchArea {
        width: parent.width; height: parent.height;
        visible: popup.visible;
        clicked => { root.back(); }
        pointer-event(event) => { if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) { root.back(); } }
    }
    popup := Surface {
        x: root.anchor-x;
        y: root.anchor-y + root.popup-rise;
        width: min(Metrics.game-context-width, root.area-width - Metrics.spacing-xl);
        height: min(root.area-height - Metrics.spacing-xl, Metrics.game-context-height);
        opacity: root.open && root.view == 0 ? 1.0 : 0.0;
        visible: (root.open && root.view == 0) || self.opacity > 0.01;
        animate opacity { duration: Motion.dialog-duration; easing: ease-out; }
        background: Theme.surface-raised;
        drop-shadow-color: Theme.shadow.with-alpha(Theme.is-dark ? 0.42 : 0.18);
        drop-shadow-blur: 20px; drop-shadow-offset-y: 5px;
        for label[index] in ["Manage save data", "Manage mods", "Game properties", root.hidden-game ? "Unhide game" : "Hide game", "Uninstall game"] : ListRow {
            x: Metrics.spacing-sm;
            y: Metrics.spacing-sm + index * (Metrics.compact-row-height + Metrics.spacing-xs) + (index == 4 ? Metrics.spacing-sm : 0px);
            width: parent.width - Metrics.spacing-md;
            compact: true;
            title: label;
            trailing-width: Metrics.spacing-lg;
            focused: root.selected == index;
            enabled: root.open && !root.busy && root.view == 0;
            hovered => { root.hover-row(index); }
            activated => { root.choose(index); }
        }
        Rectangle { x: Metrics.spacing-md; y: Metrics.spacing-sm + 4 * (Metrics.compact-row-height + Metrics.spacing-xs); width: parent.width - Metrics.spacing-xl; height: 1px; background: Theme.divider; }
    }
    saves-dialog := ModalDialog {
        area-width: root.area-width; area-height: root.area-height;
        open: root.open && root.view == 4;
        card-width: 504px; card-height: 464px;
        dismissed => { root.back(); }
        Text {
            x: Metrics.spacing-lg; y: Metrics.spacing-lg;
            width: parent.width - Metrics.spacing-xxl; height: 28px;
            text: "Manage save data"; color: Theme.foreground;
            font-size: Typography.heading-size; font-weight: Typography.heading-weight;
        }
        Text {
            x: Metrics.spacing-lg; y: 58px;
            width: parent.width - Metrics.spacing-xxl; height: 50px;
            text: root.game.title + "\nBattery save, save states and automatic resume";
            color: Theme.secondary-foreground; font-size: Typography.caption-size;
            wrap: word-wrap; overflow: elide;
        }
        Surface {
            x: Metrics.spacing-lg; y: 120px;
            width: parent.width - Metrics.spacing-xxl; height: 220px;
            for label[index] in ["Open save file location", "Back up save data", "Delete save data", "Back"] : ListRow {
                x: Metrics.spacing-sm;
                y: Metrics.spacing-xs + index * (Metrics.compact-row-height + Metrics.spacing-xs);
                width: parent.width - Metrics.spacing-md;
                compact: true; title: label; trailing-width: Metrics.spacing-lg;
                focused: root.selected == index;
                enabled: root.open && root.view == 4 && !root.busy;
                hovered => { root.hover-row(index); }
                activated => { root.choose(index); }
            }
        }
        Text {
            x: Metrics.spacing-lg; y: 356px;
            width: parent.width - Metrics.spacing-xxl; height: 84px;
            text: root.message == "" ? "Backups stay in this game's save folder. Deleting save data requires confirmation." : root.message;
            color: Theme.secondary-foreground; font-size: Typography.caption-size;
            wrap: word-wrap; overflow: elide;
        }
    }
    mods-dialog := ModalDialog {
        area-width: root.area-width; area-height: root.area-height;
        open: root.open && root.view == 6;
        card-width: 504px; card-height: 500px;
        dismissed => { root.back(); }
        private property <length> step: Metrics.compact-row-height + Metrics.spacing-xs;
        // Rows past the fifth scroll into view with the selection.
        private property <length> scroll: max(0, min(root.selected - 4, root.mods.length + 2 - 5)) * self.step;
        Text {
            x: Metrics.spacing-lg; y: Metrics.spacing-lg;
            width: parent.width - Metrics.spacing-xxl; height: 28px;
            text: "Mods"; color: Theme.foreground;
            font-size: Typography.heading-size; font-weight: Typography.heading-weight;
        }
        Text {
            x: Metrics.spacing-lg; y: 58px;
            width: parent.width - Metrics.spacing-xxl; height: 50px;
            text: root.game.title + "\nMods that are on apply when the game starts";
            color: Theme.secondary-foreground; font-size: Typography.caption-size;
            wrap: word-wrap; overflow: elide;
        }
        Surface {
            x: Metrics.spacing-lg; y: 120px;
            width: parent.width - Metrics.spacing-xxl; height: 5 * step + Metrics.spacing-xs;
            clip: true;
            for row[index] in root.mods : ListRow {
                x: Metrics.spacing-sm;
                y: Metrics.spacing-xs + index * step - scroll;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
                width: parent.width - Metrics.spacing-md;
                compact: true; title: row.title; trailing-width: 72px;
                focused: root.selected == index;
                enabled: root.open && root.view == 6 && !root.busy;
                hovered => { root.hover-row(index); }
                activated => { root.choose(index); }
                Text {
                    x: parent.width - 72px; width: 56px; height: parent.height;
                    horizontal-alignment: right; vertical-alignment: center;
                    text: row.enabled ? "On" : "Off";
                    color: row.enabled ? Theme.foreground : Theme.secondary-foreground;
                    font-size: Typography.body-size; font-weight: Typography.emphasis-weight;
                }
            }
            for label[index] in ["Open mods folder", "Back"] : ListRow {
                x: Metrics.spacing-sm;
                y: Metrics.spacing-xs + (root.mods.length + index) * step - scroll;
                animate y { duration: Motion.focus-duration; easing: ease-in-out; }
                width: parent.width - Metrics.spacing-md;
                compact: true; title: label; trailing-width: Metrics.spacing-lg;
                focused: root.selected == root.mods.length + index;
                enabled: root.open && root.view == 6 && !root.busy;
                hovered => { root.hover-row(root.mods.length + index); }
                activated => { root.choose(root.mods.length + index); }
            }
        }
        Text {
            x: Metrics.spacing-lg; y: 396px;
            width: parent.width - Metrics.spacing-xxl; height: 84px;
            text: root.message;
            color: Theme.secondary-foreground; font-size: Typography.caption-size;
            wrap: word-wrap; overflow: elide;
        }
    }
    error-dialog := ModalDialog {
        area-width: root.area-width; area-height: root.area-height;
        open: root.open && root.view == 3;
        card-height: 232px;
        dismissed => { root.back(); }
        Text {
            x: Metrics.spacing-lg; y: Metrics.spacing-lg;
            width: parent.width - Metrics.spacing-xxl; height: 116px;
            text: root.message; color: Theme.foreground;
            font-size: Typography.body-size; wrap: word-wrap;
        }
        ActionButton {
            x: parent.width - 124px; y: parent.height - 60px; width: 100px; height: 36px;
            label: "Close"; enabled: root.open && root.view == 3;
            activated => { root.back(); }
        }
    }
    properties-dialog := ModalDialog {
        area-width: root.area-width; area-height: root.area-height;
        open: root.open && root.view == 1;
        card-width: 504px; card-height: 582px;
        dismissed => { root.back(); }
    Rectangle {
        x: 24px; y: 24px; width: 64px; height: 64px;
        border-radius: Metrics.radius-md; clip: true;
        FallbackCover { width: parent.width; height: parent.height; typography-scale: 0.32; game: root.game; visible: !root.game.has-artwork; }
        Image { width: parent.width; height: parent.height; source: root.game.artwork; image-fit: cover; visible: root.game.has-artwork; }
    }
    menu-title := Text {
        x: 104px; y: 24px + max(0px, (64px - self.height - 26px) / 2);
        width: parent.width - 128px; height: min(48px, self.preferred-height);
        text: root.game.title; color: Theme.foreground;
        font-size: Typography.body-size; font-weight: Typography.heading-weight;
        wrap: word-wrap; overflow: elide;
    }
    Text {
        x: 104px; y: menu-title.y + menu-title.height + 6px; width: parent.width - 128px; height: 20px;
        text: root.view == 1 ? "Game properties" : root.game.platform;
        color: Theme.secondary-foreground; font-size: Typography.caption-size;
    }
    Rectangle { x: 24px; y: 108px; width: parent.width - 48px; height: 1px; background: Theme.divider; }
    Rectangle {
        x: 28px; y: 128px; width: parent.width - 56px; height: 330px; clip: true;
        properties := Text {
            y: -root.details-offset;
            width: parent.width;
            text: root.details; wrap: word-wrap;
            color: Theme.foreground; font-size: Typography.body-size;
        }
        TouchArea {
            width: parent.width; height: parent.height;
            scroll-event(event) => { if (event.delta-y != 0px) { root.scroll(event.delta-y < 0px ? 1 : -1); return accept; } reject }
        }
    }
        Text {
            x: 28px; y: 466px; width: parent.width - 56px; height: 44px;
            text: root.message;
            color: Theme.secondary-foreground; font-size: Typography.caption-size; wrap: word-wrap;
        }
        HintBar {
            x: 28px; y: parent.height - 48px; width: 260px; height: 22px;
            hints: [{ button: "B", label: "Close" }];
            activated(button) => { root.back(); }
        }
        ActionButton {
            x: parent.width - 124px; y: parent.height - 58px; width: 100px; height: 36px;
            label: "Close"; enabled: root.open && root.view == 1;
            activated => { root.back(); }
        }
    }
}
