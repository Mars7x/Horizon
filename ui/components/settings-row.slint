import { Theme, Typography, Motion } from "../theme/theme.slint";
import { ValueText } from "value-text.slint";
import { ListRow } from "list-row.slint";

// An option row (Settings, Profile): the shared ListRow plus a trailing
// action label or a switch. Selection and persistence remain Rust-owned so
// mouse and controller agree.
//
// `secondary` ("Remove", "Disconnect") adds a small button before the
// trailing label, for undoing what the row sets. It is the X button's job on
// a controller (the page shows "X Remove" in its hints); a click calls
// `secondary-activated`.
export component SettingsRow inherits ListRow {
    in property <string> trailing: "";
    in property <bool> value-forward: true;
    in property <bool> toggle: false;
    in property <bool> checked: false;
    in property <string> secondary: "";
    callback secondary-activated();
    trailing-width: root.toggle ? 130px : root.secondary != "" ? 360px : 230px;
    accessible-checkable: root.toggle;
    accessible-checked: root.checked;

    trailing-text := ValueText {
        visible: !root.toggle;
        x: parent.width - 224px; y: root.compact ? (parent.height - self.height) / 2 : 12px;
        width: 196px; height: 30px;
        text: root.trailing;
        forward: root.value-forward; active: root.focused; edge-color: root.surface-color;
        text-color: root.enabled ? (root.focused ? Theme.accent : Theme.secondary-foreground)
            : Theme.secondary-foreground;
        font-size: Typography.body-size;
        font-weight: Typography.emphasis-weight;
        horizontal-alignment: right;
    }
    // The track's colour and the knob's travel change together, over the
    // value-swap duration. No native-widget styling leaks into Horizon, and
    // the whole row remains one controller/pointer target.
    Rectangle {
        visible: root.toggle;
        x: parent.width - 94px; y: (parent.height - 34px) / 2;
        width: 62px; height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.divider;
        background: root.checked ? Theme.accent : Theme.divider;
        animate background, border-color { duration: Motion.value-swap-duration; easing: ease-in-out; }
        Rectangle {
            x: root.checked ? parent.width - 30px : 4px;
            y: 4px; width: 26px; height: 26px;
            border-radius: 13px;
            background: #ffffff; // Consistently white thumb in both states.
            animate x { duration: Motion.value-swap-duration; easing: ease-out; }
        }
    }
    if root.secondary != "" && !root.toggle : Rectangle {
        width: secondary-label.preferred-width + 28px;
        height: 32px;
        x: trailing-text.x + trailing-text.width - trailing-text.text-width - self.width - 16px;
        y: trailing-text.y + (trailing-text.height - self.height) / 2;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.divider;
        background: secondary-touch.pressed ? Theme.surface-raised.darker(0.06)
            : secondary-touch.has-hover ? Theme.surface-raised : Theme.surface;
        animate background { duration: Motion.hover-duration; easing: ease-in-out; }
        accessible-role: button;
        accessible-label: root.secondary;
        secondary-label := Text {
            width: parent.width; height: parent.height;
            text: root.secondary;
            color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
            font-weight: Typography.emphasis-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        secondary-touch := TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.secondary-activated(); }
        }
    }
}
