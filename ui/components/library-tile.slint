import { Theme, Metrics, Motion } from "../theme/theme.slint";
import { FocusFrame } from "focus-frame.slint";

// A destination at the end of Home's world-space row, not a fabricated game.
// Keep the original game focus frame and its animations completely unchanged.
export component LibraryTile inherits Rectangle {
    in property <bool> selected: false;
    in property <bool> focus-visible: true;
    callback activated();

    width: Metrics.game-stride;
    height: Metrics.game-slot-height;
    background: transparent;
    z: root.selected ? 2.0 : 1.0;

    visual := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Metrics.game-tile-size * (root.selected ? Metrics.game-selected-scale : 1.0);
        height: Metrics.game-tile-size * (root.selected ? Metrics.game-selected-scale : 1.0);
        background: transparent;
        animate width { duration: Motion.focus-duration; easing: ease-out; }
        animate height { duration: Motion.focus-duration; easing: ease-out; }

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: Metrics.game-shell-radius;
            background: Theme.surface-raised;
            border-width: Theme.high-contrast ? 2px : 1px;
            border-color: Theme.divider;

            Rectangle {
                x: Metrics.game-art-inset;
                y: Metrics.game-art-inset;
                width: parent.width - (Metrics.game-art-inset * 2);
                height: parent.height - (Metrics.game-art-inset * 2);
                border-radius: Metrics.cover-radius;
                background: Theme.surface;

                // System destination, not cover artwork: one centered 2×2 grid
                // with no duplicate title, pattern, tint or extra focus outline.
                // The shared Home title pill supplies the Library label.
                for tile[index] in [0, 1, 2, 3] : Rectangle {
                    x: (parent.width - 82px) / 2 + (index == 1 || index == 3 ? 1 : 0) * 46px;
                    y: (parent.height - 82px) / 2 + (index >= 2 ? 1 : 0) * 46px;
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: Theme.foreground.with-alpha(0.82);
                }
            }
        }

        FocusFrame {
            active: root.selected && root.focus-visible;
            x: -Metrics.focus-offset;
            y: -Metrics.focus-offset;
            width: parent.width + Metrics.focus-offset * 2;
            height: parent.height + Metrics.focus-offset * 2;
            opacity: root.selected && root.focus-visible ? 1 : 0;
            animate opacity { duration: Motion.focus-duration; easing: ease-in-out; }
        }
    }
    TouchArea { clicked => { root.activated(); } }
}
