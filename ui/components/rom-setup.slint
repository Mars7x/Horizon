import { ModalDialog } from "modal-dialog.slint";
import { ActionButton } from "action-button.slint";
import { Theme, Metrics, Typography } from "../theme/theme.slint";

export component RomSetupDialog inherits ModalDialog {
    in property <string> title;
    in property <string> detail;
    in property <[string]> labels;
    in property <int> focused;
    in property <bool> busy;
    callback choose(int);
    card-width: 480px;
    card-height: root.labels.length > 1 ? 296px : root.labels.length == 1 ? 240px : 196px;
    VerticalLayout {
        padding: Metrics.spacing-lg;
        spacing: Metrics.spacing-sm;
        Text {
            text: root.title;
            color: Theme.foreground;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
            min-height: 36px;
        }
        Text {
            text: root.detail;
            color: Theme.secondary-foreground;
            font-size: Typography.body-size;
            wrap: word-wrap;
            overflow: elide;
            min-height: 64px;
            vertical-stretch: 1;
        }
        for button-label[index] in root.labels: ActionButton {
            label: button-label;
            height: 40px;
            focused: root.focused == index;
            enabled: !root.busy;
            activated => { root.choose(index); }
        }
    }
}
