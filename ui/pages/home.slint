import { Theme, Metrics } from "../theme/theme.slint";
import { GameCardData } from "../models/game-card.slint";
import { GameCarousel } from "../components/game-carousel.slint";


// Home is now a routed content page. Persistent header/footer chrome lives in
// AppWindow; the carousel keeps its established design-space Y coordinates by
// subtracting the shell's top inset here.
export component HomePage inherits Rectangle {
    in property <[GameCardData]> games;
    in property <int> selected-index: 0;
    in property <string> selected-title;
    in property <int> launching-game-index: -1;
    in property <string> launch-feedback-text;
    in property <bool> focus-visible: true;
    callback select-game(int);
    callback open-library();
    callback carousel-geometry-changed(float);

    background: Theme.background;

    // Beneath the carousel, so tiles keep their clicks; scroll events they
    // don't take land here. Horizontal scrolling pans the carousel's camera
    // only, never the selection.
    TouchArea {
        width: parent.width; height: parent.height;
        scroll-event(event) => {
            if event.delta-x != 0px {
                carousel.pan(event.delta-x);
                return accept;
            }
            reject
        }
    }

    // A finger (or mouse) dragging sideways pans the shelf, even starting on
    // a game: once the drag is clearly sideways the handler takes it from the
    // tile, so a tap still selects. Focus never moves.
    swipe := SwipeGestureHandler {
        x: 0px;
        y: Metrics.selected-label-y - Metrics.top-chrome-height;
        width: parent.width;
        height: Metrics.carousel-shelf-y
            + Metrics.carousel-shelf-height
            - Metrics.selected-label-y;
        handle-swipe-left: true;
        handle-swipe-right: true;
        property <bool> dragging: false;
        moved => {
            if !self.dragging {
                self.dragging = true;
                carousel.drag-begin(self.current-position.x - self.pressed-position.x);
            }
            carousel.drag-to(self.current-position.x - self.pressed-position.x);
        }
        swiped => { self.dragging = false; carousel.drag-end(); }
        cancelled => { self.dragging = false; carousel.drag-end(); }

        carousel := GameCarousel {
            width: parent.width;
            height: parent.height;
            games: root.games;
            selected-index: root.selected-index;
            selected-title: root.selected-title;
            launching-game-index: root.launching-game-index;
            launch-feedback-text: root.launch-feedback-text;
            focus-visible: root.focus-visible;
            game-selected(index) => { root.select-game(index); }
            open-library => { root.open-library(); }
            geometry-changed(first-game-center-x-px) => {
                root.carousel-geometry-changed(first-game-center-x-px);
            }
        }
    }

}
