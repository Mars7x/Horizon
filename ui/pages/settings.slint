import { InputGlyphs, GlyphFamily } from "../components/hint-bar.slint";
import { ValueText } from "../components/value-text.slint";
import { ControllerBindingRow } from "../models/controller.slint";
import { Theme, Metrics, Typography, Motion } from "../theme/theme.slint";
import { SelectionFocusSurface } from "../components/selection-focus-surface.slint";
import { ListRow } from "../components/list-row.slint";
import { PageHeader, Breadcrumb } from "../components/page-header.slint";
import { MarqueeText } from "../components/marquee-text.slint";
import { TransitionDriver, TransitionLayer } from "../components/transition.slint";
import { ActionButton as SettingsButton } from "../components/action-button.slint";
import { ModalDialog } from "../components/modal-dialog.slint";
import { SettingsRow } from "../components/settings-row.slint";
import { ConfirmDialog } from "../components/confirm-dialog.slint";
import { KeyboardButton } from "../components/on-screen-keyboard.slint";

// Shared button component for dialog and back navigation.
// A saved Theme preference is expressed by accent-coloured text, not an
// additional checked border or checkmark. The ONLY border highlight is focus.
component AppearanceChoice inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> focused: false;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.selected ? "Selected" : "Select";
    private property <float> focus-reveal: root.focused ? 1.0 : 0.0;
    animate focus-reveal { duration: Motion.focus-duration; easing: ease-in-out; }
    background: pointer.has-hover || pointer.pressed ? Theme.surface-raised : Theme.surface;
    border-radius: Metrics.radius-md;
    border-width: root.focused ? (Theme.high-contrast ? 3px : 2px) : 1px;
    border-color: Theme.divider.with-alpha(0.60).mix(Motion.menu-focus-color, 1.0 - root.focus-reveal);
    animate border-width { duration: Motion.focus-duration; easing: ease-in-out; }
    animate background { duration: Motion.hover-duration; easing: ease-in-out; }
    // Focus is the single stroke on this card, never a second ring.
    MarqueeText {
        x: 8px; y: 0px; width: parent.width - 16px; height: parent.height;
        text: root.label;
        active: root.focused;
        edge-color: pointer.has-hover || pointer.pressed ? Theme.surface-raised : Theme.surface;
        text-color: root.selected ? Theme.accent : Theme.foreground;
        font-size: Typography.body-size;
        font-weight: root.selected ? Typography.emphasis-weight : Typography.body-weight;
        horizontal-alignment: center;
    }
    pointer := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.activated(); }
    }
}

// Keep a real gap between the colour disc and the single focus/selection ring.
// The ring follows the existing live focus colour, while the disc remains still.
component AccentSwatch inherits Rectangle {
    in property <string> label;
    in property <color> swatch-color;
    in property <bool> selected: false;
    in property <bool> focused: false;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.selected ? "Selected accent" : "Select accent";
    private property <float> focus-reveal: root.focused ? 1.0 : 0.0;
    animate focus-reveal { duration: Motion.focus-duration; easing: ease-in-out; }
    background: transparent;
    focus-ring := Rectangle {
        width: 48px;
        height: 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: transparent;
        border-width: Theme.high-contrast ? 3px : 2px;
        border-color: Theme.foreground.mix(Motion.menu-focus-color, 1.0 - root.focus-reveal);
        opacity: root.selected ? 1.0 : root.focus-reveal;
    }
    swatch := Rectangle {
        width: root.selected || root.focused ? 36px : 31px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.swatch-color;
        // The preview follows the resolved theme, including White becoming grey.
        animate background { duration: Motion.value-swap-duration; easing: ease-in-out; }
        border-width: 1px;
        border-color: Theme.divider;
        animate width { duration: Motion.focus-duration; easing: ease-out; }
    }
    pointer := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.activated(); }
    }
}

export component SettingsPage inherits Rectangle {
    in property <int> view: 0; // 0 Settings, 1 Appearance, 2 Third-Party, 3 Steam Account, 4 SteamGridDB, 5 Controller
    in property <int> theme-index: 0; // System, Light, Dark, Black
    in property <int> accent-index: 0; // System, nine spectrum colours
    in property <bool> ui-sounds-enabled: true;
    in property <[ControllerBindingRow]> binding-rows;
    in property <bool> binding-open;
    in property <string> binding-title;
    in property <bool> controller-ready;
    callback cancel-binding();
    in property <bool> swap-confirm: false;
    in property <bool> swap-hints: true;
    in property <bool> core-ready;
    in property <bool> core-freeze;
    in property <bool> core-resume: true;
    in property <bool> core-color;
    in property <bool> core-value-forward: true;
    in property <string> core-filter: "None";
    in property <int> core-sunlight;
    in property <string> core-feedback;
    callback core-decrease();
    in property <string> appearance-feedback: "";
    in property <int> selection: 0;
    in property <bool> key-present: false;
    in property <string> steam-identity: "Not set";
    in property <bool> steam-connected: false;
    in property <bool> steam-saved: false;
    in property <int> editor-kind: 0; // 0 SteamGridDB, 1 SteamID64, 2 Steam Web API key
    in property <bool> prefer-artwork: false;
    in property <bool> editing-key: false;
    in property <int> editor-target: 0; // 0 input, 1 eye, 2 Cancel, 3 Save
    // Track real left/right Ctrl separately from the synthetic events emitted
    // while inserting a Wayland clipboard read into Slint's TextInput.
    in property <bool> synthetic-key-insertion: false;
    private property <bool> physical-left-control: false;
    private property <bool> physical-right-control: false;
    out property <int> physical-control-mask:
        (root.physical-left-control ? 1 : 0) + (root.physical-right-control ? 2 : 0);
    in-out property <string> key-draft: "";
    in property <string> feedback: "";
    // Keep the Rust-owned artwork diagnostic property available to the backend,
    // but do not display worker telemetry in the Third-Party preferences view.
    in property <string> artwork-status: "";
    // Manual refresh is a real worker operation, not a persistent status row.
    in property <bool> refresh-open: false;
    in property <bool> refresh-running: false;
    in property <int> refresh-completed: 0;
    in property <int> refresh-total: 0;
    in property <string> refresh-error: "";
    private property <bool> reveal-draft: false;
    private property <length> input-scroll-x: 0px;
    // TextInput owns insertion position and shaping. We only draw a 2px marker
    // from cursor-position-changed, avoiding competing native/custom clocks.
    private property <length> caret-local-x: 0px;

    callback activate(int);
    // The on-screen keyboard covers this much of the bottom (dialogs stay
    // above it); a field's keyboard button asks for it.
    in property <length> keyboard-inset: 0px;
    // Where the on-screen keyboard types: the caret follows it.
    in property <int> keyboard-caret: 0;
    in property <int> keyboard-edit: 0;
    callback keyboard-show();
    changed keyboard-edit => {
        if (root.editing-key) {
            api-input.set-selection-offsets(root.keyboard-caret, root.keyboard-caret);
        }
    }
    // A row's Remove / Disconnect button was clicked; the confirmation's
    // answer (0 Cancel, 1 the action).
    callback remove(int);
    in property <bool> confirm-open: false;
    in property <string> confirm-title: "";
    in property <string> confirm-action: "";
    in property <int> confirm-focus: 0;
    callback confirm(int);
    callback go-back();
    callback save-key(string);
    callback cancel-key();
    callback dismiss-refresh();
    callback request-wayland-paste();
    callback apply-wayland-paste(string);
    callback activate-editor-target(int);
    activate-editor-target(target) => {
        if (target == 1) {
            root.reveal-draft = !root.reveal-draft;
            root.input-scroll-x = 0px;
            api-input.focus();
        } else if (target == 2) {
            root.cancel-key();
        } else if (target == 3 && root.key-draft != "") {
            root.save-key(root.key-draft);
        }
    }

    apply-wayland-paste(text) => {
        // The Rust handler sends the paste as a text-input event immediately
        // after focus is restored. Slint then inserts at the actual caret and
        // replaces any selection, instead of overwriting the entire draft.
        api-input.focus();
    }

    background: Theme.background;
    private property <length> content-width: root.width - Metrics.page-margin * 2;

    // The section title stays "Settings"; sub-views name themselves in
    // their breadcrumb, as every other page's sub-views do.
    PageHeader { width: parent.width; title: "Settings"; }

    // Sub-views use the shared Zoom: going deeper zooms in, Back zooms out.
    // Depth: Settings 0, Appearance/Controller/Third-Party 1, Steam Account/SteamGridDB 2.
    view-transition := TransitionDriver { key: root.view; }
    private property <bool> view-back: root.view-depth(root.view) < root.view-depth(view-transition.from-key);
    pure function view-depth(view: int) -> int {
        return view == 0 ? 0 : (view <= 2 || view == 5 || view == 6 ? 1 : 2);
    }

    settings-home := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 0;
        outgoing: view-transition.from-key == 0;
        returning: root.view-back;
        phase: view-transition.phase;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            alignment: start;
            spacing: Metrics.list-row-gap;
            SettingsRow {
                width: parent.width;
               
                title: "Appearance";
                subtitle: "Theme, accent colour and UI sounds";
                trailing: "Open";
                focused: root.view == 0 && root.selection == 0;
                activated => { if (root.view == 0 && !root.editing-key && !root.refresh-open) { root.activate(0); } }
            }
            SettingsRow {
                width: parent.width;
                title: "Controller";
                subtitle: "Select and back buttons";
                trailing: "Open";
                focused: root.view == 0 && root.selection == 1;
                activated => { if (root.view == 0 && !root.editing-key && !root.refresh-open) { root.activate(1); } }
            }
            SettingsRow {
                width: parent.width;
               
                title: "Third-Party";
                subtitle: "Steam and SteamGridDB";
                trailing: "Open";
                focused: root.view == 0 && root.selection == 2;
                activated => { if (root.view == 0 && !root.editing-key && !root.refresh-open) { root.activate(2); } }
            }
            SettingsRow {
                width: parent.width;
                title: "Cores";
                subtitle: "Game playback preferences";
                trailing: "Open";
                focused: root.view == 0 && root.selection == 3;
                activated => { if (root.view == 0) { root.activate(3); } }
            }
        }
    }

    appearance := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 1;
        outgoing: view-transition.from-key == 1;
        returning: root.view-back;
        phase: view-transition.phase;

        Breadcrumb {
            x: 0px; y: 0px; width: parent.width;
            section: "Settings"; page: "Appearance";
            back => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.go-back(); } }
        }
        Text {
            x: 0px; y: 35px; width: parent.width; height: 31px;
            text: "Theme";
            color: Theme.foreground;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
        }
        // A compact four-way selector instead of full-width, double-outlined cards.
        theme-choices := Rectangle {
            x: 0px; y: 76px;
            width: min(parent.width, 780px); height: 66px;
            background: transparent;
            AppearanceChoice {
                x: (parent.width - 36px) / 4 * 0 + 0px;
                y: 0px;
                width: (parent.width - 36px) / 4; height: 66px;
                label: "System";
                selected: root.theme-index == 0;
                focused: root.view == 1 && root.selection == 0;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(0); } }
            }
            AppearanceChoice {
                x: (parent.width - 36px) / 4 * 1 + 12px;
                y: 0px;
                width: (parent.width - 36px) / 4; height: 66px;
                label: "Light";
                selected: root.theme-index == 1;
                focused: root.view == 1 && root.selection == 1;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(1); } }
            }
            AppearanceChoice {
                x: (parent.width - 36px) / 4 * 2 + 24px;
                y: 0px;
                width: (parent.width - 36px) / 4; height: 66px;
                label: "Dark";
                selected: root.theme-index == 2;
                focused: root.view == 1 && root.selection == 2;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(2); } }
            }
            AppearanceChoice {
                x: (parent.width - 36px) / 4 * 3 + 36px;
                y: 0px;
                width: (parent.width - 36px) / 4; height: 66px;
                label: "Black";
                selected: root.theme-index == 3;
                focused: root.view == 1 && root.selection == 3;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(3); } }
            }
        }
        Text {
            x: 0px; y: 174px; width: parent.width; height: 31px;
            text: "Accent colour";
            color: Theme.foreground;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
        }
        // GNOME-inspired small palette, using Horizon's own focus + radius tokens.
        // Keeps all nine colours named for accessibility without visible labels.
        accent-palette := Rectangle {
            x: 0px; y: 215px;
            width: min(parent.width, 710px); height: 72px;
            background: Theme.surface;
            border-radius: Metrics.radius-lg;
            AppearanceChoice {
                x: 8px; y: 8px;
                width: 104px; height: 56px;
                label: "System";
                selected: root.accent-index == 0;
                focused: root.view == 1 && root.selection == 4;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(4); } }
            }
            AccentSwatch {
                x: 130px; y: 11px;
                width: 48px; height: 50px;
                label: "Red";
                swatch-color: #e5484d;
                selected: root.accent-index == 1;
                focused: root.view == 1 && root.selection == 5;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(5); } }
            }
            AccentSwatch {
                x: 192px; y: 11px;
                width: 48px; height: 50px;
                label: "Orange";
                swatch-color: #f28c28;
                selected: root.accent-index == 2;
                focused: root.view == 1 && root.selection == 6;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(6); } }
            }
            AccentSwatch {
                x: 254px; y: 11px;
                width: 48px; height: 50px;
                label: "Yellow";
                swatch-color: #f2c94c;
                selected: root.accent-index == 3;
                focused: root.view == 1 && root.selection == 7;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(7); } }
            }
            AccentSwatch {
                x: 316px; y: 11px;
                width: 48px; height: 50px;
                label: "Green";
                swatch-color: #3cb978;
                selected: root.accent-index == 4;
                focused: root.view == 1 && root.selection == 8;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(8); } }
            }
            AccentSwatch {
                x: 378px; y: 11px;
                width: 48px; height: 50px;
                label: "Teal";
                swatch-color: #24b6a8;
                selected: root.accent-index == 5;
                focused: root.view == 1 && root.selection == 9;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(9); } }
            }
            AccentSwatch {
                x: 440px; y: 11px;
                width: 48px; height: 50px;
                label: "Blue";
                swatch-color: #3584e4;
                selected: root.accent-index == 6;
                focused: root.view == 1 && root.selection == 10;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(10); } }
            }
            AccentSwatch {
                x: 502px; y: 11px;
                width: 48px; height: 50px;
                label: "Purple";
                swatch-color: #8b5cf6;
                selected: root.accent-index == 7;
                focused: root.view == 1 && root.selection == 11;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(11); } }
            }
            AccentSwatch {
                x: 564px; y: 11px;
                width: 48px; height: 50px;
                label: "Pink";
                swatch-color: #e65da7;
                selected: root.accent-index == 8;
                focused: root.view == 1 && root.selection == 12;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(12); } }
            }
            AccentSwatch {
                x: 626px; y: 11px;
                width: 48px; height: 50px;
                label: "White";
                // This is the same contrast-adjusted white/grey as the actual
                // app accent for the current Light/Dark/Black/High Contrast setting.
                swatch-color: Theme.appearance-white-swatch;
                selected: root.accent-index == 9;
                focused: root.view == 1 && root.selection == 13;
                activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(13); } }
            }
        }
        Text {
            x: 0px; y: 403px;
            width: parent.width; height: 26px;
            text: root.appearance-feedback;
            color: root.appearance-feedback != "" ? Theme.foreground : Theme.secondary-foreground;
            font-size: Typography.caption-size;
            vertical-alignment: center;
        }
        SettingsRow {
            x: 0px; y: 311px;
            width: parent.width;
            title: "UI Sounds";
            subtitle: "Sounds when you move and select";
            toggle: true;
            checked: root.ui-sounds-enabled;
            focused: root.view == 1 && root.selection == 14;
            activated => { if (root.view == 1 && !root.editing-key && !root.refresh-open) { root.activate(14); } }
        }
    }


    cores := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 6;
        outgoing: view-transition.from-key == 6;
        returning: root.view-back;
        phase: view-transition.phase;
        Breadcrumb {
            x: 0px; y: 0px; width: parent.width;
            section: "Settings"; page: "Cores";
            back => { if (root.view == 6) { root.go-back(); } }
        }
        SettingsRow {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm;
            width: parent.width;
            title: "mGBA";
            subtitle: "Game Boy, Color and Advance";
            trailing: "Open";
            focused: root.view == 6 && root.selection == 0;
            activated => { if (root.view == 6) { root.activate(0); } }
        }
        SettingsRow {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 1;
            width: parent.width;
            title: "Freeze when unfocused";
            subtitle: "Resume automatically when you return";
            toggle: true;
            checked: root.core-freeze;
            enabled: root.view == 6 && root.core-ready;
            focused: root.view == 6 && root.selection == 1;
            activated => { if (root.view == 6) { root.activate(1); } }
        }
        SettingsRow {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 2;
            width: parent.width;
            title: "Resume last state";
            subtitle: "Load the newest state when starting a game";
            toggle: true; checked: root.core-resume;
            enabled: root.view == 6 && root.core-ready;
            focused: root.view == 6 && root.selection == 2;
            activated => { if root.view == 6 { root.activate(2); } }
        }
        Text {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 3;
            width: parent.width; height: 60px;
            text: root.core-feedback != "" ? root.core-feedback : "Applies to all cores on the next game launch";
            color: Theme.secondary-foreground; font-size: Typography.caption-size; wrap: word-wrap;
        }
    }

    mgba := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 7;
        outgoing: view-transition.from-key == 7;
        returning: root.view-back;
        phase: view-transition.phase;
        Breadcrumb {
            x: 0px; y: 0px; width: parent.width;
            section: "Cores"; page: "mGBA";
            back => { if (root.view == 7) { root.go-back(); } }
        }
        SettingsRow {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm;
            width: parent.width;
            title: "Sunlight level";
            subtitle: "For games that use a solar sensor";
            trailing: "+   " + root.core-sunlight + " / 10"; value-forward: root.core-value-forward;
            secondary: "−";
            enabled: root.view == 7 && root.core-ready;
            focused: root.view == 7 && root.selection == 0;
            activated => { if (root.view == 7) { root.activate(0); } }
            secondary-activated => { if (root.view == 7) { root.core-decrease(); } }
        }
        SettingsRow {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 1;
            width: parent.width;
            title: "Video filter";
            subtitle: "Sharp, LCD, smooth scaling or smooth pixel art";
            trailing: root.core-filter; value-forward: root.core-value-forward;
            enabled: root.view == 7 && root.core-ready;
            focused: root.view == 7 && root.selection == 1;
            activated => { if (root.view == 7) { root.activate(1); } }
        }
        SettingsRow {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 2;
            width: parent.width;
            title: "Colour correction";
            subtitle: "Approximate the original GBA display colours";
            toggle: true;
            checked: root.core-color;
            enabled: root.view == 7 && root.core-ready;
            focused: root.view == 7 && root.selection == 2;
            activated => { if (root.view == 7) { root.activate(2); } }
        }
        Text {
            y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 3;
            width: parent.width; height: 60px;
            text: root.core-feedback != "" ? root.core-feedback : "Applies next time you launch a game";
            color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
            wrap: word-wrap;
        }
    }

    controller := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 5;
        outgoing: view-transition.from-key == 5;
        returning: root.view-back;
        phase: view-transition.phase;

        Breadcrumb {
            x: 0px; y: 0px; width: parent.width;
            section: "Settings"; page: "Controller";
            back => { if (root.view == 5 && !root.editing-key && !root.refresh-open) { root.go-back(); } }
        }
        SettingsRow {
            x: 0px; y: Metrics.breadcrumb-height + Metrics.spacing-sm;
            width: parent.width;
            title: "Swap Select and Back";
            subtitle: "Swap menu buttons and gameplay A/B";
            toggle: true;
            checked: root.swap-confirm;
            focused: root.view == 5 && root.selection == 0;
            activated => { if (root.view == 5 && !root.editing-key && !root.refresh-open) { root.activate(0); } }
        }
        SettingsRow {
            x: 0px; y: Metrics.breadcrumb-height + Metrics.spacing-sm + Metrics.list-row-height + Metrics.list-row-gap;
            width: parent.width;
            title: "Swap Hints";
            subtitle: "Hints show the swapped buttons";
            toggle: true;
            checked: root.swap-hints;
            focused: root.view == 5 && root.selection == 1;
            activated => { if (root.view == 5 && !root.editing-key && !root.refresh-open) { root.activate(1); } }
        }
        SettingsRow {
            x: 0px; y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 2;
            width: parent.width; title: "Button mapping"; subtitle: "Game Boy gameplay controls"; trailing: "Open";
            focused: root.view == 5 && root.selection == 2;
            activated => { if (root.view == 5 && !root.binding-open) {root.activate(2);} }
        }
        Text {
            x: 0px; y: Metrics.breadcrumb-height + Metrics.spacing-sm + (Metrics.list-row-height + Metrics.list-row-gap) * 3;
            width: parent.width; height: 30px;
            text: root.feedback;
            visible: root.view == 5 && root.feedback != "";
            color: Theme.accent;
            font-size: Typography.caption-size;
            vertical-alignment: center;
        }
    }

    bindings := TransitionLayer {
        x: Metrics.page-margin; rest-y: Metrics.page-header-height;
        width: root.content-width; height: root.height - Metrics.page-header-height - Metrics.page-bottom-bar-height;
        opaque: true; active: root.view == 8; outgoing: view-transition.from-key == 8;
        returning: root.view-back; phase: view-transition.phase;
        Breadcrumb { x: 0px; y: 0px; width: parent.width; section: "Controller"; page: "Button mapping"; back => {if (root.view == 8 && !root.binding-open) {root.go-back();}} }
        // The action and assigned physical input have distinct visual roles.
        // Keep each pair one shared focus/click target, including its keycap.
        Text {
            x: Metrics.spacing-lg; y: Metrics.breadcrumb-height + Metrics.spacing-md;
            width: parent.width / 2; height: Metrics.spacing-lg;
            text: "Game Boy control"; color: Theme.secondary-foreground; font-size: Typography.caption-size;
            vertical-alignment: center;
        }
        Text {
            x: parent.width - Metrics.spacing-xxl * 4 - Metrics.spacing-lg;
            y: Metrics.breadcrumb-height + Metrics.spacing-md;
            width: Metrics.spacing-xxl * 4; height: Metrics.spacing-lg;
            text: "Controller input"; color: Theme.secondary-foreground; font-size: Typography.caption-size;
            horizontal-alignment: center; vertical-alignment: center;
        }
        for row[index] in root.binding-rows: ListRow {
            x: 0px;
            y: Metrics.breadcrumb-height + Metrics.spacing-xxl + index * (Metrics.compact-row-height + Metrics.list-row-gap);
            width: parent.width; compact: true;
            title: row.title == "Start" || row.title == "Select" ? row.title : row.title + " button";
            subtitle: "Assigned to controller input " + row.value + ". Select to change.";
            trailing-width: Metrics.spacing-xxl * 6;
            focused: root.view == 8 && root.selection == index && !root.binding-open;
            enabled: root.view == 8 && root.controller-ready && !root.binding-open;
            activated => {if (root.view == 8 && !root.binding-open) {root.activate(index);}}
            Rectangle {
                x: parent.width - Metrics.spacing-xxl * 4 - Metrics.spacing-lg;
                y: Metrics.spacing-sm; width: Metrics.spacing-xxl * 4;
                height: parent.height - Metrics.spacing-sm * 2;
                background: Theme.surface-raised; border-radius: Metrics.radius-sm;
                ValueText {
                    width: parent.width; height: parent.height;
                    text: row.value; text-color: Theme.foreground; edge-color: Theme.surface-raised;
                    font-size: Typography.body-size; font-weight: Typography.emphasis-weight;
                    horizontal-alignment: center;
                }
            }
        }
        SettingsRow {
            y: Metrics.breadcrumb-height + Metrics.spacing-xxl + 6 * (Metrics.compact-row-height + Metrics.list-row-gap) + Metrics.spacing-md;
            width: parent.width; compact: true; title: "Restore defaults";
            focused: root.view == 8 && root.selection == 6 && !root.binding-open;
            enabled: root.view == 8 && root.controller-ready && !root.binding-open;
            activated => {if (root.view == 8 && !root.binding-open) {root.activate(6);}}
        }
        Text {
            y: Metrics.breadcrumb-height + Metrics.spacing-xxl + 7 * (Metrics.compact-row-height + Metrics.list-row-gap) + Metrics.spacing-md;
            width: parent.width; height: Metrics.compact-row-height;
            text: root.feedback; color: Theme.secondary-foreground; font-size: Typography.caption-size; wrap: word-wrap;
        }
    }
    // Third-Party lists one row per service; each opens its own page, so
    // SteamGridDB and Steam are reached and laid out the same way.
    third-party := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 2;
        outgoing: view-transition.from-key == 2;
        returning: root.view-back;
        phase: view-transition.phase;

        Breadcrumb {
            x: 0px; y: 0px; width: parent.width;
            section: "Settings"; page: "Third-Party";
            back => { if (root.view == 2 && !root.editing-key && !root.refresh-open) { root.go-back(); } }
        }
        SettingsRow {
            x: 0px; y: Metrics.breadcrumb-height + Metrics.spacing-sm;
            width: parent.width;
            title: "SteamGridDB";
            subtitle: root.key-present ? "Cover art · Connected" : "Cover art · Not set up";
            trailing: "Open";
            focused: root.view == 2 && root.selection == 0;
            activated => { if (root.view == 2 && !root.editing-key && !root.refresh-open) { root.activate(0); } }
        }
        SettingsRow {
            x: 0px; y: Metrics.breadcrumb-height + Metrics.spacing-sm + Metrics.list-row-height + Metrics.list-row-gap;
            width: parent.width;
            title: "Steam Account";
            subtitle: root.steam-connected ? "Connected" : "Not set up";
            trailing: "Open";
            focused: root.view == 2 && root.selection == 1;
            activated => { if (root.view == 2 && !root.editing-key && !root.refresh-open) { root.activate(1); } }
        }
    }

    steamgriddb := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 4;
        outgoing: view-transition.from-key == 4;
        returning: root.view-back;
        phase: view-transition.phase;

        Breadcrumb {
            x: 0px; y: 0px; width: parent.width;
            section: "Settings"; page: "Third-Party  /  SteamGridDB";
            back => { if (root.view == 4 && !root.editing-key && !root.refresh-open) { root.go-back(); } }
        }
        Text {
            x: 0px; y: 32px; width: parent.width; height: 32px;
            text: "SteamGridDB";
            color: Theme.foreground;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
            vertical-alignment: center;
        }
        SettingsRow {
            x: 0px; y: 76px;
            width: parent.width;
            title: "API key";
            subtitle: root.key-present ? "Saved" : "Not set";
            trailing: root.key-present ? "Replace" : "Add key";
            secondary: root.key-present ? "Remove" : "";
            focused: root.view == 4 && root.selection == 0;
            activated => { if (root.view == 4 && !root.editing-key && !root.refresh-open) { root.activate(0); } }
            secondary-activated => { if (root.view == 4 && !root.editing-key && !root.refresh-open) { root.remove(0); } }
        }
        SettingsRow {
            x: 0px; y: 164px;
            width: parent.width;
            title: "Prefer SteamGridDB artwork";
            subtitle: "Use it over each store's own art";
            toggle: true;
            accessible-role: switch;
            checked: root.prefer-artwork;
            focused: root.view == 4 && root.selection == 1;
            activated => { if (root.view == 4 && !root.editing-key && !root.refresh-open) { root.activate(1); } }
        }
        SettingsRow {
            x: 0px; y: 252px;
            width: parent.width;
            title: "Refresh artwork";
            subtitle: "Check for new covers";
            trailing: root.key-present ? "Refresh" : "Unavailable";
            enabled: root.key-present;
            focused: root.view == 4 && root.selection == 2;
            activated => { if (root.view == 4 && !root.editing-key && !root.refresh-open) { root.activate(2); } }
        }
        Text {
            x: 0px; y: 344px; width: parent.width; height: 30px;
            text: root.feedback;
            visible: root.view == 4 && root.feedback != "";
            color: Theme.accent;
            font-size: Typography.caption-size;
        }
    }

    steam-account := TransitionLayer {
        x: Metrics.page-margin;
        rest-y: Metrics.page-header-height;
        width: root.content-width;
        height: root.height - Metrics.page-header-height;
        opaque: true;
        active: root.view == 3;
        outgoing: view-transition.from-key == 3;
        returning: root.view-back;
        phase: view-transition.phase;

        Breadcrumb {
            x: 0px; y: 0px; width: parent.width;
            section: "Settings"; page: "Third-Party  /  Steam Account";
            back => { if (root.view == 3 && !root.editing-key && !root.refresh-open) { root.go-back(); } }
        }
        Text {
            x: 0px; y: 32px; width: parent.width; height: 32px;
            text: "Steam Account";
            color: Theme.foreground;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
            vertical-alignment: center;
        }
        SettingsRow {
            x: 0px; y: 76px; width: parent.width;
            title: "Steam ID";
            subtitle: root.steam-identity;
            trailing: root.steam-identity == "Not set" ? "Set" : "Change";
            secondary: root.steam-saved ? "Disconnect" : "";
            focused: root.view == 3 && root.selection == 0;
            activated => { if (root.view == 3 && !root.editing-key) { root.activate(0); } }
            secondary-activated => { if (root.view == 3 && !root.editing-key) { root.remove(0); } }
        }
        SettingsRow {
            x: 0px; y: 164px; width: parent.width;
            title: "Steam Web API key";
            subtitle: root.steam-connected ? "Saved" : "Not set";
            trailing: root.steam-connected ? "Replace" : "Add key";
            focused: root.view == 3 && root.selection == 1;
            activated => { if (root.view == 3 && !root.editing-key) { root.activate(1); } }
        }
        Text {
            x: 0px; y: 252px; width: parent.width; height: 30px;
            text: root.feedback;
            visible: root.view == 3 && root.feedback != "";
            color: Theme.accent;
            font-size: Typography.caption-size;
        }
    }

    // Retain the editor while it fades out; it blocks pointer input until fully
    // dismissed, and a delayed focus handoff avoids activation races with Slint.
    modal-layer := ModalDialog {
        area-width: root.width; area-height: root.height;
        lift: root.keyboard-inset;
        z: 20;
        open: root.editing-key;
        card-width: 598px;
        card-height: 246px;

        Text {
            x: 26px; y: 22px;
            width: parent.width - 52px; height: 34px;
            text: root.editor-kind == 1 ? "Steam ID"
                : root.editor-kind == 2 ? "Steam Web API key"
                : "SteamGridDB API key";
            color: Theme.foreground;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
            vertical-alignment: center;
        }
        MarqueeText {
            // Dialog text sits on the raised dialog surface.
            edge-color: Theme.surface-raised;
            x: 26px; y: 60px;
            width: parent.width - 52px; height: 24px;
            text: root.editor-kind == 1 ? "The 17-digit number from your Steam profile"
                : "Stays hidden once saved";
            text-color: Theme.secondary-foreground;
            font-size: Typography.body-size;
        }
        Rectangle {
            x: 26px; y: 97px;
            width: parent.width - 52px; height: 56px;
            background: Theme.surface;
            border-radius: Metrics.radius-md;
            border-width: 1px;
            border-color: Theme.divider;
            SelectionFocusSurface {
                x: -3px; y: -3px;
                width: parent.width + 6px; height: parent.height + 6px;
                corner-radius: Metrics.radius-md + 3px;
                focused: root.editor-target == 0;
                // Keep the key entry neutral inside: only the focus stroke
                // animates, with no accent fill or tinted drop shadow.
                filled: false;
                soft-shadow: false;
            }

            input-viewport := Rectangle {
                x: 14px; y: 6px;
                width: parent.width - (root.editor-kind != 1 ? 113px : 69px); height: parent.height - 12px;
                background: transparent;
                clip: true;
                api-input := TextInput {
                    x: root.input-scroll-x; y: 0px;
                    width: max(parent.width, self.preferred-width + 16px);
                    animate x {
                        duration: Motion.scroll-duration;
                        easing: linear;
                    }
                    height: parent.height;
                    text <=> root.key-draft;
                    input-type: root.editor-kind == 1 || root.reveal-draft ? text : password;
                    input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
                    font-family: Typography.family;
                    font-size: Typography.body-size;
                    color: Theme.foreground;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.accent-foreground;
                    accessible-label: root.editor-kind == 1 ? "Steam ID" : root.editor-kind == 2 ? "Steam Web API key" : "SteamGridDB API key";
                    // Disable the abrupt native blink; the clipped overlay
                    // below fades smoothly at Slint's own cursor position.
                    text-cursor-width: 0px;
                    vertical-alignment: center;
                    single-line: true;
                    cursor-position-changed(pos) => {
                        root.caret-local-x = pos.x;
                        let viewport-width = parent.width;
                        let max-left = max(0px, self.preferred-width + 16px - viewport-width);
                        let current = root.input-scroll-x;
                        if (max-left <= 0px) {
                            root.input-scroll-x = 0px;
                        } else if (pos.x + current < 18px) {
                            root.input-scroll-x = max(-max-left, min(0px, 18px - pos.x));
                        } else if (pos.x + current > viewport-width - 18px) {
                            root.input-scroll-x = max(-max-left, min(0px, viewport-width - 18px - pos.x));
                        }
                    }
                    accepted => { root.save-key(root.key-draft); }
                    key-pressed(event) => {
                        // Keep the physical modifier state separate from
                        // simulated releases/presses used during paste.
                        if (event.text == Key.Control) {
                            if (!root.synthetic-key-insertion) {
                                root.physical-left-control = true;
                            }
                            reject
                        } else if (event.text == Key.ControlR) {
                            if (!root.synthetic-key-insertion) {
                                root.physical-right-control = true;
                            }
                            reject
                        } else if (event.modifiers.control &&
                                (event.text == "v" || event.text == "V")) {
                            // Ctrl may have been held before the editor
                            // acquired focus; infer the left modifier if
                            // the physical key-down was not observed.
                            if (!root.physical-left-control && !root.physical-right-control) {
                                root.physical-left-control = true;
                            }
                            if (!event.repeat) {
                                root.request-wayland-paste();
                            }
                            accept
                        } else if (event.text == Key.Escape) {
                            root.cancel-key();
                            accept
                        } else {
                            reject
                        }
                    }
                    key-released(event) => {
                        // A synthetic release for text insertion is not a
                        // physical release of a key still held by the user.
                        if (!root.synthetic-key-insertion && event.text == Key.Control) {
                            root.physical-left-control = false;
                        } else if (!root.synthetic-key-insertion && event.text == Key.ControlR) {
                            root.physical-right-control = false;
                        }
                        reject
                    }
                }
                // Keep cursor movement attached to Slint's text shaping,
                // including masked and revealed glyphs and animated scroll.
                // The 1.1s cosine gives an actual fading blink rather than
                // a static mark or hard width toggle.
                Rectangle {
                    x: api-input.x + root.caret-local-x;
                    y: (parent.height - self.height) / 2;
                    width: 2px;
                    height: Typography.body-size * 1.10;
                    background: Theme.foreground;
                    opacity: root.editing-key && root.editor-target == 0 && api-input.has-focus
                        ? (Motion.reduced-motion || Motion.loops-paused ? 1.0
                            : 0.12 + 0.88 * (0.5 + 0.5 * cos(animation-tick() / Motion.caret-blink-cycle * 360deg)))
                        : 0.0;
                }
                // Follow the exact Home selected-label technique: opaque
                // field-colour overlays soften clipped glyphs at both edges.
                Rectangle {
                    x: 0px; y: 1px; width: 20px; height: parent.height - 2px;
                    background: @linear-gradient(90deg,
                        Theme.surface 0%, Theme.surface 15%,
                        Theme.surface.with-alpha(0.84) 35%,
                        Theme.surface.with-alpha(0.42) 68%,
                        Theme.surface.with-alpha(0) 100%);
                    opacity: root.input-scroll-x < -1px ? 1.0 : 0.0;
                    animate opacity {
                        duration: Motion.scroll-duration;
                        easing: ease-in-out;
                    }
                }
                Rectangle {
                    x: parent.width - 20px; y: 1px;
                    width: 20px; height: parent.height - 2px;
                    background: @linear-gradient(90deg,
                        Theme.surface.with-alpha(0) 0%,
                        Theme.surface.with-alpha(0.42) 32%,
                        Theme.surface.with-alpha(0.84) 65%,
                        Theme.surface 85%, Theme.surface 100%);
                    opacity: api-input.x + api-input.preferred-width > parent.width - 2px
                        ? 1.0 : 0.0;
                    animate opacity {
                        duration: Motion.scroll-duration;
                        easing: ease-in-out;
                    }
                }
            }
            KeyboardButton {
                x: parent.width - (root.editor-kind != 1 ? 92px : 48px);
                y: (parent.height - self.height) / 2;
                activated => { root.keyboard-show(); }
            }
            // An accessible icon-only reveal control. The default is masked;
            // only the unsaved draft is ever revealed, never the saved key.
            reveal-button := Rectangle {
                visible: root.editor-kind != 1;
                x: parent.width - 48px; y: 8px;
                width: 40px; height: 40px;
                border-radius: Metrics.radius-md;
                background: (reveal-touch.pressed || reveal-touch.has-hover)
                    ? Theme.surface-raised : transparent;
                border-width: reveal-touch.has-hover ? 1px : 0px;
                border-color: Theme.divider;
                accessible-role: button;
                accessible-label: root.editor-kind == 1 ? "Steam ID shown" : root.reveal-draft ? "Hide API key" : "Show API key";
                animate background { duration: Motion.hover-duration; easing: ease-in-out; }
                SelectionFocusSurface {
                    x: -2px; y: -2px;
                    width: parent.width + 4px; height: parent.height + 4px;
                    corner-radius: Metrics.radius-md + 2px;
                    focused: root.editor-target == 1;
                    filled: false;
                    soft-shadow: false;
                }
                Path {
                    x: 9px; y: 12px;
                    width: 22px; height: 16px;
                    commands: "M 1 8 C 6 1 16 1 21 8 C 16 15 6 15 1 8 Z";
                    fill: transparent;
                    stroke: Theme.foreground;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
                Rectangle {
                    x: 17px; y: 17px;
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: Theme.foreground;
                }
                if root.reveal-draft : Path {
                    x: 8px; y: 11px;
                    width: 24px; height: 19px;
                    commands: "M 2 2 L 22 17";
                    stroke: Theme.foreground;
                    stroke-width: 2.1px;
                    stroke-line-cap: round;
                }
                reveal-touch := TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => {
                        root.reveal-draft = !root.reveal-draft;
                        root.input-scroll-x = 0px;
                        api-input.focus();
                    }
                }
            }
        }
        MarqueeText {
            // Dialog text sits on the raised dialog surface.
            edge-color: Theme.surface-raised;
            x: 26px; y: 162px;
            width: parent.width - 52px; height: 21px;
            visible: root.feedback != "";
            text: root.feedback;
            text-color: Theme.accent;
            font-size: Typography.caption-size;
        }
        SettingsButton {
            x: parent.width - 253px; y: 191px;
            width: 105px; height: 43px;
            label: "Cancel";
            focused: root.editor-target == 2;
            activated => { root.cancel-key(); }
        }
        SettingsButton {
            x: parent.width - 138px; y: 191px;
            width: 112px; height: 43px;
            primary: true;
            label: "Save";
            focused: root.editor-target == 3;
            enabled: root.key-draft != "";
            activated => { root.save-key(root.key-draft); }
        }
    }

    focus-after-opening := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.stop();
            if (root.editing-key) {
                api-input.focus();
                api-input.set-selection-offsets(0, 0);
            }
        }
    }
    changed editing-key => {
        if (root.editing-key) {
            root.reveal-draft = false;
            root.input-scroll-x = 0px;
            root.caret-local-x = 0px;
            root.physical-left-control = false;
            root.physical-right-control = false;
            focus-after-opening.start();
        } else {
            focus-after-opening.stop();
            root.reveal-draft = false;
            root.input-scroll-x = 0px;
            root.physical-left-control = false;
            root.physical-right-control = false;
        }
    }

    // Manual artwork refresh is modal: the dim layer blocks the underlying
    // Third-Party rows. Hide/Done dismisses the popup but never cancels downloads.
    // Progress and completion are driven by typed Rust worker events.
    refresh-layer := ModalDialog {
        area-width: root.width; area-height: root.height;
        z: 30;
        open: root.refresh-open;
        card-width: 456px;
        card-height: 240px;

        Rectangle {
            x: 29px; y: 27px; width: 44px; height: 44px;
            border-radius: 22px;
            background: transparent;
            border-width: 3px;
            border-color: Theme.accent.with-alpha(0.22);
            visible: root.refresh-running;
        }
        // Constant-speed ring spinner; pause on Reduced Motion.
        Path {
            x: 29px; y: 27px; width: 44px; height: 44px;
            commands: "M 22 3 A 19 19 0 1 1 3 22";
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 3px;
            stroke-line-cap: round;
            visible: root.refresh-running;
            transform-origin: { x: 22px, y: 22px };
            transform-rotation: root.refresh-running && !Motion.reduced-motion && !Motion.loops-paused
                ? mod(animation-tick(), Motion.spinner-cycle) / Motion.spinner-cycle * 360deg
                : 0deg;
        }
        Text {
            x: 29px; y: 27px; width: 44px; height: 44px;
            visible: !root.refresh-running;
            text: root.refresh-error != "" ? "!" : "✓";
            color: root.refresh-error != "" ? Theme.foreground : Theme.accent;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 89px; y: 30px;
            width: parent.width - 115px; height: 34px;
            text: root.refresh-running ? "Checking covers"
                : (root.refresh-error == "" ? "Done" : "Stopped");
            color: Theme.foreground;
            font-size: Typography.heading-size;
            font-weight: Typography.heading-weight;
            vertical-alignment: center;
        }
        Text {
            x: 29px; y: 86px;
            width: parent.width - 58px; height: 26px;
            text: root.refresh-total == 0
                ? (root.refresh-running ? "" : "No games to check")
                : (root.refresh-completed + " of " + root.refresh-total + " games");
            color: Theme.secondary-foreground;
            font-size: Typography.body-size;
            vertical-alignment: center;
        }
        Rectangle {
            x: 29px; y: 125px;
            width: parent.width - 58px; height: 6px;
            border-radius: 3px;
            background: Theme.divider;
            clip: true;
            Rectangle {
                x: 0px; y: 0px;
                width: root.refresh-total > 0
                    ? parent.width * min(1.0, root.refresh-completed * 1.0 / root.refresh-total)
                    : 0px;
                height: parent.height;
                border-radius: 3px;
                background: Theme.accent;
                animate width { duration: Motion.value-swap-duration; easing: ease-out; }
            }
        }
        MarqueeText {
            // Dialog text sits on the raised dialog surface.
            edge-color: Theme.surface-raised;
            x: 29px; y: 145px;
            width: parent.width - 190px; height: 42px;
            text: root.refresh-error;
            text-color: Theme.secondary-foreground;
            font-size: Typography.caption-size;
        }
        SettingsButton {
            x: parent.width - 136px; y: 178px;
            width: 107px; height: 40px;
            label: root.refresh-running ? "Hide" : "Done";
            focused: root.refresh-open;
            activated => { root.dismiss-refresh(); }
        }
    }

    // Removing a key or disconnecting asks first.
    ConfirmDialog {
        area-width: root.width; area-height: root.height;
        z: 30;
        open: root.confirm-open;
        title: root.confirm-title;
        action: root.confirm-action;
        selected: root.confirm-focus;
        choose(choice) => { root.confirm(choice); }
    }
    ModalDialog {
        z: 30;
        open: root.binding-open; area-width: root.width; area-height: root.height;
        Text {x: Metrics.spacing-lg; y: Metrics.spacing-lg; width: parent.width - Metrics.spacing-lg * 2; height: Metrics.spacing-xl;
            text: root.binding-title; color: Theme.foreground; font-size: Typography.heading-size; font-weight: Typography.emphasis-weight;}
        Text {x: Metrics.spacing-lg; y: Metrics.spacing-lg + Metrics.spacing-xxl; width: parent.width - Metrics.spacing-lg * 2; height: Metrics.spacing-xxl;
            text: "Release, then press a controller button.\nStick click or Escape cancels."; color: Theme.secondary-foreground; font-size: Typography.caption-size; wrap: word-wrap;}
        SettingsButton {
            width: Metrics.spacing-xxl * 2; height: Metrics.compact-row-height - Metrics.spacing-sm;
            x: parent.width - self.width - Metrics.spacing-lg; y: parent.height - self.height - Metrics.spacing-lg;
            label: "Cancel"; focused: InputGlyphs.family == GlyphFamily.keyboard; activated => {root.cancel-binding();}
        }
    }

}
