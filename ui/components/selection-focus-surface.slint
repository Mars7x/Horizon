import { Theme, Metrics, Motion } from "../theme/theme.slint";

// Shared menu focus outline for Settings rows, Appearance choices, dialog
// actions and the top utility strip. The focus effect is exactly ONE stroke:
// host components hide their ordinary divider border while it is visible.
// This component is always mounted, allowing both focus-in and focus-out
// to animate; unlike a conditional Rectangle it cannot disappear abruptly.
export component SelectionFocusSurface inherits Rectangle {
    in property <bool> focused: false;
    in property <length> corner-radius: Metrics.radius-md;
    in property <bool> filled: false;
    in property <bool> soft-shadow: false;

    // The Home focus already breathes between Theme.focus and its lighter
    // accent-derived highlight. Use the same shared colour curve, not alpha
    // opacity on a fully opaque stroke (which looked almost static).
    background: transparent;
    border-radius: root.corner-radius;
    border-width: Theme.high-contrast ? 3px : 2px;
    border-color: root.focused ? Motion.menu-focus-color : Theme.focus;
    opacity: root.focused ? 1.0 : 0.0;
    animate opacity { duration: Motion.focus-duration; easing: ease-in-out; }
}
